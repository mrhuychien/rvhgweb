---
import LegacyImg from './LegacyImg.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'products'>;
  loading?: 'lazy' | 'eager';
}
const { product, loading = 'lazy' } = Astro.props;
const { title, description, images, isOcop5Star, weight } = product.data;
const href = `/san-pham/${product.id}/`;
---

<article class="rvhg-card">
  <a href={href} class="rvhg-card__media">
    <LegacyImg src={images[0]} alt={title} width={800} height={600} loading={loading} class="rvhg-card__img" />
    {isOcop5Star && <span class="rvhg-card__badge">OCOP 5★</span>}
  </a>
  <div class="rvhg-card__body">
    <h3 class="rvhg-card__title"><a href={href}>{title}</a></h3>
    {weight && <p class="rvhg-card__meta">{weight}</p>}
    <p class="rvhg-card__desc">{description}</p>
    <a href={href} class="rvhg-card__link">Xem chi tiết →</a>
  </div>
</article>

<style>
  .rvhg-card {
    display: flex;
    flex-direction: column;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .rvhg-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lift);
  }
  .rvhg-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--color-rvhg-cream);
    overflow: hidden;
  }
  .rvhg-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rvhg-card__badge {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: var(--color-rvhg-red);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 0.25rem 0.5rem;
    border-radius: 0.35rem;
  }
  .rvhg-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.1rem 1.2rem;
    flex: 1;
  }
  .rvhg-card__title {
    font-size: 1.1rem;
    line-height: 1.3;
  }
  .rvhg-card__title a {
    text-decoration: none;
    color: var(--color-ink);
  }
  .rvhg-card__title a:hover {
    color: var(--color-rvhg-gold-dark);
  }
  .rvhg-card__meta {
    font-size: 0.8rem;
    color: var(--color-mute);
  }
  .rvhg-card__desc {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .rvhg-card__link {
    margin-top: auto;
    padding-top: 0.4rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-rvhg-gold-dark);
    text-decoration: none;
  }
  .rvhg-card__link:hover {
    color: var(--color-rvhg-red);
  }
</style>
