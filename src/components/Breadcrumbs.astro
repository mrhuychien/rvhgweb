---
import JsonLd from './JsonLd.astro';
import { breadcrumbSchema } from '../data/jsonld';

interface Props {
  items: { name: string; url: string }[];
}
const { items } = Astro.props;
const all = [{ name: 'Trang chủ', url: '/' }, ...items];
---

<nav class="rvhg-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {all.map((c, i) => (
      <li>
        {i < all.length - 1 ? <a href={c.url}>{c.name}</a> : <span aria-current="page">{c.name}</span>}
        {i < all.length - 1 && <span class="rvhg-breadcrumbs__sep" aria-hidden="true">›</span>}
      </li>
    ))}
  </ol>
</nav>
<JsonLd schema={breadcrumbSchema(all)} />

<style>
  .rvhg-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.78rem;
    color: var(--color-mute);
  }
  .rvhg-breadcrumbs li { display: flex; align-items: center; gap: 0.4rem; }
  .rvhg-breadcrumbs a {
    color: var(--color-mute);
    text-decoration: none;
    /* Desktop dùng chuột nên ≥24px (ngưỡng AA của WCAG 2.2) là đủ, giữ dải
       breadcrumb thanh mảnh. Mobile chạm bằng ngón tay → nâng lên 44px. */
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  @media (max-width: 900px) {
    .rvhg-breadcrumbs a { min-height: 44px; min-width: 44px; justify-content: center; }
  }
  .rvhg-breadcrumbs a:hover { color: var(--color-ink); }
  .rvhg-breadcrumbs [aria-current='page'] { color: var(--color-ink); }
  .rvhg-breadcrumbs__sep { opacity: 0.5; }
</style>
