---
import { COMPANY, SITE } from '../data/site';
import SealStamp from './SealStamp.astro';
const year = new Date().getFullYear();
---

<footer class="rvhg-footer rvhg-band-night">
  <div class="rvhg-container">
    <!-- §7 triện — the single emblem in this viewport -->
    <div class="rvhg-footer__seal">
      <SealStamp tone="var(--color-brass-300, #d8c29a)" />
      <p class="rvhg-footer__tagline">{SITE.name}</p>
      <p class="rvhg-footer__sub">{SITE.tagline}</p>
      <div class="gold-rule rvhg-rule--center"></div>
    </div>

    <div class="rvhg-footer__cols">
      <div class="rvhg-footer__col">
        <h2>Cửa hàng &amp; mua sắm</h2>
        <ul>
          <li><a href="/san-pham/">Sản phẩm</a></li>
          <li><a href="/danh-muc-san-pham/banh-dau-xanh-thuong-hang/">Bánh đậu xanh thượng hạng</a></li>
          <li><a href="/danh-muc-san-pham/banh-dau-xanh-tet/">Quà Tết</a></li>
          <li><a href="/danh-muc-san-pham/bot-dau/">Bột đậu &amp; chè đậu đen</a></li>
          <li><a href="/diem-ban-rong-vang-hoang-gia/">Tìm điểm bán</a></li>
        </ul>
      </div>
      <div class="rvhg-footer__col">
        <h2>Về Rồng Vàng Hoàng Gia</h2>
        <ul>
          <li><a href="/gioi-thieu/">Giới thiệu công ty</a></li>
          <li><a href="/cau-chuyen-san-pham-rong-vang-hoang-gia-2/">Câu chuyện thương hiệu</a></li>
          <li><a href="/tin-tuc/">Tin tức</a></li>
          <li><a href="/cong-bo/">Công bố &amp; chứng nhận</a></li>
        </ul>
      </div>
      <div class="rvhg-footer__col">
        <h2>Hồ sơ pháp lý</h2>
        <ul>
          <li><a href="/ban-tu-cong-bo-rong-vang-hoang-gia/">Bản tự công bố</a></li>
          <li><a href="/chinh-sach-va-quy-dinh-chung/">Chính sách chung</a></li>
          <li><a href="/chinh-sach-bao-hanh-doi-tra/">Bảo hành &amp; đổi trả</a></li>
          <li><a href="/chinh-sach-van-chuyen/">Vận chuyển</a></li>
          <li><a href="/chinh-sach-bao-mat/">Bảo mật</a></li>
        </ul>
      </div>
      <div class="rvhg-footer__col">
        <h2>Kết nối</h2>
        <ul>
          <li><a href={COMPANY.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>
          <li><a href="https://shopee.vn/" target="_blank" rel="noopener noreferrer">Shopee</a></li>
          <li><a href="https://www.tiktok.com/" target="_blank" rel="noopener noreferrer">TikTok Shop</a></li>
          <li><a href={`tel:${COMPANY.phone}`}>{COMPANY.phone}</a></li>
          <li><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></li>
        </ul>
      </div>
    </div>

    <div class="rvhg-footer__legal-block">
      <p>{COMPANY.legalName} · MST {COMPANY.taxId} · ĐKKD {COMPANY.businessLicense}</p>
      <p>
        Nhà máy: {COMPANY.factoryAddress}<br />
        Showroom: 209C Tuệ Tĩnh và 9 Bạch Đằng, TP Hải Dương
      </p>
      <p>Chứng nhận: ISO 22000:2018 (HA 394/2.23.CIV) · OCOP 5 sao Quốc gia 2024</p>
    </div>

    <div class="rvhg-footer__bar">
      <p>© {year} {COMPANY.legalName}. {SITE.tagline}.</p>
      <ul>
        <li><a href="/chinh-sach-bao-mat/">Chính sách bảo mật</a></li>
        <li><a href="/chinh-sach-va-quy-dinh-chung/">Điều khoản chung</a></li>
        <li><a href="/lien-he/">Liên hệ</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .rvhg-footer {
    padding-block: 4rem 1.75rem;
    font-size: 0.825rem;
    line-height: 1.55;
    color: var(--color-night-mute);
  }

  /* Triện block */
  .rvhg-footer__seal {
    text-align: center;
    padding-bottom: 3rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--brass) 22%, transparent);
  }
  .rvhg-footer__seal :global(.rvhg-seal) {
    margin: 0 auto 1.1rem;
  }
  .rvhg-footer__tagline {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: #fff;
    letter-spacing: -0.01em;
  }
  .rvhg-footer__sub {
    margin-top: 0.35rem;
    font-style: italic;
    font-family: var(--font-display);
    color: var(--color-brass-300, #d8c29a);
  }
  .rvhg-footer__seal .gold-rule { margin-top: 1.5rem; }

  .rvhg-footer__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    padding-bottom: 2.5rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid color-mix(in srgb, var(--brass) 22%, transparent);
  }
  .rvhg-footer__col h2 {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brass-300, #d8c29a);
    margin-bottom: 1rem;
  }
  .rvhg-footer__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .rvhg-footer__col a {
    color: var(--color-night-mute);
    text-decoration: none;
    transition: color 0.18s var(--ease-refined);
  }
  .rvhg-footer__col a:hover { color: #fff; }

  .rvhg-footer__legal-block {
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--color-night-mute) 80%, transparent);
  }
  .rvhg-footer__legal-block p + p { margin-top: 0.5rem; }

  .rvhg-footer__bar {
    border-top: 1px solid color-mix(in srgb, var(--brass) 18%, transparent);
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--color-night-mute) 75%, transparent);
  }
  .rvhg-footer__bar ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .rvhg-footer__bar a { color: inherit; text-decoration: none; }
  .rvhg-footer__bar a:hover { color: #fff; }

  @media (max-width: 900px) {
    .rvhg-footer__cols { grid-template-columns: repeat(2, 1fr); gap: 2rem 1.5rem; }
  }
  @media (max-width: 560px) {
    .rvhg-footer__cols { grid-template-columns: 1fr; }
    .rvhg-footer__bar { flex-direction: column; align-items: flex-start; }
  }
</style>
