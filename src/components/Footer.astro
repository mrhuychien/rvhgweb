---
import { COMPANY, SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="rvhg-footer">
  <div class="rvhg-footer__grid" aria-hidden="true"></div>

  <section class="rvhg-footer__invite">
    <div class="rvhg-container rvhg-footer__invite-inner">
      <div>
        <p class="rvhg-eyebrow">Từ Hải Dương · Đến mọi miền</p>
        <h2>Một món quà Việt,<br/><em>được kể theo cách mới.</em></h2>
      </div>
      <div class="rvhg-footer__invite-action">
        <p>Khám phá các dòng bánh đậu xanh, bột đậu xanh và quà biếu Rồng Vàng Hoàng Gia.</p>
        <a class="rvhg-footer__circle" href="/san-pham/" aria-label="Khám phá sản phẩm">
          <span>Khám phá</span>
          <svg viewBox="0 0 32 32" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
            <path d="M7 25 25 7M11 7h14v14"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <div class="rvhg-footer__marquee" aria-hidden="true">
    <div>
      <span>Rồng Vàng Hoàng Gia</span><i>◆</i>
      <span>Đặc sản nức tiếng Hải Dương</span><i>◆</i>
      <span>OCOP 5 sao Quốc gia</span><i>◆</i>
      <span>Rồng Vàng Hoàng Gia</span><i>◆</i>
      <span>Đặc sản nức tiếng Hải Dương</span><i>◆</i>
      <span>OCOP 5 sao Quốc gia</span><i>◆</i>
    </div>
  </div>

  <div class="rvhg-container rvhg-footer__main">
    <div class="rvhg-footer__identity">
      <div class="rvhg-footer__orb">
        <span class="rvhg-footer__orb-ring"></span>
        <img src="/images/legacy/logo-seal.png" alt="Rồng Vàng Hoàng Gia" width="512" height="512" loading="lazy" decoding="async" />
      </div>
      <p class="rvhg-footer__name">{SITE.name}</p>
      <p class="rvhg-footer__tagline">{SITE.tagline}</p>
      <p class="rvhg-footer__address">{COMPANY.factoryAddress}</p>
    </div>

    <div class="rvhg-footer__nav">
      <div>
        <h3>Khám phá</h3>
        <ul>
          <li><a href="/san-pham/">Tất cả sản phẩm</a></li>
          <li><a href="/danh-muc-san-pham/banh-dau-xanh-thuong-hang/">Bánh thượng hạng</a></li>
          <li><a href="/danh-muc-san-pham/banh-dau-xanh-tet/">Quà Tết</a></li>
          <li><a href="/danh-muc-san-pham/bot-dau/">Bột đậu xanh</a></li>
          <li><a href="/diem-ban-rong-vang-hoang-gia/">Tìm điểm bán</a></li>
        </ul>
      </div>
      <div>
        <h3>Thương hiệu</h3>
        <ul>
          <li><a href="/gioi-thieu/">Giới thiệu</a></li>
          <li><a href="/cau-chuyen-san-pham-rong-vang-hoang-gia-2/">Câu chuyện thương hiệu</a></li>
          <li><a href="/tin-tuc/">Tin tức</a></li>
          <li><a href="/cong-bo/">Công bố &amp; chứng nhận</a></li>
          <li><a href="/lien-he/">Liên hệ hợp tác</a></li>
        </ul>
      </div>
      <div>
        <h3>Kết nối</h3>
        <ul>
          <li><a href={`tel:${COMPANY.phone}`}>0934 362 658</a></li>
          <li><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></li>
          <li><a href={COMPANY.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a></li>
          <li><a href="https://shopee.vn/" target="_blank" rel="noopener noreferrer">Shopee ↗</a></li>
          <li><a href="https://www.tiktok.com/" target="_blank" rel="noopener noreferrer">TikTok Shop ↗</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="rvhg-container rvhg-footer__legal">
    <div class="rvhg-footer__legal-copy">
      <p><strong>{COMPANY.legalName}</strong> · {COMPANY.businessLicenseFull}</p>
      <p>{COMPANY.isoFull}</p>
    </div>
    <div class="rvhg-footer__bottom">
      <p>© {year} {COMPANY.legalName}</p>
      <ul>
        <li><a href="/chinh-sach-bao-mat/">Bảo mật</a></li>
        <li><a href="/chinh-sach-va-quy-dinh-chung/">Điều khoản</a></li>
        <li><a href="/chinh-sach-van-chuyen/">Vận chuyển</a></li>
      </ul>
      <a href="#main" class="rvhg-footer__top">Lên đầu trang ↑</a>
    </div>
  </div>
</footer>

<style>
  .rvhg-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: rgb(255 248 234 / 0.68);
    background:
      radial-gradient(55rem 30rem at 15% 15%, rgb(126 28 33 / 0.35), transparent 72%),
      #150306;
  }
  .rvhg-footer__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.22;
    pointer-events: none;
    background:
      linear-gradient(rgb(241 210 148 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(241 210 148 / 0.07) 1px, transparent 1px);
    background-size: 76px 76px;
    mask-image: linear-gradient(to bottom, black, transparent 82%);
  }
  .rvhg-footer__invite {
    padding-block: clamp(4rem, 8vw, 8rem);
    border-bottom: 1px solid rgb(239 207 145 / 0.15);
  }
  .rvhg-footer__invite-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.55fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: end;
  }
  .rvhg-footer__invite .rvhg-eyebrow { color: #dfbc74; }
  .rvhg-footer__invite h2 {
    margin-top: 1.15rem;
    color: #fff8ea;
    font-size: clamp(2.5rem, 6vw, 6.4rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.045em;
  }
  .rvhg-footer__invite h2 em {
    color: #dfbc74;
    font-weight: 400;
  }
  .rvhg-footer__invite-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .rvhg-footer__invite-action p {
    max-width: 30ch;
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .rvhg-footer__circle {
    width: 122px;
    height: 122px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    border: 1px solid rgb(239 207 145 / 0.42);
    border-radius: 50%;
    color: #f0d292;
    text-decoration: none;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.4s ease, background 0.4s ease, transform 0.5s var(--ease-out-expo, ease);
  }
  .rvhg-footer__circle:hover {
    color: #26070a;
    background: #f0d292;
    transform: rotate(-6deg) scale(1.04);
  }

  .rvhg-footer__marquee {
    overflow: hidden;
    padding-block: 1.15rem;
    border-bottom: 1px solid rgb(239 207 145 / 0.15);
    color: rgb(239 207 145 / 0.56);
    white-space: nowrap;
  }
  .rvhg-footer__marquee > div {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 1.6rem;
    font-family: var(--font-display);
    font-size: 0.92rem;
    letter-spacing: 0.05em;
    animation: rvhg-footer-marquee 32s linear infinite;
  }
  .rvhg-footer__marquee i { font-size: 0.48rem; font-style: normal; }
  @keyframes rvhg-footer-marquee { to { transform: translateX(-50%); } }

  .rvhg-footer__main {
    display: grid;
    grid-template-columns: minmax(14rem, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(4rem, 7vw, 7rem);
  }
  .rvhg-footer__identity { max-width: 20rem; }
  .rvhg-footer__orb {
    position: relative;
    width: 98px;
    height: 98px;
    display: grid;
    place-items: center;
    margin-bottom: 1.5rem;
  }
  .rvhg-footer__orb img {
    width: 78px;
    height: 78px;
    border-radius: 50%;
  }
  .rvhg-footer__orb-ring {
    position: absolute;
    inset: 0;
    border: 1px solid rgb(239 207 145 / 0.32);
    border-radius: 50%;
  }
  .rvhg-footer__orb-ring::after {
    content: '';
    position: absolute;
    top: -3px;
    left: calc(50% - 3px);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f0d292;
    box-shadow: 0 0 16px #f0d292;
  }
  .rvhg-footer__name {
    color: #fff8ea;
    font-family: var(--font-display);
    font-size: 1.45rem;
  }
  .rvhg-footer__tagline { margin-top: 0.3rem; color: #dfbc74; font-family: var(--font-display); font-style: italic; }
  .rvhg-footer__address { margin-top: 1.25rem; font-size: 0.76rem; line-height: 1.7; }

  .rvhg-footer__nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .rvhg-footer__nav h3 {
    margin-bottom: 1.3rem;
    color: #dfbc74;
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .rvhg-footer__nav ul,
  .rvhg-footer__bottom ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rvhg-footer__nav ul { display: flex; flex-direction: column; gap: 0.74rem; }
  .rvhg-footer__nav a {
    color: rgb(255 248 234 / 0.68);
    text-decoration: none;
    font-size: 0.82rem;
    transition: color 0.2s ease, padding 0.3s var(--ease-out-expo, ease);
  }
  .rvhg-footer__nav a:hover { color: #fff8ea; padding-left: 0.3rem; }

  .rvhg-footer__legal {
    padding-block: 1.5rem 1.75rem;
    border-top: 1px solid rgb(239 207 145 / 0.15);
    font-size: 0.68rem;
    line-height: 1.65;
  }
  .rvhg-footer__legal-copy {
    max-width: 90ch;
    color: rgb(255 248 234 / 0.42);
  }
  .rvhg-footer__legal-copy p + p { margin-top: 0.35rem; }
  .rvhg-footer__legal-copy strong { color: rgb(255 248 234 / 0.62); font-weight: 500; }
  .rvhg-footer__bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.5rem;
    align-items: center;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(239 207 145 / 0.1);
    color: rgb(255 248 234 / 0.44);
  }
  .rvhg-footer__bottom ul { display: flex; gap: 1rem; }
  .rvhg-footer__bottom a { color: inherit; text-decoration: none; }
  .rvhg-footer__bottom a:hover { color: #f0d292; }
  .rvhg-footer__top { justify-self: end; }

  @media (max-width: 820px) {
    .rvhg-footer__invite-inner,
    .rvhg-footer__main { grid-template-columns: 1fr; }
    .rvhg-footer__invite-action { flex-direction: row; align-items: center; justify-content: space-between; }
    .rvhg-footer__invite-action p { max-width: 34ch; }
    .rvhg-footer__identity { max-width: 26rem; }
  }
  @media (max-width: 600px) {
    .rvhg-footer__invite-action { align-items: flex-start; flex-direction: column; }
    .rvhg-footer__circle { width: 104px; height: 104px; }
    .rvhg-footer__nav { grid-template-columns: 1fr 1fr; }
    .rvhg-footer__nav > div:last-child { grid-column: 1 / -1; }
    .rvhg-footer__bottom { grid-template-columns: 1fr auto; }
    .rvhg-footer__bottom ul { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rvhg-footer__marquee > div { animation: none; }
  }
</style>
