---
import { COMPANY, SITE } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="rvhg-footer">
  <div class="rvhg-container">
    <p class="rvhg-footer__legal">
      Có thể bạn cần thêm thông tin: gọi <a href="tel:0934362658">0934&nbsp;362&nbsp;658</a> ·
      email <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>.
    </p>

    <div class="rvhg-footer__cols">
      <div class="rvhg-footer__col">
        <h2>Cửa hàng và mua sắm</h2>
        <ul>
          <li><a href="/san-pham/">Sản phẩm</a></li>
          <li><a href="/danh-muc-san-pham/banh-dau-xanh-thuong-hang/">Bánh đậu xanh thượng hạng</a></li>
          <li><a href="/danh-muc-san-pham/banh-dau-xanh-tet/">Quà Tết</a></li>
          <li><a href="/danh-muc-san-pham/bot-dau/">Bột đậu &amp; chè đậu đen</a></li>
          <li><a href="/diem-ban-rong-vang-hoang-gia/">Tìm điểm bán</a></li>
        </ul>
      </div>
      <div class="rvhg-footer__col">
        <h2>Về Rồng Vàng Hoàng Gia</h2>
        <ul>
          <li><a href="/gioi-thieu/">Giới thiệu công ty</a></li>
          <li><a href="/cau-chuyen-san-pham-rong-vang-hoang-gia-2/">Câu chuyện thương hiệu</a></li>
          <li><a href="/tin-tuc/">Tin tức</a></li>
          <li><a href="/cong-bo/">Công bố &amp; chứng nhận</a></li>
        </ul>
      </div>
      <div class="rvhg-footer__col">
        <h2>Hồ sơ pháp lý</h2>
        <ul>
          <li><a href="/ban-tu-cong-bo-rong-vang-hoang-gia/">Bản tự công bố</a></li>
          <li><a href="/chinh-sach-va-quy-dinh-chung/">Chính sách chung</a></li>
          <li><a href="/chinh-sach-bao-hanh-doi-tra/">Bảo hành &amp; đổi trả</a></li>
          <li><a href="/chinh-sach-van-chuyen/">Vận chuyển</a></li>
          <li><a href="/chinh-sach-bao-mat/">Bảo mật</a></li>
        </ul>
      </div>
      <div class="rvhg-footer__col">
        <h2>Kết nối</h2>
        <ul>
          <li><a href={COMPANY.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>
          <li><a href="https://shopee.vn/" target="_blank" rel="noopener noreferrer">Shopee</a></li>
          <li><a href="https://www.tiktok.com/" target="_blank" rel="noopener noreferrer">TikTok Shop</a></li>
          <li><a href="/lien-he/">Liên hệ</a></li>
        </ul>
      </div>
    </div>

    <div class="rvhg-footer__legal-block">
      <p>
        {COMPANY.legalName} · MST {COMPANY.taxId} · ĐKKD {COMPANY.businessLicense}
      </p>
      <p>
        Nhà máy: {COMPANY.factoryAddress}<br/>
        Showroom: 209C Tuệ Tĩnh và 9 Bạch Đằng, TP Hải Dương
      </p>
      <p>
        Chứng nhận: ISO 22000:2018 (HA 394/2.23.CIV) · OCOP 5 sao Quốc gia 2024
      </p>
    </div>

    <div class="rvhg-footer__bar">
      <p>© {year} {COMPANY.legalName}.  {SITE.tagline}.</p>
      <ul>
        <li><a href="/chinh-sach-bao-mat/">Chính sách bảo mật</a></li>
        <li><a href="/chinh-sach-va-quy-dinh-chung/">Điều khoản chung</a></li>
        <li><a href="/lien-he/">Liên hệ</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .rvhg-footer {
    background: var(--color-paper-soft);
    border-top: 1px solid var(--color-line-soft);
    color: var(--color-mute);
    padding-block: 2.5rem 1.5rem;
    font-size: 0.825rem;
    line-height: 1.55;
  }
  .rvhg-footer__legal {
    padding-block: 0.75rem 1.5rem;
    border-bottom: 1px solid var(--color-line-soft);
  }
  .rvhg-footer__legal a { color: var(--color-link); text-decoration: none; }
  .rvhg-footer__legal a:hover { text-decoration: underline; }

  .rvhg-footer__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem 2rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--color-line-soft);
  }
  .rvhg-footer__col h2 {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 0.85rem;
    letter-spacing: 0;
  }
  .rvhg-footer__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .rvhg-footer__col a {
    color: var(--color-mute);
    text-decoration: none;
  }
  .rvhg-footer__col a:hover { color: var(--color-ink); text-decoration: underline; }

  .rvhg-footer__legal-block {
    padding-block: 1.25rem 0.5rem;
    font-size: 0.8rem;
    color: var(--color-mute-soft);
  }
  .rvhg-footer__legal-block p + p { margin-top: 0.5rem; }

  .rvhg-footer__bar {
    border-top: 1px solid var(--color-line-soft);
    margin-top: 1.25rem;
    padding-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    color: var(--color-mute-soft);
  }
  .rvhg-footer__bar ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .rvhg-footer__bar a { color: var(--color-mute-soft); text-decoration: none; }
  .rvhg-footer__bar a:hover { color: var(--color-ink); }

  @media (max-width: 900px) {
    .rvhg-footer__cols { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .rvhg-footer__cols { grid-template-columns: 1fr; gap: 2rem; }
    .rvhg-footer__bar { flex-direction: column; align-items: flex-start; }
  }
</style>
