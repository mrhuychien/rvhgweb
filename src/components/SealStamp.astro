---
/**
 * Imperial triện (seal) — §7 signature device.
 * RULE §0.3: max 1 emblem per viewport. Use seal-500 line-art only.
 * Currently a refined two-ring stamp with the "龍" (Rồng) monogram.
 * Replace the inner glyph with bespoke dragon line-art when available.
 */
interface Props {
  class?: string;
  /** seal colour — defaults to brand seal; pass a lighter tone on dark bands. */
  tone?: string;
  label?: string;
}
const { class: className = '', tone = '#a8362b', label = 'Triện Rồng Vàng Hoàng Gia' } = Astro.props;
---

<svg
  viewBox="0 0 100 100"
  class={`rvhg-seal ${className}`}
  role="img"
  aria-label={label}
  style={`--seal-tone:${tone}`}
>
  <circle cx="50" cy="50" r="47" fill="none" stroke="var(--seal-tone)" stroke-width="2" />
  <circle cx="50" cy="50" r="40" fill="none" stroke="var(--seal-tone)" stroke-width="1" />
  <text
    x="50" y="52"
    text-anchor="middle" dominant-baseline="middle"
    font-family="'Playfair Display', Georgia, serif"
    font-weight="700" font-size="30" letter-spacing="1" fill="var(--seal-tone)"
  >RV</text>
</svg>

<style>
  .rvhg-seal {
    width: 4.5rem;
    height: 4.5rem;
    display: block;
  }
</style>
