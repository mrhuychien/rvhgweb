---
import { NAV } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
// A parent item is "current" when the active page is one of its children.
const itemActive = (item: (typeof NAV)[number]) =>
  isActive(item.href) || (item.children?.some((c) => isActive(c.href)) ?? false);

// Split the nav into two groups that flank the central emblem (old-site layout).
const mid = Math.ceil(NAV.length / 2);
const navLeft = NAV.slice(0, mid);
const navRight = NAV.slice(mid);

// Languages offered by the Google machine-translation switcher.
const LANGS = [
  { code: 'vi', label: 'Tiếng Việt' },
  { code: 'en', label: 'English' },
  { code: 'ja', label: '日本語' },
  { code: 'ko', label: '한국어' },
  { code: 'zh-CN', label: '中文' },
  { code: 'fr', label: 'Français' },
];
---

<header class="rvhg-header" data-rvhg-header>
  <div class="rvhg-header__inner">
    <nav class="rvhg-header__side rvhg-header__side--left" aria-label="Điều hướng (trái)">
      <ul>
        {navLeft.map((item) => (
          <li class={item.children ? 'rvhg-nav-item rvhg-nav-item--has-sub' : 'rvhg-nav-item'}>
            <a href={item.href} aria-current={itemActive(item) ? 'page' : undefined} aria-haspopup={item.children ? 'true' : undefined}>
              {item.label}
              {item.children && (
                <svg class="rvhg-nav-caret" viewBox="0 0 12 12" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" />
                </svg>
              )}
            </a>
            {item.children && (
              <ul class="rvhg-subnav">
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a href="/" class="rvhg-header__emblem" aria-label="Trang chủ — Rồng Vàng Hoàng Gia">
      <img
        src="/images/legacy/logo-seal.png"
        alt="Rồng Vàng Hoàng Gia — Đặc sản nức tiếng Hải Dương"
        width="512" height="512"
        decoding="async" fetchpriority="high"
      />
    </a>

    <nav class="rvhg-header__side rvhg-header__side--right" aria-label="Điều hướng (phải)">
      <ul>
        {navRight.map((item) => (
          <li class={item.children ? 'rvhg-nav-item rvhg-nav-item--has-sub' : 'rvhg-nav-item'}>
            <a href={item.href} aria-current={itemActive(item) ? 'page' : undefined} aria-haspopup={item.children ? 'true' : undefined}>
              {item.label}
              {item.children && (
                <svg class="rvhg-nav-caret" viewBox="0 0 12 12" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" />
                </svg>
              )}
            </a>
            {item.children && (
              <ul class="rvhg-subnav">
                {item.children.map((c) => (
                  <li><a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
        <li class="rvhg-header__lang">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
          </svg>
          <select class="rvhg-lang-select" data-rvhg-lang aria-label="Ngôn ngữ / Language">
            {LANGS.map((l) => <option value={l.code}>{l.label}</option>)}
          </select>
        </li>
      </ul>
    </nav>

    <button
      type="button"
      class="rvhg-header__toggle"
      aria-expanded="false"
      aria-controls="rvhg-mobile-nav"
      aria-label="Mở menu"
      data-rvhg-menu-toggle
    >
      <svg viewBox="0 0 20 20" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <line x1="2" y1="6" x2="18" y2="6" />
        <line x1="2" y1="12" x2="18" y2="12" />
      </svg>
    </button>
  </div>

  <nav id="rvhg-mobile-nav" class="rvhg-mobile-nav" aria-label="Điều hướng (di động)" hidden>
    <ul>
      {NAV.map((item) => (
        <li>
          <a href={item.href} aria-current={itemActive(item) ? 'page' : undefined}>{item.label}</a>
          {item.children && (
            <ul class="rvhg-mobile-subnav">
              {item.children.filter((c) => c.href !== item.href).map((c) => (
                <li><a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>{c.label}</a></li>
              ))}
            </ul>
          )}
        </li>
      ))}
      <li class="rvhg-mobile-nav__lang">
        <span>Ngôn ngữ / Language</span>
        <select class="rvhg-lang-select rvhg-lang-select--mobile" data-rvhg-lang aria-label="Ngôn ngữ / Language">
          {LANGS.map((l) => <option value={l.code}>{l.label}</option>)}
        </select>
      </li>
    </ul>
  </nav>
</header>

<style>
  .rvhg-header {
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--color-paper-50, #fbf8f1);
    background:
      radial-gradient(120% 140% at 50% -10%, #5a1417 0%, #3d1114 45%, #2a0c0e 100%);
    border-bottom: 1px solid color-mix(in srgb, var(--brass) 45%, transparent);
  }
  /* brass corner brackets — restrained nod to the lacquer frame */
  .rvhg-header::before,
  .rvhg-header::after {
    content: '';
    position: absolute;
    top: 10px;
    width: 26px;
    height: 26px;
    border-top: 1px solid color-mix(in srgb, var(--color-brass-400, #c5a878) 70%, transparent);
    pointer-events: none;
  }
  .rvhg-header::before { left: 12px;  border-left: 1px solid color-mix(in srgb, var(--color-brass-400, #c5a878) 70%, transparent); }
  .rvhg-header::after  { right: 12px; border-right: 1px solid color-mix(in srgb, var(--color-brass-400, #c5a878) 70%, transparent); }

  .rvhg-header__inner {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    min-height: 92px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.25rem;
    transition: min-height 0.3s var(--ease-refined, ease);
  }
  @media (min-width: 768px) {
    .rvhg-header__inner { padding-inline: 2.5rem; }
  }
  .rvhg-header[data-scrolled] .rvhg-header__inner { min-height: 72px; }

  /* central emblem */
  .rvhg-header__emblem {
    display: inline-flex;
    justify-self: center;
    line-height: 0;
  }
  .rvhg-header__emblem img {
    width: 76px;
    height: 76px;
    border-radius: 9999px;
    object-fit: cover;
    display: block;
    /* hairline brass ring lifts the red seal off the maroon header */
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-brass-400, #c5a878) 55%, transparent);
    transition: width 0.3s var(--ease-refined, ease), height 0.3s var(--ease-refined, ease);
  }
  .rvhg-header[data-scrolled] .rvhg-header__emblem img { width: 60px; height: 60px; }

  /* flanking nav groups */
  .rvhg-header__side ul {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rvhg-header__side--left ul  { justify-content: flex-end; }
  .rvhg-header__side--right ul { justify-content: flex-start; }
  .rvhg-header__side a {
    display: inline-block;
    padding: 0.5rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-paper-50, #fbf8f1);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.18s var(--ease-refined, ease);
  }
  .rvhg-header__side a:hover { color: var(--color-brass-300, #d8c29a); }
  .rvhg-header__side a[aria-current='page'] {
    color: var(--color-brass-300, #d8c29a);
  }

  /* dropdown (zero-JS: revealed on hover / keyboard focus-within) */
  .rvhg-nav-item { position: relative; }
  .rvhg-nav-caret {
    margin-left: 0.28rem;
    opacity: 0.7;
    transition: transform 0.2s var(--ease-refined, ease);
  }
  .rvhg-nav-item--has-sub:hover .rvhg-nav-caret,
  .rvhg-nav-item--has-sub:focus-within .rvhg-nav-caret { transform: rotate(180deg); }
  .rvhg-header__side .rvhg-subnav {
    display: block;                   /* beats `.rvhg-header__side ul { display: flex }` (0,2,0 > 0,1,1) */
    position: absolute;
    top: 100%;
    left: 50%;
    margin-top: 1.55rem;              /* clears the tall header bar */
    transform: translateX(-50%) translateY(6px);
    min-width: 15.5rem;
    list-style: none;
    padding: 0.4rem;
    background: radial-gradient(120% 150% at 50% -20%, #4a1215 0%, #2a0c0e 72%);
    border: 1px solid color-mix(in srgb, var(--brass) 38%, transparent);
    border-radius: var(--radius-md, 4px);
    box-shadow: 0 22px 46px -20px rgba(0, 0, 0, 0.7);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.18s var(--ease-refined, ease), transform 0.18s var(--ease-refined, ease);
    z-index: 60;
  }
  .rvhg-subnav::before {              /* transparent bridge so the cursor can cross the gap */
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1.75rem;
    height: 1.75rem;
  }
  .rvhg-nav-item--has-sub:hover .rvhg-subnav,
  .rvhg-nav-item--has-sub:focus-within .rvhg-subnav {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .rvhg-subnav a {
    display: block;
    padding: 0.62rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.015em;
    text-transform: none;
    white-space: nowrap;
    color: var(--color-paper-50, #fbf8f1);
    border-radius: var(--radius-sm, 2px);
  }
  .rvhg-subnav a:hover { background: color-mix(in srgb, var(--brass) 18%, transparent); color: var(--color-brass-300, #d8c29a); }
  .rvhg-subnav a[aria-current='page'] { color: var(--color-brass-300, #d8c29a); }

  /* language switcher */
  .rvhg-header__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: 0.4rem;
    padding-left: 0.7rem;
    border-left: 1px solid color-mix(in srgb, var(--brass) 35%, transparent);
    color: var(--color-brass-300, #d8c29a);
  }
  .rvhg-lang-select {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: 0;
    color: var(--color-paper-50, #fbf8f1);
    font: inherit;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 0.3rem 0.2rem;
  }
  .rvhg-lang-select:hover { color: var(--color-brass-300, #d8c29a); }
  .rvhg-lang-select option { color: #1c1714; text-transform: none; }

  /* mobile toggle */
  .rvhg-header__toggle {
    display: none;
    grid-column: 1;
    justify-self: start;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
    border: 0;
    background: transparent;
    color: var(--color-paper-50, #fbf8f1);
    cursor: pointer;
  }

  /* mobile drawer */
  .rvhg-mobile-nav {
    background: #2a0c0e;
    border-top: 1px solid color-mix(in srgb, var(--brass) 30%, transparent);
  }
  .rvhg-mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.5rem 1.25rem;
  }
  .rvhg-mobile-nav a {
    display: block;
    padding: 0.9rem 0.25rem;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-paper-50, #fbf8f1);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--brass) 18%, transparent);
  }
  .rvhg-mobile-nav a[aria-current='page'] { color: var(--color-brass-300, #d8c29a); }
  .rvhg-mobile-subnav {
    list-style: none;
    margin: 0.15rem 0 0.6rem;
    padding: 0 0 0 0.9rem;
    border-left: 1px solid color-mix(in srgb, var(--brass) 24%, transparent);
  }
  .rvhg-mobile-subnav a {
    padding: 0.55rem 0.25rem;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    text-transform: none;
    border-bottom: 0;
    color: var(--color-night-mute, #cbbba0);
  }
  .rvhg-mobile-subnav a[aria-current='page'] { color: var(--color-brass-300, #d8c29a); }
  .rvhg-mobile-nav__lang {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0.25rem 0.25rem;
  }
  .rvhg-mobile-nav__lang span {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brass-300, #d8c29a);
  }
  .rvhg-lang-select--mobile {
    border: 1px solid color-mix(in srgb, var(--brass) 35%, transparent);
    border-radius: var(--radius-sm, 2px);
    padding: 0.5rem 0.6rem;
  }

  @media (max-width: 900px) {
    .rvhg-header__side { display: none; }
    .rvhg-header::before, .rvhg-header::after { display: none; }
    .rvhg-header__inner {
      position: relative;            /* anchor the absolutely-centred emblem */
      display: flex;
      align-items: center;
      min-height: 70px;
      padding-inline: 1.25rem;
    }
    .rvhg-header__toggle { display: inline-flex; }
    /* dead-centre the emblem regardless of the hamburger width */
    .rvhg-header__emblem {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
    }
    .rvhg-header__emblem img { width: 62px; height: 62px; }
    .rvhg-header[data-scrolled] .rvhg-header__inner { min-height: 60px; }
    .rvhg-header[data-scrolled] .rvhg-header__emblem img { width: 52px; height: 52px; }
  }
</style>

<script>
  function initHeader() {
    const header = document.querySelector('[data-rvhg-header]');
    const toggle = document.querySelector('[data-rvhg-menu-toggle]') as HTMLButtonElement | null;
    const nav = document.getElementById('rvhg-mobile-nav');
    if (!header || !toggle || !nav) return;

    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      nav.hidden = true;
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      nav.hidden = open;
    });
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));

    // language switcher — reflect current language, switch on change
    const m = document.cookie.match(/googtrans=\/[^/]+\/([^;]+)/);
    const current = m ? decodeURIComponent(m[1]) : 'vi';
    document.querySelectorAll('[data-rvhg-lang]').forEach((el) => {
      const sel = el as HTMLSelectElement;
      sel.value = current;
      sel.addEventListener('change', () => {
        const fn = (window as unknown as { rvhgSetLang?: (l: string) => void }).rvhgSetLang;
        if (fn) fn(sel.value);
      });
    });

    const onScroll = () => {
      if (window.scrollY > 8) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>
