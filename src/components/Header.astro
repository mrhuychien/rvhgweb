---
import { NAV } from '../data/site';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---

<header class="rvhg-header" data-rvhg-header>
  <div class="rvhg-header__inner">
    <a href="/" class="rvhg-header__brand" aria-label="Trang chủ Rồng Vàng Hoàng Gia">
      <Logo />
    </a>

    <nav class="rvhg-header__nav" aria-label="Điều hướng chính">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      class="rvhg-header__toggle"
      aria-expanded="false"
      aria-controls="rvhg-mobile-nav"
      aria-label="Mở menu"
      data-rvhg-menu-toggle
    >
      <svg viewBox="0 0 18 18" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <line x1="2" y1="6"  x2="16" y2="6"  />
        <line x1="2" y1="12" x2="16" y2="12" />
      </svg>
    </button>
  </div>

  <nav id="rvhg-mobile-nav" class="rvhg-mobile-nav" aria-label="Điều hướng (di động)" hidden>
    <ul>
      {NAV.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .rvhg-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-paper-50, #fbf8f1) 78%, transparent);
    backdrop-filter: saturate(150%) blur(20px);
    -webkit-backdrop-filter: saturate(150%) blur(20px);
    border-bottom: 1px solid var(--color-line);
  }
  .rvhg-header__inner {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3rem;
  }
  @media (min-width: 768px) {
    .rvhg-header__inner { padding-inline: 2rem; height: 3.25rem; }
  }
  .rvhg-header__brand {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  .rvhg-header__nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .rvhg-header__nav a {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--color-ink);
    text-decoration: none;
    opacity: 0.86;
    transition: opacity 0.15s ease;
  }
  .rvhg-header__nav a:hover { opacity: 1; }
  .rvhg-header__nav a[aria-current='page'] { opacity: 1; font-weight: 500; }
  .rvhg-header__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0.4rem;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }
  .rvhg-mobile-nav {
    border-top: 1px solid var(--color-line-soft);
    background: color-mix(in srgb, var(--color-paper-50, #fbf8f1) 97%, transparent);
    backdrop-filter: blur(12px);
  }
  .rvhg-mobile-nav ul {
    list-style: none;
    padding: 0.5rem 1.25rem 1.25rem;
    margin: 0;
  }
  .rvhg-mobile-nav a {
    display: block;
    padding: 0.85rem 0.25rem;
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 1px solid var(--color-line-soft);
  }
  .rvhg-mobile-nav a[aria-current='page'] { color: var(--color-link); }
  @media (max-width: 900px) {
    .rvhg-header__nav { display: none; }
    .rvhg-header__toggle { display: inline-flex; }
  }
</style>

<script>
  function initHeader() {
    const toggle = document.querySelector('[data-rvhg-menu-toggle]') as HTMLButtonElement | null;
    const nav = document.getElementById('rvhg-mobile-nav');
    if (!toggle || !nav) return;
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      nav.hidden = true;
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      nav.hidden = open;
    });
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
  }
  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>
