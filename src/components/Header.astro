---
import { COMPANY, NAV, SITE } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : path === href || path.startsWith(href);
const primaryNav = NAV.filter((item) => !['/', '/cong-bo/', '/lien-he/'].includes(item.href));
const LANGS = [
  { code: 'vi', label: 'VI' },
  { code: 'en', label: 'EN' },
  { code: 'ja', label: 'JA' },
  { code: 'ko', label: 'KO' },
  { code: 'zh-CN', label: '中文' },
  { code: 'fr', label: 'FR' },
];
---

<header class="rvhg-header" data-rvhg-header>
  <div class="rvhg-header__notice">
    <div class="rvhg-header__notice-inner">
      <p><span aria-hidden="true">✦</span> Bánh đậu xanh đạt OCOP 5 sao Quốc gia</p>
      <a href={`tel:${COMPANY.phone}`}>Tư vấn: 0934 362 658</a>
    </div>
  </div>

  <div class="rvhg-header__main">
    <a href="/" class="rvhg-header__brand" aria-label={`Trang chủ — ${SITE.name}`}>
      <img src="/images/legacy/logo-seal.png" alt="" width="512" height="512" decoding="async" fetchpriority="high" />
      <span>
        <strong>{SITE.name}</strong>
        <small>{SITE.tagline}</small>
      </span>
    </a>

    <nav class="rvhg-header__nav" aria-label="Điều hướng chính">
      <ul>
        {primaryNav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="rvhg-header__actions">
      <label class="rvhg-header__lang">
        <span class="sr-only">Ngôn ngữ</span>
        <select data-rvhg-lang aria-label="Ngôn ngữ / Language">
          {LANGS.map((lang) => <option value={lang.code}>{lang.label}</option>)}
        </select>
      </label>
      <a class="rvhg-header__store" href="/diem-ban-rong-vang-hoang-gia/">Tìm điểm bán <span aria-hidden="true">↗</span></a>
    </div>

    <button type="button" class="rvhg-header__toggle" aria-expanded="false" aria-controls="rvhg-mobile-nav" aria-label="Mở menu" data-rvhg-menu-toggle>
      <span></span><span></span>
    </button>
  </div>

  <nav id="rvhg-mobile-nav" class="rvhg-mobile-nav" aria-label="Điều hướng di động" hidden>
    <ul>
      {NAV.map((item) => (
        <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}<span aria-hidden="true">↗</span></a></li>
      ))}
    </ul>
    <div class="rvhg-mobile-nav__bottom">
      <label>
        <span>Ngôn ngữ</span>
        <select data-rvhg-lang aria-label="Ngôn ngữ / Language">
          {LANGS.map((lang) => <option value={lang.code}>{lang.label}</option>)}
        </select>
      </label>
      <a href={`tel:${COMPANY.phone}`}>Hotline 0934 362 658</a>
    </div>
  </nav>
</header>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .rvhg-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, #fbf8f1 94%, transparent); border-bottom: 1px solid rgba(74, 43, 31, 0.12); backdrop-filter: blur(18px); }
  .rvhg-header__notice { background: #5d1117; color: #fbf7ee; font-size: 0.72rem; letter-spacing: 0.04em; }
  .rvhg-header__notice-inner { max-width: 1240px; min-height: 30px; margin: 0 auto; padding: 0 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .rvhg-header__notice p { margin: 0; }
  .rvhg-header__notice p span { color: #d6b878; margin-right: 0.4rem; }
  .rvhg-header__notice a { color: inherit; text-decoration: none; opacity: 0.86; }
  .rvhg-header__main { max-width: 1240px; min-height: 82px; margin: 0 auto; padding: 0 2rem; display: grid; grid-template-columns: minmax(230px, 1fr) auto minmax(230px, 1fr); align-items: center; gap: 2rem; transition: min-height 0.25s ease; }
  .rvhg-header[data-scrolled] .rvhg-header__main { min-height: 68px; }
  .rvhg-header__brand { display: inline-flex; align-items: center; gap: 0.75rem; justify-self: start; color: #281c17; text-decoration: none; min-width: 0; }
  .rvhg-header__brand img { width: 50px; height: 50px; flex: 0 0 auto; object-fit: cover; border-radius: 50%; box-shadow: 0 0 0 1px rgba(157, 111, 52, 0.28); transition: width 0.25s ease, height 0.25s ease; }
  .rvhg-header[data-scrolled] .rvhg-header__brand img { width: 44px; height: 44px; }
  .rvhg-header__brand span { display: flex; flex-direction: column; line-height: 1.18; min-width: 0; }
  .rvhg-header__brand strong { font-family: var(--font-display); font-size: 1.03rem; font-weight: 650; letter-spacing: -0.01em; white-space: nowrap; }
  .rvhg-header__brand small { margin-top: 0.22rem; color: #8b6b43; font-size: 0.64rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap; }
  .rvhg-header__nav ul { display: flex; align-items: center; gap: 1.85rem; list-style: none; margin: 0; padding: 0; }
  .rvhg-header__nav a { position: relative; display: block; padding: 1rem 0; color: #3c3029; text-decoration: none; font-size: 0.82rem; font-weight: 550; letter-spacing: 0.015em; white-space: nowrap; }
  .rvhg-header__nav a::after { content: ''; position: absolute; left: 0; right: 100%; bottom: 0.7rem; height: 1px; background: #8b1720; transition: right 0.25s ease; }
  .rvhg-header__nav a:hover::after, .rvhg-header__nav a[aria-current='page']::after { right: 0; }
  .rvhg-header__nav a[aria-current='page'] { color: #71141b; }
  .rvhg-header__actions { justify-self: end; display: flex; align-items: center; gap: 0.85rem; }
  .rvhg-header__lang select { appearance: none; border: 0; background: transparent; color: #6e625b; font: inherit; font-size: 0.72rem; font-weight: 600; cursor: pointer; padding: 0.6rem 0.25rem; }
  .rvhg-header__store { display: inline-flex; align-items: center; gap: 0.45rem; min-height: 42px; padding: 0 1rem; background: #68131a; color: #fffaf0; text-decoration: none; font-size: 0.76rem; font-weight: 600; letter-spacing: 0.025em; border: 1px solid #68131a; transition: background 0.2s ease, color 0.2s ease; }
  .rvhg-header__store:hover { background: transparent; color: #68131a; }
  .rvhg-header__toggle { display: none; width: 42px; height: 42px; padding: 0; border: 1px solid rgba(77, 53, 39, 0.18); background: transparent; align-items: center; justify-content: center; flex-direction: column; gap: 6px; color: #311f19; }
  .rvhg-header__toggle span { width: 18px; height: 1px; background: currentColor; transition: transform 0.2s ease; }
  .rvhg-header__toggle[aria-expanded='true'] span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .rvhg-header__toggle[aria-expanded='true'] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .rvhg-mobile-nav { background: #fbf8f1; border-top: 1px solid rgba(74, 43, 31, 0.12); }
  .rvhg-mobile-nav ul { list-style: none; margin: 0; padding: 0.7rem 1.25rem; }
  .rvhg-mobile-nav li + li { border-top: 1px solid rgba(74, 43, 31, 0.1); }
  .rvhg-mobile-nav a { display: flex; align-items: center; justify-content: space-between; padding: 0.9rem 0; color: #2c211c; text-decoration: none; font-family: var(--font-display); font-size: 1.08rem; }
  .rvhg-mobile-nav a[aria-current='page'] { color: #7b161e; }
  .rvhg-mobile-nav__bottom { padding: 1rem 1.25rem 1.35rem; background: #f0e8db; display: flex; align-items: center; justify-content: space-between; gap: 1rem; font-size: 0.78rem; }
  .rvhg-mobile-nav__bottom label { display: flex; align-items: center; gap: 0.5rem; }
  .rvhg-mobile-nav__bottom select { border: 0; background: transparent; font: inherit; font-weight: 600; }
  .rvhg-mobile-nav__bottom a { padding: 0; font-family: var(--font-body); font-size: 0.78rem; font-weight: 600; color: #68131a; }
  @media (max-width: 1100px) {
    .rvhg-header__main { grid-template-columns: auto 1fr auto; }
    .rvhg-header__brand span { display: none; }
    .rvhg-header__nav ul { gap: 1.25rem; }
  }
  @media (max-width: 860px) {
    .rvhg-header__notice-inner { padding-inline: 1.25rem; }
    .rvhg-header__notice a { display: none; }
    .rvhg-header__main { min-height: 68px; padding-inline: 1.25rem; display: flex; justify-content: space-between; gap: 1rem; }
    .rvhg-header__brand span { display: flex; }
    .rvhg-header__brand strong { font-size: 0.96rem; }
    .rvhg-header__brand small { font-size: 0.58rem; }
    .rvhg-header__brand img { width: 44px; height: 44px; }
    .rvhg-header__nav, .rvhg-header__actions { display: none; }
    .rvhg-header__toggle { display: inline-flex; flex: 0 0 auto; }
  }
  @media (max-width: 430px) {
    .rvhg-header__brand img { width: 40px; height: 40px; }
    .rvhg-header__brand strong { font-size: 0.86rem; }
    .rvhg-header__brand small { display: none; }
    .rvhg-header__notice { font-size: 0.64rem; }
  }
</style>

<script>
  function initHeader() {
    const header = document.querySelector('[data-rvhg-header]');
    const toggle = document.querySelector('[data-rvhg-menu-toggle]') as HTMLButtonElement | null;
    const nav = document.getElementById('rvhg-mobile-nav');
    if (!header || !toggle || !nav) return;
    const close = () => { toggle.setAttribute('aria-expanded', 'false'); toggle.setAttribute('aria-label', 'Mở menu'); nav.hidden = true; };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Mở menu' : 'Đóng menu');
      nav.hidden = open;
    });
    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    const match = document.cookie.match(/googtrans=\/[^/]+\/([^;]+)/);
    const current = match ? decodeURIComponent(match[1]) : 'vi';
    document.querySelectorAll('[data-rvhg-lang]').forEach((element) => {
      const select = element as HTMLSelectElement;
      select.value = current;
      select.addEventListener('change', () => {
        const setLanguage = (window as unknown as { rvhgSetLang?: (language: string) => void }).rvhgSetLang;
        if (setLanguage) setLanguage(select.value);
      });
    });
    const onScroll = () => window.scrollY > 8 ? header.setAttribute('data-scrolled', '') : header.removeAttribute('data-scrolled');
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>
