---
import { NAV } from '../data/site';
import LegacyImg from './LegacyImg.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);

// Split the nav into two groups that flank the central emblem (old-site layout).
const mid = Math.ceil(NAV.length / 2);
const navLeft = NAV.slice(0, mid);
const navRight = NAV.slice(mid);

// Languages offered by the Google machine-translation switcher.
const LANGS = [
  { code: 'vi', label: 'Tiếng Việt' },
  { code: 'en', label: 'English' },
  { code: 'ja', label: '日本語' },
  { code: 'ko', label: '한국어' },
  { code: 'zh-CN', label: '中文' },
  { code: 'fr', label: 'Français' },
];
---

<header class="rvhg-header" data-rvhg-header>
  <div class="rvhg-header__inner">
    <nav class="rvhg-header__side rvhg-header__side--left" aria-label="Điều hướng (trái)">
      <ul>
        {navLeft.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/" class="rvhg-header__emblem" aria-label="Trang chủ — Rồng Vàng Hoàng Gia">
      <LegacyImg
        src="/images/legacy/logo-seal.png"
        alt="Rồng Vàng Hoàng Gia — Đặc sản nức tiếng Hải Dương"
        width={512}
        height={512}
        sizes="76px"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <nav class="rvhg-header__side rvhg-header__side--right" aria-label="Điều hướng (phải)">
      <ul>
        {navRight.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li class="rvhg-header__lang">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
          </svg>
          <select class="rvhg-lang-select" data-rvhg-lang aria-label="Ngôn ngữ / Language">
            {LANGS.map((l) => <option value={l.code}>{l.label}</option>)}
          </select>
        </li>
      </ul>
    </nav>

    <button
      type="button"
      class="rvhg-header__toggle"
      aria-expanded="false"
      aria-controls="rvhg-mobile-nav"
      aria-label="Mở menu"
      data-rvhg-menu-toggle
    >
      <svg class="rvhg-header__icon rvhg-header__icon--bars" viewBox="0 0 20 20" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <line x1="2" y1="5" x2="18" y2="5" />
        <line x1="2" y1="10" x2="18" y2="10" />
        <line x1="2" y1="15" x2="18" y2="15" />
      </svg>
      <svg class="rvhg-header__icon rvhg-header__icon--close" viewBox="0 0 20 20" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <line x1="4" y1="4" x2="16" y2="16" />
        <line x1="16" y1="4" x2="4" y2="16" />
      </svg>
    </button>
  </div>

  <div class="rvhg-mobile-scrim" data-rvhg-menu-scrim hidden></div>

  <nav id="rvhg-mobile-nav" class="rvhg-mobile-nav" aria-label="Điều hướng (di động)" hidden>
    <ul>
      {NAV.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
      <li class="rvhg-mobile-nav__lang">
        <span>Ngôn ngữ / Language</span>
        <select class="rvhg-lang-select rvhg-lang-select--mobile" data-rvhg-lang aria-label="Ngôn ngữ / Language">
          {LANGS.map((l) => <option value={l.code}>{l.label}</option>)}
        </select>
      </li>
    </ul>
  </nav>
</header>

<style>
  .rvhg-header {
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--color-paper-50, #fbf8f1);
    /* #8B0000 + vệt sáng rất nhẹ phía trên (ánh sáng rọi xuống mặt sơn mài).
       Lớp phủ tan hết trước mép dưới nên liền mạch tuyệt đối với hero. */
    background:
      linear-gradient(180deg, rgb(170 22 16 / 0.38) 0%, rgb(170 22 16 / 0) 85%),
      #8b0000;
    border-bottom: 1px solid color-mix(in srgb, var(--brass) 45%, transparent);
  }
  /* brass corner brackets — restrained nod to the lacquer frame */
  .rvhg-header::before,
  .rvhg-header::after {
    content: '';
    position: absolute;
    top: 10px;
    width: 26px;
    height: 26px;
    border-top: 1px solid color-mix(in srgb, var(--color-brass-400, #c5a878) 70%, transparent);
    pointer-events: none;
  }
  .rvhg-header::before { left: 12px;  border-left: 1px solid color-mix(in srgb, var(--color-brass-400, #c5a878) 70%, transparent); }
  .rvhg-header::after  { right: 12px; border-right: 1px solid color-mix(in srgb, var(--color-brass-400, #c5a878) 70%, transparent); }

  .rvhg-header__inner {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: 1.5rem;
    min-height: 92px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.25rem;
    transition: min-height 0.3s var(--ease-refined, ease);
  }
  @media (min-width: 768px) {
    .rvhg-header__inner { padding-inline: 2.5rem; }
  }
  .rvhg-header[data-scrolled] .rvhg-header__inner { min-height: 72px; }

  /* central emblem */
  .rvhg-header__emblem {
    display: inline-flex;
    justify-self: center;
    line-height: 0;
  }
  /* :global vì <img> do LegacyImg render — không mang hash scope của file này */
  .rvhg-header__emblem :global(img) {
    width: 76px;
    height: 76px;
    border-radius: 9999px;
    object-fit: cover;
    display: block;
    /* hairline brass ring lifts the red seal off the maroon header */
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-brass-400, #c5a878) 55%, transparent);
    transition: width 0.3s var(--ease-refined, ease), height 0.3s var(--ease-refined, ease);
  }
  .rvhg-header[data-scrolled] .rvhg-header__emblem :global(img) { width: 60px; height: 60px; }

  /* flanking nav groups */
  .rvhg-header__side ul {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rvhg-header__side--left ul  { justify-content: flex-end; }
  .rvhg-header__side--right ul { justify-content: flex-start; }
  .rvhg-header__side a {
    display: inline-block;
    padding: 0.5rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-paper-50, #fbf8f1);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.18s var(--ease-refined, ease);
  }
  .rvhg-header__side a:hover { color: var(--color-brass-300, #d8c29a); }
  .rvhg-header__side a[aria-current='page'] {
    color: var(--color-brass-300, #d8c29a);
  }

  /* language switcher */
  .rvhg-header__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: 0.4rem;
    padding-left: 0.7rem;
    border-left: 1px solid color-mix(in srgb, var(--brass) 35%, transparent);
    color: var(--color-brass-300, #d8c29a);
  }
  .rvhg-lang-select {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: 0;
    color: var(--color-paper-50, #fbf8f1);
    font: inherit;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 0.3rem 0.2rem;
  }
  .rvhg-lang-select:hover { color: var(--color-brass-300, #d8c29a); }
  .rvhg-lang-select option { color: #1c1714; text-transform: none; }

  /* mobile toggle — vùng chạm 44×44 theo WCAG 2.5.8 */
  .rvhg-header__toggle {
    display: none;
    grid-column: 1;
    justify-self: start;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-left: -0.5rem; /* kéo lại mép quang học sau khi nới vùng chạm */
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-paper-50, #fbf8f1);
    cursor: pointer;
  }
  .rvhg-header__icon--close { display: none; }
  .rvhg-header__toggle[aria-expanded='true'] .rvhg-header__icon--bars { display: none; }
  .rvhg-header__toggle[aria-expanded='true'] .rvhg-header__icon--close { display: block; }

  /* lớp phủ phía sau ngăn kéo — chạm ra ngoài để đóng */
  .rvhg-mobile-scrim {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgb(26 6 6 / 0.5);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }

  /* Ngăn kéo di động — phủ lên nội dung thay vì đẩy nội dung xuống.
     Nằm ngoài luồng (absolute) nên đóng/mở không làm đổi chiều cao tài liệu;
     nếu để trong luồng, scroll-anchoring của trình duyệt sẽ tự dịch scrollY
     đúng bằng chiều cao ngăn kéo và vị trí cuộn bị nhảy khi đóng. */
  .rvhg-mobile-nav {
    position: absolute;
    top: 100%;
    inset-inline: 0;
    z-index: 45;
    background: #8b0000;
    border-top: 1px solid color-mix(in srgb, var(--brass) 30%, transparent);
    max-height: calc(100dvh - 100%);
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow: 0 18px 32px -22px rgba(0, 0, 0, 0.7);
  }
  .rvhg-mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.5rem 1.25rem;
  }
  .rvhg-mobile-nav a {
    display: block;
    padding: 0.9rem 0.25rem;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-paper-50, #fbf8f1);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--brass) 18%, transparent);
  }
  .rvhg-mobile-nav a[aria-current='page'] { color: var(--color-brass-300, #d8c29a); }
  .rvhg-mobile-nav__lang {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0.25rem 0.25rem;
  }
  .rvhg-mobile-nav__lang span {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brass-300, #d8c29a);
  }
  .rvhg-lang-select--mobile {
    border: 1px solid color-mix(in srgb, var(--brass) 35%, transparent);
    border-radius: var(--radius-sm, 2px);
    padding: 0.5rem 0.75rem;
    min-height: 44px; /* WCAG 2.5.8 — trước đây chỉ cao 17px */
  }

  @media (max-width: 900px) {
    .rvhg-header__side { display: none; }
    .rvhg-header::before, .rvhg-header::after { display: none; }
    .rvhg-header__inner {
      position: relative;            /* anchor the absolutely-centred emblem */
      z-index: 46;                   /* thanh header không bị lớp phủ làm tối */
      display: flex;
      align-items: center;
      min-height: 70px;
      padding-inline: 1.25rem;
    }
    .rvhg-header__toggle { display: inline-flex; }
    /* dead-centre the emblem regardless of the hamburger width */
    .rvhg-header__emblem {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
    }
    .rvhg-header__emblem :global(img) { width: 62px; height: 62px; }
    .rvhg-header[data-scrolled] .rvhg-header__inner { min-height: 60px; }
    .rvhg-header[data-scrolled] .rvhg-header__emblem :global(img) { width: 52px; height: 52px; }
  }
</style>

<script>
  function initHeader() {
    const header = document.querySelector('[data-rvhg-header]');
    const toggle = document.querySelector('[data-rvhg-menu-toggle]') as HTMLButtonElement | null;
    const nav = document.getElementById('rvhg-mobile-nav');
    const scrim = document.querySelector('[data-rvhg-menu-scrim]') as HTMLElement | null;
    if (!header || !toggle || !nav) return;

    // Sau khi ClientRouter thay trang: gỡ mọi trạng thái khoá còn sót lại.
    document.body.removeAttribute('data-rvhg-locked');
    document.body.style.removeProperty('--rvhg-lock-top');

    // Khoá cuộn nền khi mở ngăn kéo: giữ nguyên vị trí cuộn, tránh nhảy trang
    // trên iOS. Lưu vị trí để khôi phục chính xác lúc đóng.
    let lockedY = 0;

    const setOpen = (open: boolean) => {
      const body = document.body;

      // Phải đọc scrollY TRƯỚC khi hiện ngăn kéo: ngăn kéo nằm trong header ở
      // đầu tài liệu, hiện ra là thêm chiều cao ở trên → scroll-anchoring của
      // trình duyệt tự cộng đúng chiều cao đó vào scrollY. Đọc sau sẽ khoá
      // nhầm vị trí và lúc đóng trang bị nhảy xuống.
      if (open) lockedY = window.scrollY;

      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Đóng menu' : 'Mở menu');
      nav.hidden = !open;
      if (scrim) scrim.hidden = !open;

      if (open) {
        body.style.setProperty('--rvhg-lock-top', `-${lockedY}px`);
        body.setAttribute('data-rvhg-locked', '');
      } else if (body.hasAttribute('data-rvhg-locked')) {
        body.removeAttribute('data-rvhg-locked');
        body.style.removeProperty('--rvhg-lock-top');
        window.scrollTo(0, lockedY);
      }
    };

    const close = () => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      // trả tiêu điểm về nút mở, nhưng không được kéo trang đi
      toggle.focus({ preventScroll: true });
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    scrim?.addEventListener('click', close);
    // Listener cấp document/window chỉ gắn một lần — initHeader chạy lại mỗi
    // lần ClientRouter thay trang, nếu không sẽ chồng chất handler.
    const w = window as unknown as { __rvhgMenu?: () => void };
    w.__rvhgMenu = close;
    if (!(window as unknown as { __rvhgMenuBound?: boolean }).__rvhgMenuBound) {
      (window as unknown as { __rvhgMenuBound?: boolean }).__rvhgMenuBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') w.__rvhgMenu?.();
      });
      // Quay lại bố cục desktop khi đang mở → dọn sạch trạng thái khoá cuộn.
      window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => {
        if (e.matches) w.__rvhgMenu?.();
      });
    }

    // language switcher — reflect current language, switch on change
    const m = document.cookie.match(/googtrans=\/[^/]+\/([^;]+)/);
    const current = m ? decodeURIComponent(m[1]) : 'vi';
    document.querySelectorAll('[data-rvhg-lang]').forEach((el) => {
      const sel = el as HTMLSelectElement;
      sel.value = current;
      sel.addEventListener('change', () => {
        const fn = (window as unknown as { rvhgSetLang?: (l: string) => void }).rvhgSetLang;
        if (fn) fn(sel.value);
      });
    });

    const onScroll = () => {
      if (window.scrollY > 8) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>
