---
import LegacyImg from './LegacyImg.astro';

interface Props {
  name: string;
  image?: string;
  weight?: string;
  isOcop5Star?: boolean;
  loading?: 'lazy' | 'eager';
  /** Optional accent hex for the nameplate fallback. */
  accent?: string;
}

const { name, image, weight, isOcop5Star = false, loading = 'lazy', accent } = Astro.props;

/** Initials shown on the nameplate fallback when an image is missing. */
const initials = name
  .replace(/[^\p{L} ]/gu, '')
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w.charAt(0).toUpperCase())
  .join('');

const fallbackStyle = accent
  ? `background: linear-gradient(160deg, ${accent}1a, ${accent}33);`
  : '';
---

<figure class="rvhg-tile">
  <div class="rvhg-tile__media">
    {image ? (
      <LegacyImg src={image} alt={name} width={600} height={600} loading={loading} sizes="(max-width: 600px) 50vw, 25vw" />
    ) : (
      <div class="rvhg-tile__plate" style={fallbackStyle} aria-hidden="true">
        <span>{initials || '※'}</span>
      </div>
    )}
    {isOcop5Star && <span class="rvhg-tile__badge">OCOP 5★</span>}
  </div>
  <figcaption class="rvhg-tile__name">
    {name}
    {weight && <small> · {weight}</small>}
  </figcaption>
</figure>

<style>
  .rvhg-tile {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .rvhg-tile__media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--color-paper-tint);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .rvhg-tile__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .rvhg-tile:hover .rvhg-tile__media :global(img) {
    transform: scale(1.03);
  }
  .rvhg-tile__plate {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, var(--color-paper-soft), var(--color-paper-tint));
    color: var(--color-mute);
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .rvhg-tile__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: rgb(0 0 0 / 0.78);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.55rem;
    border-radius: var(--radius-pill);
    backdrop-filter: blur(8px);
  }
  .rvhg-tile__name {
    font-size: 0.95rem;
    line-height: 1.35;
    color: var(--color-ink);
    font-weight: 500;
  }
  .rvhg-tile__name small {
    color: var(--color-mute);
    font-weight: 400;
  }
</style>
