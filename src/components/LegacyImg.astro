---
/**
 * Renders an image mirrored from the original wp-content into /public/images/legacy/.
 *
 * Phase-1 note: these files are currently low-weight placeholders. Once the real
 * assets are mirrored in, swap this component for Astro's <Image /> + ESM imports
 * (move files under src/assets/) to get automatic AVIF/WebP + responsive srcset.
 */
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  style?: string;
}
const {
  src,
  alt,
  width = 1200,
  height = 900,
  class: className = '',
  loading = 'lazy',
  fetchpriority = 'auto',
  sizes,
  style,
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
  sizes={sizes}
  class={className}
  style={style}
/>
