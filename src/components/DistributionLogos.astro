---
import { COMPANY } from '../data/site';
interface Props {
  title?: string;
}
const { title = 'Có mặt tại các hệ thống phân phối' } = Astro.props;
const channels = [...COMPANY.distributors, 'Shopee', 'TikTok Shop'];
---

<section class="rvhg-dist" aria-label={title}>
  <h2 class="rvhg-dist__title">{title}</h2>
  <ul class="rvhg-dist__list">
    {channels.map((c) => <li>{c}</li>)}
  </ul>
  <p class="rvhg-dist__note">Xuất khẩu: {COMPANY.exportMarkets.join(' · ')}</p>
</section>

<style>
  .rvhg-dist {
    text-align: center;
  }
  .rvhg-dist__title {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-mute);
    margin-bottom: 1.25rem;
  }
  .rvhg-dist__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0.75rem;
  }
  .rvhg-dist__list li {
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: var(--color-rvhg-cream);
    color: var(--color-rvhg-gold-dark);
    font-size: 0.85rem;
    font-weight: 500;
  }
  .rvhg-dist__note {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--color-mute);
  }
</style>
