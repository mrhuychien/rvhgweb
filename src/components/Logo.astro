---
interface Props {
  class?: string;
  /** When true, only the seal mark renders (no wordmark). */
  markOnly?: boolean;
  /** Force light/dark variant; otherwise inherits currentColor. */
  variant?: 'light' | 'dark';
}
const { class: className = '', markOnly = false, variant } = Astro.props;
const colorClass = variant === 'light' ? 'rvhg-logo--light' : variant === 'dark' ? 'rvhg-logo--dark' : '';
---

<span class={`rvhg-logo ${colorClass} ${className}`}>
  <svg viewBox="0 0 32 32" width="22" height="22" class="rvhg-logo__mark" role="img" aria-label="Rồng Vàng Hoàng Gia">
    <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="1.25" />
    <text x="16" y="17" text-anchor="middle" dominant-baseline="central" font-family="'Playfair Display', Georgia, serif" font-weight="700" font-size="11" fill="currentColor">RV</text>
  </svg>
  {!markOnly && (
    <span class="rvhg-logo__text">
      Rồng Vàng Hoàng Gia
    </span>
  )}
</span>

<style>
  .rvhg-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink);
  }
  .rvhg-logo--light { color: #fff; }
  .rvhg-logo--dark  { color: var(--color-ink); }
  .rvhg-logo__mark { flex: none; }
  .rvhg-logo__text {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1;
  }
  @media (max-width: 480px) {
    .rvhg-logo__text { font-size: 0.875rem; }
  }
</style>
