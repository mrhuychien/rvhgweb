---
/**
 * Thanh gọi/Zalo cố định ở đáy màn hình — chỉ hiện trên mobile (< 900px).
 * Site bán quà biếu, phần lớn truy cập là điện thoại: đây là lối chuyển đổi
 * ngắn nhất. Ẩn hoàn toàn trên desktop và khi in.
 */
import { COMPANY } from '../data/site';

const tel = COMPANY.phone.replace(/\D/g, '');
const pretty = tel.replace(/^(\d{4})(\d{3})(\d{3})$/, '$1 $2 $3');
---

<div class="rvhg-callbar" role="complementary" aria-label="Liên hệ nhanh">
  <a class="rvhg-callbar__btn" href={`tel:${tel}`}>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" />
    </svg>
    <span>Gọi {pretty}</span>
  </a>
  <a class="rvhg-callbar__btn rvhg-callbar__btn--ghost" href={`https://zalo.me/${tel}`} target="_blank" rel="noopener noreferrer">
    <span>Nhắn Zalo</span>
  </a>
</div>

<style>
  .rvhg-callbar { display: none; }

  @media (max-width: 900px) {
    .rvhg-callbar {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 0.5rem;
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 60;
      padding: 0.6rem 0.75rem calc(0.6rem + env(safe-area-inset-bottom, 0px));
      background: color-mix(in srgb, #8b0000 96%, transparent);
      border-top: 1px solid color-mix(in srgb, var(--brass) 40%, transparent);
      box-shadow: 0 -8px 24px -14px rgba(0, 0, 0, 0.6);
    }
    .rvhg-callbar__btn {
      min-height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.45rem;
      border-radius: var(--radius-sm, 2px);
      background: var(--color-brass-400, #c5a878);
      color: #2a0c0e;
      font-size: 0.92rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      text-decoration: none;
      padding-inline: 0.75rem;
    }
    .rvhg-callbar__btn--ghost {
      background: transparent;
      color: var(--color-paper-50, #fbf8f1);
      border: 1px solid color-mix(in srgb, var(--brass) 55%, transparent);
      font-weight: 500;
    }
  }

  @media print {
    .rvhg-callbar { display: none !important; }
  }
</style>
