---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LegacyImg from '../components/LegacyImg.astro';
import Motion from '../components/Motion.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import { videoSchema } from '../data/jsonld';
import { SITE, BRAND_VIDEO, REASONS, FEATURED, DISTRIBUTION_LOGOS, YEARS_EXPERIENCE } from '../data/site';
import { POWDERS, POWDER_SINGLES, assetUrl } from '../data/powders';
import { isPublished, postPath } from '../lib/posts';

const lines = (await getCollection('productCategories')).sort((a, b) => a.data.order - b.data.order);
const latestPosts = (await getCollection('posts', isPublished))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
const fmt = (date: Date) => new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(date);
const powderSlides = [
  ...POWDER_SINGLES.map((slug) => ({
    href: `/${slug}/`, image: POWDERS[slug].image, name: POWDERS[slug].name,
    tag: POWDERS[slug].flavor, desc: POWDERS[slug].tagline,
    accent: POWDERS[slug].accent, accentInk: POWDERS[slug].accentInk,
  })),
  {
    href: '/bdx-rauma-khongduong/', image: POWDERS['botdx-rauma-khongduong'].image,
    name: 'Không thêm đường', tag: 'Plant based',
    desc: 'Rau má và sữa dừa thuần thực vật, giàu đạm.', accent: '#3f7d4e', accentInk: '#2c5c39',
  },
];
---

<BaseLayout
  title="Bánh đậu xanh OCOP 5 sao Quốc gia"
  description={SITE.shortDescription}
  jsonLd={videoSchema({ id: BRAND_VIDEO.id, name: BRAND_VIDEO.title, description: BRAND_VIDEO.description, uploadDate: BRAND_VIDEO.uploadDate, url: '/' })}
>
  <section class="home-hero">
    <div class="rvhg-container home-hero__grid">
      <div class="home-hero__copy" data-reveal>
        <p class="rvhg-eyebrow">Rồng Vàng Hoàng Gia · Từ năm 1997</p>
        <h1>Tinh hoa bánh đậu xanh <em>Xứ Đông.</em></h1>
        <p class="home-hero__lede">
          Vị bánh truyền thống Hải Dương được gìn giữ qua nhiều thế hệ, nay được công nhận ở cấp cao nhất của chương trình OCOP Quốc gia.
        </p>
        <div class="home-hero__actions">
          <a class="rvhg-btn" href="/san-pham/">Khám phá bộ sưu tập <span aria-hidden="true">↗</span></a>
          <a class="home-link" href="/cau-chuyen-san-pham-rong-vang-hoang-gia-2/">Câu chuyện thương hiệu <span aria-hidden="true">→</span></a>
        </div>
        <ul class="home-hero__proof" aria-label="Chứng nhận nổi bật">
          <li><strong>5★</strong><span>OCOP Quốc gia</span></li>
          <li><strong>ISO</strong><span>22000:2018</span></li>
          <li><strong>06</strong><span>Thị trường xuất khẩu</span></li>
        </ul>
      </div>

      <figure class="home-hero__visual" data-reveal="zoom">
        <LegacyImg src="/images/legacy/hero-home.jpg" alt="Bộ bánh đậu xanh cao cấp Rồng Vàng Hoàng Gia" width={2400} height={1350} loading="eager" fetchpriority="high" />
        <figcaption>
          <span>Di sản vị Việt</span>
          <strong>OCOP 5 sao<br/>Quốc gia 2024</strong>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="home-intro">
    <div class="rvhg-container home-intro__grid">
      <div class="home-intro__number" data-reveal>
        <strong data-years-since="1997">{YEARS_EXPERIENCE}</strong><span>Năm giữ nghề</span>
      </div>
      <div class="home-intro__copy" data-reveal>
        <p class="rvhg-eyebrow">Một đặc sản, một di sản</p>
        <h2>Không chỉ làm bánh.<br/>Chúng tôi gìn giữ một hương vị.</h2>
      </div>
      <div class="home-intro__body" data-reveal>
        <p>Từ hạt đậu xanh lòng vàng, kỹ thuật rang — nghiền — phối trộn đến cách thưởng bánh cùng trà, mỗi chi tiết đều được chăm chút để giữ trọn vị bùi, ngọt thanh và độ tan mịn đặc trưng.</p>
        <a class="home-link" href="/gioi-thieu/">Tìm hiểu về Hoàng Giang <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="home-heritage">
    <div class="rvhg-container home-heritage__grid">
      <figure class="home-heritage__media" data-reveal="left">
        <LegacyImg src="/images/legacy/cau-chuyen-khai-dinh-1918.jpg" alt="Câu chuyện bánh đậu xanh tiến vua năm 1918" width={1200} height={900} />
        <span class="home-heritage__year">1918</span>
      </figure>
      <div class="home-heritage__copy" data-reveal="right">
        <p class="rvhg-eyebrow">Câu chuyện khởi nguồn</p>
        <h2>Từ món bánh tiến vua đến niềm tự hào Hải Dương.</h2>
        <p>Bánh đậu xanh gắn với câu chuyện vua Khải Định tuần du Xứ Đông. Rồng Vàng Hoàng Gia tiếp nối tinh thần ấy bằng quy trình sản xuất hiện đại, minh bạch và chuẩn hoá.</p>
        <blockquote>“Giữ hồn cốt truyền thống, nâng chuẩn chất lượng cho hôm nay.”</blockquote>
        <a class="rvhg-btn rvhg-btn--ghost" href="/cau-chuyen-san-pham-rong-vang-hoang-gia-2/">Đọc câu chuyện thương hiệu</a>
      </div>
    </div>
  </section>

  <section class="home-products rvhg-section">
    <div class="rvhg-container">
      <header class="home-heading home-heading--split" data-reveal>
        <div>
          <p class="rvhg-eyebrow">Sản phẩm tiêu biểu</p>
          <h2>Quà Việt được làm<br/>một cách chỉn chu.</h2>
        </div>
        <div>
          <p>Từ hộp bánh dùng hằng ngày đến quà biếu trang trọng — cùng chung tiêu chuẩn chất lượng và dấu ấn Rồng Vàng Hoàng Gia.</p>
          <a class="home-link" href="/san-pham/">Xem toàn bộ sản phẩm <span aria-hidden="true">→</span></a>
        </div>
      </header>
      <div class="home-products__grid">
        {FEATURED.slice(0, 6).map((product, index) => (
          <a class={`home-product ${index === 0 || index === 3 ? 'home-product--wide' : ''}`} href={product.href} data-reveal style={`--reveal-delay:${(index % 3) * 80}ms`}>
            <span class="home-product__media">
              <LegacyImg src={product.image} alt={product.name} width={800} height={800} loading={index < 3 ? 'eager' : 'lazy'} />
            </span>
            <span class="home-product__meta"><strong>{product.name}</strong><span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-standards">
    <div class="rvhg-container home-standards__grid">
      <div class="home-standards__title" data-reveal>
        <p class="rvhg-eyebrow">Chất lượng được xác tín</p>
        <h2>Truyền thống không có nghĩa là cũ.</h2>
        <p>Giữ công thức cốt lõi, đồng thời chuẩn hoá nguyên liệu, an toàn thực phẩm và năng lực phân phối theo tiêu chuẩn hiện đại.</p>
        <a class="rvhg-btn" href="/cong-bo/">Xem hồ sơ công bố</a>
      </div>
      <ul class="home-standards__list">
        {REASONS.slice(0, 6).map((reason, index) => (
          <li data-reveal style={`--reveal-delay:${(index % 2) * 70}ms`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div><h3 set:html={reason.title}></h3><p set:html={reason.body}></p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="home-categories rvhg-section">
    <div class="rvhg-container">
      <header class="home-heading" data-reveal>
        <p class="rvhg-eyebrow">Bộ sưu tập</p>
        <h2>Chọn theo từng dịp trao tặng.</h2>
      </header>
      <div class="home-categories__grid">
        {lines.map((line, index) => (
          <a class={`home-category home-category--${index + 1}`} href={`/danh-muc-san-pham/${line.id}/`} data-reveal={index % 2 ? 'right' : 'left'}>
            <LegacyImg src={line.data.cardImage ?? line.data.heroImage ?? ''} alt={line.data.title} width={1200} height={900} loading={index < 2 ? 'eager' : 'lazy'} />
            <span class="home-category__shade"></span>
            <span class="home-category__copy">
              <small>{line.data.eyebrow ?? `Dòng ${index + 1}`}</small>
              <strong>{line.data.title}</strong>
              <em>{line.data.products.length} sản phẩm <span aria-hidden="true">↗</span></em>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-powder">
    <div class="rvhg-container">
      <header class="home-heading home-heading--split" data-reveal>
        <div><p class="rvhg-eyebrow">Dòng mới</p><h2>Bột đậu xanh.<br/>Dinh dưỡng mỗi ngày.</h2></div>
        <div><p>Tiện lợi trong một ly nóng hoặc lạnh, phối cùng nguyên liệu tự nhiên và hương vị dễ uống.</p><a class="home-link" href="/danh-muc-san-pham/bot-dau/">Khám phá dòng bột đậu <span aria-hidden="true">→</span></a></div>
      </header>
      <div class="home-powder__rail">
        {powderSlides.map((item) => (
          <a class="home-powder__card" href={item.href} style={`--powder:${item.accent};--powder-ink:${item.accentInk}`} data-reveal>
            <span class="home-powder__image"><LegacyImg src={assetUrl(item.image)} alt={item.name} width={640} height={640} /></span>
            <span class="home-powder__body"><small>{item.tag}</small><strong>{item.name}</strong><p>{item.desc}</p><em>Xem chi tiết <span aria-hidden="true">↗</span></em></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-film rvhg-band-night">
    <div class="rvhg-container home-film__grid">
      <div class="home-film__copy" data-reveal>
        <p class="rvhg-eyebrow">Phim thương hiệu</p>
        <h2>Một hành trình từ hạt đậu đến món quà Việt.</h2>
        <p>Khám phá cách Rồng Vàng Hoàng Gia kết nối nghề bánh truyền thống với tiêu chuẩn sản xuất hiện đại.</p>
      </div>
      <div class="home-film__player" data-reveal="zoom"><VideoEmbed id={BRAND_VIDEO.id} title={BRAND_VIDEO.title} loading="lazy" /></div>
    </div>
  </section>

  <section class="home-journal rvhg-section">
    <div class="rvhg-container">
      <header class="home-heading home-heading--split" data-reveal>
        <div><p class="rvhg-eyebrow">Chuyện của vị bánh</p><h2>Tạp chí Rồng Vàng.</h2></div>
        <div><p>Cẩm nang thưởng thức, câu chuyện văn hoá và những gợi ý quà tặng mang bản sắc Việt.</p><a class="home-link" href="/tin-tuc/">Xem tất cả bài viết <span aria-hidden="true">→</span></a></div>
      </header>
      <div class="home-journal__grid">
        {latestPosts.map((post, index) => (
          <a class={`home-article ${index === 0 ? 'home-article--feature' : ''}`} href={postPath(post)} data-reveal>
            <span class="home-article__media">{post.data.cover && <LegacyImg src={post.data.cover} alt={post.data.title} width={1200} height={800} />}</span>
            <span class="home-article__body"><small>{fmt(post.data.publishDate)}</small><strong>{post.data.title}</strong><p>{post.data.description}</p><em>Đọc bài <span aria-hidden="true">↗</span></em></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-distribution">
    <div class="rvhg-container home-distribution__grid">
      <div data-reveal><p class="rvhg-eyebrow">Hệ thống phân phối</p><h2>Dễ dàng tìm thấy trên toàn quốc.</h2><p>Tại các hệ thống bán lẻ hiện đại, cửa hàng đặc sản, sân bay và điểm du lịch.</p></div>
      <ul data-reveal>{DISTRIBUTION_LOGOS.map((logo) => <li><img src={logo.image} alt={logo.name} loading="lazy" decoding="async" /></li>)}</ul>
    </div>
  </section>

  <section class="home-cta">
    <div class="rvhg-container home-cta__inner" data-reveal>
      <div><p class="rvhg-eyebrow">Món quà từ Hải Dương</p><h2>Trao một hộp bánh.<br/>Gửi một câu chuyện Việt.</h2></div>
      <div><p>Cần tư vấn quà biếu, đơn hàng doanh nghiệp hoặc tìm điểm bán gần nhất?</p><div><a class="rvhg-btn" href="/lien-he/">Liên hệ tư vấn</a><a class="home-link" href="/diem-ban-rong-vang-hoang-gia/">Tìm điểm bán <span aria-hidden="true">→</span></a></div></div>
    </div>
  </section>

  <Motion />
</BaseLayout>

<style>
  .home-link { display: inline-flex; align-items: center; gap: 0.5rem; color: inherit; text-decoration: none; font-size: 0.9rem; font-weight: 600; border-bottom: 1px solid rgba(77, 42, 24, 0.35); padding-bottom: 0.2rem; }
  .home-link span { transition: transform 0.2s ease; }
  .home-link:hover span { transform: translateX(4px); }
  .home-heading { max-width: 50rem; margin-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .home-heading h2 { margin-top: 0.7rem; font-size: clamp(2.25rem, 4.6vw, 4.5rem); line-height: 1.02; }
  .home-heading--split { max-width: none; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.65fr); align-items: end; gap: 4rem; }
  .home-heading--split > div:last-child { padding-bottom: 0.35rem; }
  .home-heading--split > div:last-child p { color: var(--color-mute); max-width: 34rem; margin-bottom: 1.2rem; }

  .home-hero { min-height: min(780px, calc(100vh - 112px)); display: flex; align-items: center; position: relative; overflow: hidden; background: #f7f1e7; }
  .home-hero::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 48%; background: radial-gradient(circle at 20% 30%, rgba(184, 143, 74, 0.13), transparent 50%); pointer-events: none; }
  .home-hero__grid { display: grid; grid-template-columns: minmax(370px, 0.8fr) minmax(0, 1.25fr); align-items: center; gap: clamp(2.5rem, 6vw, 6rem); padding-block: clamp(4rem, 7vw, 7.5rem); }
  .home-hero__copy { position: relative; z-index: 1; }
  .home-hero h1 { margin-top: 1rem; max-width: 9ch; font-size: clamp(3rem, 5.8vw, 6.2rem); font-weight: 620; line-height: 0.96; letter-spacing: -0.045em; }
  .home-hero h1 em { color: #7a161e; font-weight: 500; }
  .home-hero__lede { margin-top: 1.6rem; max-width: 34rem; color: #65564d; font-size: clamp(1rem, 0.55vw + 0.9rem, 1.18rem); line-height: 1.75; }
  .home-hero__actions { margin-top: 2rem; display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }
  .home-hero__proof { list-style: none; margin: 3rem 0 0; padding: 1.5rem 0 0; border-top: 1px solid rgba(77, 42, 24, 0.16); display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .home-hero__proof li { display: flex; flex-direction: column; gap: 0.15rem; }
  .home-hero__proof strong { color: #72131b; font-family: var(--font-display); font-size: 1.25rem; line-height: 1; }
  .home-hero__proof span { color: #81736a; font-size: 0.68rem; letter-spacing: 0.03em; }
  .home-hero__visual { position: relative; min-height: 560px; margin: 0; overflow: hidden; background: #68131a; box-shadow: 0 32px 80px rgba(72, 31, 22, 0.17); }
  .home-hero__visual :global(img) { width: 100%; height: 100%; min-height: 560px; object-fit: cover; object-position: 50% 50%; display: block; }
  .home-hero__visual::after { content: ''; position: absolute; inset: 0; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.16); pointer-events: none; }
  .home-hero__visual figcaption { position: absolute; right: 0; bottom: 0; width: 190px; padding: 1.2rem 1.3rem; background: #f8f3e9; color: #3a251d; display: flex; flex-direction: column; gap: 0.35rem; }
  .home-hero__visual figcaption span { color: #8f6f41; font-size: 0.62rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
  .home-hero__visual figcaption strong { font-family: var(--font-display); font-size: 1.12rem; line-height: 1.25; }

  .home-intro { padding-block: clamp(5rem, 9vw, 9rem); border-bottom: 1px solid var(--color-line); }
  .home-intro__grid { display: grid; grid-template-columns: 0.42fr 1.15fr 0.85fr; align-items: start; gap: clamp(2rem, 5vw, 5rem); }
  .home-intro__number { display: flex; flex-direction: column; border-left: 1px solid #ad8144; padding-left: 1.2rem; }
  .home-intro__number strong { font-family: var(--font-display); font-size: clamp(3.5rem, 6vw, 6rem); font-weight: 500; line-height: 0.9; color: #74151d; }
  .home-intro__number span { margin-top: 0.6rem; color: var(--color-mute); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .home-intro__copy h2 { margin-top: 0.75rem; font-size: clamp(2.2rem, 3.6vw, 4rem); line-height: 1.05; }
  .home-intro__body { padding-top: 2rem; }
  .home-intro__body p { color: var(--color-mute); margin-bottom: 1.5rem; }

  .home-heritage { padding-block: clamp(5rem, 9vw, 9rem); background: #eee5d7; }
  .home-heritage__grid { display: grid; grid-template-columns: 1.12fr 0.88fr; align-items: center; gap: clamp(3rem, 8vw, 8rem); }
  .home-heritage__media { position: relative; min-height: 540px; margin: 0; overflow: hidden; }
  .home-heritage__media :global(img) { width: 100%; height: 100%; min-height: 540px; object-fit: cover; filter: saturate(0.82) contrast(1.03); }
  .home-heritage__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(37,19,14,0.35), transparent 50%); }
  .home-heritage__year { position: absolute; left: 1.5rem; bottom: 0.4rem; z-index: 1; color: #f8f1e6; font-family: var(--font-display); font-size: clamp(4.5rem, 9vw, 9rem); font-weight: 500; line-height: 1; letter-spacing: -0.06em; }
  .home-heritage__copy h2 { margin-top: 0.8rem; font-size: clamp(2.4rem, 4.2vw, 4.7rem); line-height: 1.03; }
  .home-heritage__copy > p:not(.rvhg-eyebrow) { margin-top: 1.6rem; color: var(--color-mute); font-size: 1.04rem; }
  .home-heritage blockquote { margin: 2rem 0; padding: 1.25rem 0 1.25rem 1.5rem; border-left: 1px solid #a87539; color: #4e352b; font-family: var(--font-display); font-size: 1.35rem; font-style: italic; line-height: 1.5; }

  .home-products { background: #fcfaf5; }
  .home-products__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: #dcd1c0; border: 1px solid #dcd1c0; }
  .home-product { min-width: 0; background: #f5efe4; color: #2e221d; text-decoration: none; overflow: hidden; }
  .home-product--wide { grid-column: span 2; }
  .home-product__media { height: 360px; display: grid; place-items: center; overflow: hidden; background: #fffdfa; }
  .home-product__media :global(img) { width: 100%; height: 100%; object-fit: contain; padding: 1.25rem; transition: transform 0.45s var(--ease-refined); }
  .home-product:hover .home-product__media :global(img) { transform: scale(1.035); }
  .home-product__meta { min-height: 76px; padding: 1rem 1.15rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid #e2d9ca; }
  .home-product__meta strong { font-family: var(--font-display); font-size: 1rem; line-height: 1.3; }
  .home-product__meta > span { color: #8a171f; }

  .home-standards { padding-block: clamp(5rem, 9vw, 9rem); background: #551016; color: #f9f3e8; }
  .home-standards__grid { display: grid; grid-template-columns: 0.8fr 1.2fr; align-items: start; gap: clamp(4rem, 9vw, 9rem); }
  .home-standards__title { position: sticky; top: 9rem; }
  .home-standards__title .rvhg-eyebrow { color: #d4b579; }
  .home-standards__title h2 { margin-top: 0.8rem; font-size: clamp(2.5rem, 4.6vw, 4.8rem); line-height: 1.02; }
  .home-standards__title > p:not(.rvhg-eyebrow) { margin: 1.5rem 0 2rem; color: #d7c4b5; max-width: 35rem; }
  .home-standards__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); }
  .home-standards__list li { min-height: 220px; padding: 1.5rem; border-top: 1px solid rgba(219,190,139,0.28); display: grid; grid-template-columns: auto 1fr; gap: 1rem; align-content: start; }
  .home-standards__list li:nth-child(odd) { border-right: 1px solid rgba(219,190,139,0.28); }
  .home-standards__list > li > span { color: #c8a66c; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.08em; }
  .home-standards__list h3 { font-family: var(--font-body); font-size: 1rem; font-weight: 600; color: #fff9ef; }
