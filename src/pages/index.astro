---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LegacyImg from '../components/LegacyImg.astro';
import { faqSchema } from '../data/jsonld';
import { SITE, ANCHORS } from '../data/site';

const lines = (await getCollection('productCategories')).sort((a, b) => a.data.order - b.data.order);

const faq = [
  {
    q: 'Bánh đậu xanh Rồng Vàng Hoàng Gia có đạt OCOP 5 sao không?',
    a: 'Có. Năm 2024, bánh đậu xanh Rồng Vàng Hoàng Gia là sản phẩm bánh đậu xanh đầu tiên và duy nhất cả nước đạt chứng nhận OCOP 5 sao Quốc gia.',
  },
  {
    q: 'Sản phẩm có chứng nhận an toàn thực phẩm nào?',
    a: 'Toàn bộ quy trình sản xuất đạt chứng nhận quốc tế ISO 22000:2018 (HA 394/2.23.CIV) do Quacert cấp ngày 08/08/2023.',
  },
  {
    q: 'Rồng Vàng Hoàng Gia là thương hiệu của công ty nào?',
    a: 'Thương hiệu Rồng Vàng Hoàng Gia do Công ty Cổ phần Hoàng Giang (MST 0800280839, thành lập 1997) tại Hải Dương sản xuất.',
  },
  {
    q: 'Mua bánh đậu xanh Rồng Vàng Hoàng Gia chính hãng ở đâu?',
    a: 'Tại các hệ thống siêu thị BigC/GO!, WinMart, AEON, Lotte, Co.opmart, MegaMarket, Lan Chi; trên Shopee và TikTok Shop; hoặc tại showroom 209C Tuệ Tĩnh và 9 Bạch Đằng, TP Hải Dương.',
  },
  {
    q: 'Vì sao gọi là "Rồng Vàng Hoàng Gia"?',
    a: 'Tên gọi bắt nguồn từ truyền thuyết năm 1918: vua Khải Định trong chuyến tuần du miền Bắc kinh lý trấn Hải Dương, dân dâng bánh đậu xanh, nhà vua ban sắc phong "Bánh Ngon" cùng ấn chỉ Rồng Vàng của Hoàng Gia.',
  },
];
---

<BaseLayout title={SITE.name} description={SITE.shortDescription} jsonLd={faqSchema(faq)}>
  <!-- HERO — full-bleed centered -->
  <section class="rvhg-home-hero">
    <div class="rvhg-container">
      <p class="rvhg-eyebrow">OCOP 5 sao Quốc gia 2024</p>
      <h1>Rồng Vàng Hoàng Gia.</h1>
      <p class="rvhg-home-hero__sub">Đặc sản nức tiếng Hải Dương.</p>
      <p class="rvhg-home-hero__lede">
        Bánh đậu xanh duy nhất đạt OCOP 5 sao Quốc gia.<br/>Sản xuất theo tiêu chuẩn ISO 22000:2018, từ 1997.
      </p>
      <div class="rvhg-home-hero__ctas">
        <a class="rvhg-btn--link" href="/san-pham/">Khám phá sản phẩm  ›</a>
        <a class="rvhg-btn--link" href="/cau-chuyen-san-pham-rong-vang-hoang-gia-2/">Câu chuyện thương hiệu  ›</a>
      </div>
    </div>
    <div class="rvhg-home-hero__media">
      <LegacyImg src="/images/legacy/hero-home.jpg" alt="Bánh đậu xanh Rồng Vàng Hoàng Gia" width={2400} height={1350} loading="eager" fetchpriority="high" />
    </div>
  </section>

  <!-- TWO HERO TILES — feature OCOP + Premium box -->
  <section class="rvhg-home-duo">
    <article class="rvhg-home-duo__tile rvhg-home-duo__tile--dark">
      <div class="rvhg-home-duo__copy">
        <p class="rvhg-eyebrow" style="color: var(--color-night-mute);">Hộp quà OCOP 5 sao</p>
        <h2>Đỉnh cao bánh đậu xanh Việt.</h2>
        <p>Sản phẩm duy nhất đạt phân hạng cao nhất của Chương trình "Mỗi xã một sản phẩm" — biểu tượng cho đặc sản Hải Dương.</p>
        <a class="rvhg-btn--link" href="/danh-muc-san-pham/banh-dau-xanh-thuong-hang/">Xem dòng thượng hạng  ›</a>
      </div>
      <div class="rvhg-home-duo__media">
        <LegacyImg src="/images/legacy/hop-5-sao-web.jpg" alt="Hộp quà OCOP 5 sao Quốc gia" width={1200} height={1200} loading="lazy" />
      </div>
    </article>
    <article class="rvhg-home-duo__tile">
      <div class="rvhg-home-duo__copy">
        <p class="rvhg-eyebrow">Hộp tre cao cấp</p>
        <h2>Quà biếu xứng tầm.</h2>
        <p>Đóng gói thủ công trong hộp tre — gửi trao đối tác, tri ân gia đình trong những dịp trọng đại.</p>
        <a class="rvhg-btn--link" href="/danh-muc-san-pham/banh-dau-xanh-tet/">Xem quà Tết  ›</a>
      </div>
      <div class="rvhg-home-duo__media">
        <LegacyImg src="/images/legacy/banh-dau-xanh-hop-tre-cao-cap-rong-vang-hoang-gia.jpg" alt="Hộp quà tre cao cấp Rồng Vàng Hoàng Gia" width={1200} height={1200} loading="lazy" />
      </div>
    </article>
  </section>

  <!-- 5 PRODUCT LINES — alternating showcase -->
  {lines.map((line, i) => (
    <section class={`rvhg-line-show ${i % 2 === 1 ? 'rvhg-band-tint rvhg-line-show--alt' : ''}`}>
      <div class="rvhg-container rvhg-line-show__inner">
        <div class="rvhg-line-show__copy">
          <p class="rvhg-eyebrow">{line.data.eyebrow ?? `Dòng ${i + 1}`}</p>
          <h2>{line.data.title}.</h2>
          <p class="rvhg-line-show__tagline">{line.data.tagline}</p>
          <p class="rvhg-line-show__lede">{line.data.description}</p>
          <p>
            <a class="rvhg-btn" href={`/danh-muc-san-pham/${line.id}/`}>Xem dòng sản phẩm</a>
          </p>
        </div>
        {line.data.heroImage && (
          <div class="rvhg-line-show__media">
            <LegacyImg src={line.data.heroImage} alt={line.data.title} width={1400} height={1050} loading="lazy" />
          </div>
        )}
      </div>
    </section>
  ))}

  <!-- STORY — Khải Định 1918 -->
  <section class="rvhg-section rvhg-band-night rvhg-home-story">
    <div class="rvhg-container">
      <p class="rvhg-eyebrow" style="color: var(--color-night-mute);">Năm 1918</p>
      <h2>Sắc phong "Bánh Ngon" của Hoàng Gia.</h2>
      <p class="rvhg-home-story__lede">
        {ANCHORS.khaiDinh1918}
      </p>
      <p>
        <a class="rvhg-btn rvhg-btn--ghost" href="/cau-chuyen-san-pham-rong-vang-hoang-gia-2/">Đọc câu chuyện đầy đủ</a>
      </p>
    </div>
  </section>

  <!-- TRUST -->
  <section class="rvhg-section rvhg-container rvhg-home-trust">
    <h2>Bốn lý do chọn Rồng Vàng Hoàng Gia.</h2>
    <ul>
      <li>
        <strong>OCOP 5★</strong>
        <span>Bánh đậu xanh đầu tiên và duy nhất đạt phân hạng quốc gia, 2024.</span>
      </li>
      <li>
        <strong>ISO 22000:2018</strong>
        <span>Hệ thống quản lý an toàn thực phẩm theo tiêu chuẩn quốc tế.</span>
      </li>
      <li>
        <strong>28 năm</strong>
        <span>Sản xuất liên tục từ 1997 — gần ba thập kỷ giữ nghề.</span>
      </li>
      <li>
        <strong>5 quốc gia</strong>
        <span>Xuất khẩu Nhật Bản, Hoa Kỳ, Anh, Hàn Quốc, Canada.</span>
      </li>
    </ul>
  </section>

  <!-- FAQ -->
  <section class="rvhg-section rvhg-band-soft">
    <div class="rvhg-container rvhg-container--narrow rvhg-home-faq">
      <h2>Câu hỏi thường gặp.</h2>
      <div class="rvhg-home-faq__list">
        {faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="rvhg-section rvhg-section--tight">
    <div class="rvhg-container rvhg-home-cta">
      <h2>Đặt quà biếu &amp; mua sỉ.</h2>
      <p>Tư vấn hộp quà Tết, quà doanh nghiệp, đại lý phân phối.</p>
      <div class="rvhg-home-cta__buttons">
        <a class="rvhg-btn" href="tel:0934362658">Gọi 0934 362 658</a>
        <a class="rvhg-btn rvhg-btn--ghost" href="/lien-he/">Liên hệ</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .rvhg-home-hero {
    text-align: center;
    padding-top: 4.5rem;
    padding-bottom: 0;
  }
  @media (min-width: 768px) {
    .rvhg-home-hero { padding-top: 6.5rem; }
  }
  .rvhg-home-hero h1 {
    margin-top: 0.6rem;
    font-size: var(--text-headline);
  }
  .rvhg-home-hero__sub {
    margin-top: 0.5rem;
    font-size: clamp(1.5rem, 2vw + 1rem, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.022em;
    background: linear-gradient(120deg, var(--color-rvhg-gold-dark), var(--color-rvhg-gold), var(--color-rvhg-red));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .rvhg-home-hero__lede {
    margin-top: 1.5rem;
    color: var(--color-mute);
    font-size: clamp(1rem, 0.5vw + 0.95rem, 1.2rem);
    max-width: 36rem;
    margin-inline: auto;
  }
  .rvhg-home-hero__ctas {
    margin-top: 1.5rem;
    display: flex;
    gap: 2rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .rvhg-home-hero__media {
    margin-top: 3rem;
    width: 100%;
  }
  .rvhg-home-hero__media :global(img) {
    width: 100%;
    height: clamp(20rem, 55vw, 36rem);
    object-fit: cover;
    display: block;
  }

  /* ---------- Duo tiles ---------- */
  .rvhg-home-duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 1rem;
    background: var(--color-paper);
  }
  @media (max-width: 900px) {
    .rvhg-home-duo { grid-template-columns: 1fr; padding: 0.5rem; gap: 0.5rem; }
  }
  .rvhg-home-duo__tile {
    position: relative;
    background: var(--color-paper-tint);
    border-radius: var(--radius-card);
    overflow: hidden;
    padding: 3.5rem 2.5rem 0;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 2rem;
    min-height: 32rem;
  }
  @media (max-width: 600px) {
    .rvhg-home-duo__tile { padding: 2.5rem 1.5rem 0; min-height: 26rem; }
  }
  .rvhg-home-duo__tile--dark {
    background: var(--color-night);
    color: var(--color-night-text);
  }
  .rvhg-home-duo__tile--dark h2 { color: #fff; }
  .rvhg-home-duo__tile--dark p { color: var(--color-night-mute); }
  .rvhg-home-duo__copy h2 {
    margin-top: 0.6rem;
    font-size: clamp(1.7rem, 1.5vw + 1rem, 2.5rem);
  }
  .rvhg-home-duo__copy p {
    margin-top: 0.85rem;
    color: var(--color-mute);
    max-width: 32ch;
  }
  .rvhg-home-duo__copy a { display: inline-block; margin-top: 1rem; }
  .rvhg-home-duo__media {
    align-self: end;
    text-align: center;
  }
  .rvhg-home-duo__media :global(img) {
    width: min(80%, 22rem);
    height: auto;
    display: inline-block;
  }

  /* ---------- Line showcase ---------- */
  .rvhg-line-show {
    padding-block: 6rem;
  }
  @media (min-width: 768px) {
    .rvhg-line-show { padding-block: 8rem; }
  }
  .rvhg-line-show__inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: center;
  }
  .rvhg-line-show--alt .rvhg-line-show__inner {
    grid-template-columns: 1.1fr 1fr;
    direction: rtl;
  }
  .rvhg-line-show--alt .rvhg-line-show__inner > * { direction: ltr; }
  .rvhg-line-show__copy h2 {
    font-size: var(--text-display);
    margin-top: 0.85rem;
  }
  .rvhg-line-show__tagline {
    margin-top: 0.85rem;
    font-size: clamp(1.15rem, 1vw + 0.85rem, 1.5rem);
    color: var(--color-ink);
    font-weight: 500;
    max-width: 26ch;
  }
  .rvhg-line-show__lede {
    margin-top: 1rem;
    color: var(--color-mute);
    max-width: 38ch;
  }
  .rvhg-line-show__copy a { margin-top: 1.5rem; }
  .rvhg-line-show__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-card);
  }
  @media (max-width: 768px) {
    .rvhg-line-show__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .rvhg-line-show:nth-of-type(even) .rvhg-line-show__inner { grid-template-columns: 1fr; direction: ltr; }
    .rvhg-line-show__media { order: -1; }
  }

  /* ---------- Story ---------- */
  .rvhg-home-story {
    text-align: center;
  }
  .rvhg-home-story h2 {
    font-size: var(--text-display);
    margin-top: 0.85rem;
    max-width: 24ch;
    margin-inline: auto;
  }
  .rvhg-home-story__lede {
    margin: 1.25rem auto 2rem;
    max-width: 52ch;
    color: var(--color-night-mute);
    font-size: clamp(1.05rem, 0.5vw + 1rem, 1.2rem);
  }

  /* ---------- Trust ---------- */
  .rvhg-home-trust h2 {
    font-size: var(--text-display);
    text-align: center;
    margin-bottom: 3rem;
    max-width: 22ch;
    margin-inline: auto;
  }
  .rvhg-home-trust ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--color-line-soft);
  }
  .rvhg-home-trust li {
    padding: 2rem 1.25rem;
    border-bottom: 1px solid var(--color-line-soft);
    border-right: 1px solid var(--color-line-soft);
    text-align: center;
  }
  .rvhg-home-trust li:nth-child(4n) { border-right: 0; }
  .rvhg-home-trust strong {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1vw + 1rem, 2rem);
    font-weight: 600;
    color: var(--color-ink);
    letter-spacing: -0.018em;
  }
  .rvhg-home-trust span {
    display: block;
    margin-top: 0.6rem;
    color: var(--color-mute);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  @media (max-width: 768px) {
    .rvhg-home-trust ul { grid-template-columns: repeat(2, 1fr); }
    .rvhg-home-trust li:nth-child(4n) { border-right: 1px solid var(--color-line-soft); }
    .rvhg-home-trust li:nth-child(2n) { border-right: 0; }
  }

  /* ---------- FAQ ---------- */
  .rvhg-home-faq h2 {
    font-size: var(--text-display);
    text-align: center;
    margin-bottom: 2rem;
  }
  .rvhg-home-faq__list {
    border-top: 1px solid var(--color-line);
  }
  .rvhg-home-faq details {
    border-bottom: 1px solid var(--color-line);
  }
  .rvhg-home-faq summary {
    cursor: pointer;
    list-style: none;
    padding: 1.25rem 0;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-ink);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .rvhg-home-faq summary::-webkit-details-marker { display: none; }
  .rvhg-home-faq summary::after {
    content: '+';
    color: var(--color-mute);
    font-weight: 300;
    font-size: 1.5rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }
  .rvhg-home-faq details[open] summary::after {
    transform: rotate(45deg);
  }
  .rvhg-home-faq p {
    padding: 0 0 1.5rem;
    color: var(--color-mute);
    line-height: 1.65;
  }

  /* ---------- CTA ---------- */
  .rvhg-home-cta {
    text-align: center;
    max-width: 44rem;
    margin-inline: auto;
  }
  .rvhg-home-cta h2 {
    font-size: var(--text-display);
  }
  .rvhg-home-cta p {
    margin-top: 1rem;
    color: var(--color-mute);
  }
  .rvhg-home-cta__buttons {
    margin-top: 2rem;
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
