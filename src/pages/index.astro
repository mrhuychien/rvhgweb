---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LegacyImg from '../components/LegacyImg.astro';
import Motion from '../components/Motion.astro';
import { SITE, REASONS, FEATURED, DISTRIBUTION_LOGOS, MEDIA_LOGOS, YEARS_EXPERIENCE } from '../data/site';
import { POWDERS, POWDER_SINGLES, assetUrl } from '../data/powders';

const lines = (await getCollection('productCategories')).sort((a, b) => a.data.order - b.data.order);

// New "bột đậu xanh" drinks for the home-page slider (4 flavours + the no-sugar pair).
const powderSlides = [
  ...POWDER_SINGLES.map((s) => ({
    href: `/${s}/`,
    image: POWDERS[s].image,
    name: POWDERS[s].name,
    tag: POWDERS[s].flavor,
    desc: POWDERS[s].tagline,
    accent: POWDERS[s].accent,
    accentInk: POWDERS[s].accentInk,
  })),
  {
    href: '/bdx-rauma-khongduong/',
    image: POWDERS['botdx-rauma-khongduong'].image,
    name: 'Không thêm đường',
    tag: 'Plant based',
    desc: 'Rau má & sữa dừa — thuần thực vật, đạm cao, loại bỏ hoàn toàn đường.',
    accent: '#3f7d4e',
    accentInk: '#2c5c39',
  },
];
---

<BaseLayout
  title="Bánh đậu xanh OCOP 5 sao Quốc gia"
  description={SITE.shortDescription}
>
  <!-- 1 · HERO — dark lacquer band + 3D imperial gold dust -->
  <section class="rvhg-hero3d rvhg-band-night">
    <canvas class="rvhg-hero3d__canvas" data-hero-dust aria-hidden="true"></canvas>
    <span class="rvhg-hero3d__glow" aria-hidden="true"></span>

    <div class="rvhg-container rvhg-hero3d__inner">
      <p class="rvhg-eyebrow rvhg-hero3d__lead">Rồng Vàng Hoàng Gia · Hải Dương từ 1997</p>
      <h1 class="rvhg-hero3d__title">
        Bánh đậu xanh đạt <span class="rvhg-hero3d__hl">OCOP 5 sao Quốc gia</span>
      </h1>
      <p class="rvhg-hero3d__sub">Chất lượng đỉnh cao được khẳng định.</p>
      <div class="gold-rule rvhg-rule--center"></div>
      <div class="rvhg-hero3d__ctas">
        <a class="rvhg-btn" href="/san-pham/">Khám phá sản phẩm</a>
        <a class="rvhg-btn--link" href="/gioi-thieu/">Câu chuyện thương hiệu  ›</a>
      </div>

      <figure class="rvhg-hero3d__showpiece rvhg-tilt" data-tilt>
        <LegacyImg
          src="/images/legacy/hero-home.jpg"
          alt="Bánh đậu xanh Rồng Vàng Hoàng Gia"
          width={2400}
          height={1350}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="rvhg-hero3d__seal">OCOP 5★ Quốc gia</figcaption>
      </figure>

      <ul class="rvhg-hero3d__stats">
        <li><span class="rvhg-countup" data-countup={YEARS_EXPERIENCE} data-years-since="1997">{YEARS_EXPERIENCE}</span><small>Năm kinh nghiệm</small></li>
        <li><span>5★</span><small>OCOP Quốc gia</small></li>
        <li><span class="rvhg-countup" data-countup="6">6</span><small>Thị trường xuất khẩu</small></li>
        <li><span>ISO</span><small>22000:2018</small></li>
      </ul>
    </div>
  </section>

  <!-- 2 · BÍ QUYẾT THÀNH CÔNG -->
  <section class="rvhg-section rvhg-band-soft">
    <div class="rvhg-container">
      <header class="rvhg-home-reasons__head" data-reveal>
        <p class="rvhg-eyebrow">Bí quyết thành công</p>
        <h2>Rồng Vàng Hoàng Gia.</h2>
        <div class="gold-rule rvhg-rule--center gold-rule--draw"></div>
        <p>Giữa hàng chục thương hiệu bánh đậu xanh trên thị trường, điều gì đã làm nên sự độc đáo và thành công của thương hiệu Rồng Vàng Hoàng Gia.</p>
      </header>
      <ul class="rvhg-home-reasons">
        {REASONS.map((r, i) => (
          <li data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <h3 set:html={r.title}></h3>
            <p set:html={r.body}></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3 · SẢN PHẨM CAO CẤP -->
  <section class="rvhg-section">
    <div class="rvhg-container">
      <header class="rvhg-home-feat__head" data-reveal>
        <p class="rvhg-eyebrow">Sản phẩm cao cấp</p>
        <h2>Tinh tuý từ Rồng Vàng Hoàng Gia.</h2>
        <div class="gold-rule rvhg-rule--center gold-rule--draw"></div>
        <p>Hãy khám phá những sản phẩm cao cấp nhất từ Rồng Vàng Hoàng Gia.</p>
        <a class="rvhg-btn--link" href="/san-pham/">Xem toàn bộ sản phẩm  ›</a>
      </header>
      <div class="rvhg-home-feat">
        {FEATURED.map((p, i) => (
          <a class="rvhg-feat rvhg-tilt" href={p.href} data-tilt data-reveal style={`--reveal-delay:${(i % 4) * 80}ms`}>
            <span class="rvhg-feat__media">
              <LegacyImg src={p.image} alt={p.name} width={600} height={600} loading={i < 4 ? 'eager' : 'lazy'} />
            </span>
            <span class="rvhg-feat__name">{p.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3.5 · BỘT ĐẬU XANH PHA SẴN — slider -->
  <section class="rvhg-section rvhg-band-soft">
    <div class="rvhg-container">
      <header class="rvhg-home-slider__head" data-reveal>
        <p class="rvhg-eyebrow">Mới ra mắt</p>
        <h2>Bột đậu xanh — thức uống pha sẵn.</h2>
        <div class="gold-rule rvhg-rule--center gold-rule--draw"></div>
        <p>Đậu xanh lòng vàng Hải Dương phối cùng cà rốt, rau má, sữa dừa, matcha — và dòng không thêm đường thuần thực vật.</p>
      </header>

      <div class="rvhg-slider" data-slider data-reveal>
        <button class="rvhg-slider__arrow rvhg-slider__arrow--prev" type="button" aria-label="Xem trước" data-slider-prev>‹</button>
        <ul class="rvhg-slider__track" data-slider-track>
          {powderSlides.map((s) => (
            <li class="rvhg-slide" style={`--pa:${s.accent};--pa-ink:${s.accentInk}`}>
              <a href={s.href}>
                <span class="rvhg-slide__media">
                  <LegacyImg src={assetUrl(s.image)} alt={s.name} width={640} height={640} loading="eager" />
                </span>
                <span class="rvhg-slide__body">
                  <span class="rvhg-slide__tag">{s.tag}</span>
                  <span class="rvhg-slide__name">{s.name}</span>
                  <span class="rvhg-slide__desc">{s.desc}</span>
                  <span class="rvhg-slide__go" aria-hidden="true">Xem chi tiết  ›</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <button class="rvhg-slider__arrow rvhg-slider__arrow--next" type="button" aria-label="Xem tiếp" data-slider-next>›</button>
        <div class="rvhg-slider__dots" data-slider-dots aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- 4 · DANH MỤC SẢN PHẨM -->
  <section class="rvhg-section rvhg-band-soft">
    <div class="rvhg-container">
      <header class="rvhg-cats__head" data-reveal>
        <p class="rvhg-eyebrow">Danh mục sản phẩm</p>
        <h2>Năm dòng sản phẩm.</h2>
        <div class="gold-rule rvhg-rule--center gold-rule--draw"></div>
      </header>
      <div class="rvhg-cats">
        {lines.map((line, i) => (
          <a
            class={`rvhg-cat rvhg-tilt ${i < 2 ? 'rvhg-cat--lg' : ''}`}
            href={`/danh-muc-san-pham/${line.id}/`}
            data-tilt
            data-reveal={i < 2 ? 'zoom' : true}
            style={`--reveal-delay:${i * 70}ms`}
          >
            <LegacyImg
              src={line.data.cardImage ?? line.data.heroImage ?? ''}
              alt={line.data.title}
              width={1024}
              height={683}
              loading={i < 2 ? 'eager' : 'lazy'}
              style={`object-position: ${line.data.cardImagePos ?? 'center'}`}
            />
            <span class="rvhg-cat__scrim" aria-hidden="true"></span>
            <h3 class="rvhg-cat__title">{line.data.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 5 · HỆ THỐNG PHÂN PHỐI -->
  <section class="rvhg-section">
    <div class="rvhg-container">
      <header class="rvhg-home-logos__head" data-reveal>
        <p class="rvhg-eyebrow">Hệ thống phân phối</p>
        <h2>Có mặt khắp toàn quốc.</h2>
        <div class="gold-rule rvhg-rule--center gold-rule--draw"></div>
        <p>Sản phẩm Rồng Vàng Hoàng Gia có mặt trên các chuỗi đại siêu thị, cửa hàng tạp hoá, sân bay, khu du lịch, trạm dừng nghỉ… và các sàn thương mại điện tử Shopee, TikTok Shop.</p>
      </header>
      <ul class="rvhg-logos rvhg-logos--dist" data-reveal>
        {DISTRIBUTION_LOGOS.map((d) => (
          <li><img src={d.image} alt={d.name} loading="lazy" decoding="async" /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6 · TRÊN TRUYỀN THÔNG -->
  <section class="rvhg-section rvhg-band-soft">
    <div class="rvhg-container">
      <header class="rvhg-home-logos__head" data-reveal>
        <p class="rvhg-eyebrow">Trên truyền thông</p>
        <h2>Báo chí nói về chúng tôi.</h2>
        <div class="gold-rule rvhg-rule--center gold-rule--draw"></div>
        <p>Xem thêm thông tin về Rồng Vàng Hoàng Gia trên các cơ quan thông tấn báo chí chính thống.</p>
      </header>
      <ul class="rvhg-logos rvhg-logos--media" data-reveal>
        {MEDIA_LOGOS.map((m) => (
          <li>
            {m.url ? (
              <a href={m.url} target="_blank" rel="noopener noreferrer" aria-label={m.name}>
                <img src={m.image} alt={m.name} loading="lazy" decoding="async" />
              </a>
            ) : (
              <img src={m.image} alt={m.name} loading="lazy" decoding="async" />
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Motion />
</BaseLayout>

<style>
  /* ---------- 1 · Hero — dark lacquer + 3D gold dust ---------- */
  .rvhg-hero3d {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    text-align: center;
    /* flows seamlessly out of the oxblood header */
    /* #8B0000 + vignette mềm ở rìa/đáy → chiều sâu sang trọng.
       Vùng trên trong suốt nên nối liền mạch với header. */
    background:
      radial-gradient(125% 115% at 50% -10%, rgb(72 0 0 / 0) 38%, rgb(72 0 0 / 0.55) 100%),
      #8b0000;
    padding-block: clamp(3.25rem, 7vw, 6.5rem) clamp(3rem, 6vw, 5.5rem);
  }
  .rvhg-hero3d__canvas,
  .rvhg-hero3d__glow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
  /* warm halo behind the headline — also the full fallback when JS/WebGL is off */
  .rvhg-hero3d__glow {
    background: radial-gradient(58% 48% at 50% 24%, rgba(176, 141, 87, 0.32), transparent 70%);
  }
  .rvhg-hero3d__inner { position: relative; }

  .rvhg-hero3d__lead { color: var(--color-brass-300, #d8c29a); }
  .rvhg-hero3d__title {
    margin: 0.7rem auto 0;
    max-width: 17ch;
    font-size: var(--text-headline);
    color: #fbf8f1;
  }
  .rvhg-hero3d__hl { color: var(--color-brass-300, #d8c29a); }
  .rvhg-hero3d__sub {
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.2rem, 1.5vw + 1rem, 1.95rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-brass-300, #d8c29a);
  }
  .rvhg-hero3d__ctas {
    margin-top: 1.5rem;
    display: flex;
    gap: 1rem 1.75rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
  }

  /* product showpiece — framed, lifted, brass hairline */
  .rvhg-hero3d__showpiece {
    position: relative;
    margin: clamp(2.5rem, 5vw, 3.75rem) auto 0;
    max-width: 60rem;
    border-radius: var(--radius-lg, 8px);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--brass) 50%, transparent);
    box-shadow: 0 32px 80px -34px rgba(0, 0, 0, 0.75);
  }
  .rvhg-hero3d__showpiece :global(img) {
    width: 100%;
    height: clamp(16rem, 44vw, 30rem);
    object-fit: cover;
    display: block;
  }
  .rvhg-hero3d__seal {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--color-seal-600, #8f2b22);
    color: var(--color-paper-50, #fbf8f1);
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius-sm, 2px);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
  }

  /* trust stats strip */
  .rvhg-hero3d__stats {
    list-style: none;
    max-width: 46rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
    padding: 1.6rem 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--brass) 30%, transparent);
  }
  .rvhg-hero3d__stats li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .rvhg-hero3d__stats span {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1;
    color: var(--color-brass-300, #d8c29a);
  }
  .rvhg-hero3d__stats small {
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-night-mute, #cbbba0);
  }
  @media (max-width: 640px) {
    .rvhg-hero3d__stats { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; }
  }

  /* ---------- shared section heads ---------- */
  .rvhg-home-reasons__head,
  .rvhg-home-feat__head,
  .rvhg-cats__head,
  .rvhg-home-logos__head {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 3rem;
  }
  .rvhg-home-reasons__head h2,
  .rvhg-home-feat__head h2,
  .rvhg-cats__head h2,
  .rvhg-home-logos__head h2 {
    font-size: var(--text-display);
    margin-top: 0.6rem;
  }
  .rvhg-home-reasons__head > p,
  .rvhg-home-feat__head > p,
  .rvhg-home-logos__head > p {
    margin-top: 1rem;
    color: var(--color-mute);
  }
  .rvhg-home-feat__head a { display: inline-block; margin-top: 1rem; }

  /* ---------- 2 · Bí quyết thành công ---------- */
  .rvhg-home-reasons {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-line-soft);
  }
  .rvhg-home-reasons li {
    padding: 2.25rem 1.5rem;
    border-bottom: 1px solid var(--color-line-soft);
    border-right: 1px solid var(--color-line-soft);
  }
  .rvhg-home-reasons li:nth-child(3n) { border-right: 0; }
  .rvhg-home-reasons h3 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    margin-bottom: 0.6rem;
  }
  .rvhg-home-reasons p {
    color: var(--color-mute);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  @media (max-width: 900px) {
    .rvhg-home-reasons { grid-template-columns: repeat(2, 1fr); }
    .rvhg-home-reasons li:nth-child(3n) { border-right: 1px solid var(--color-line-soft); }
    .rvhg-home-reasons li:nth-child(2n) { border-right: 0; }
  }
  @media (max-width: 560px) {
    .rvhg-home-reasons { grid-template-columns: 1fr; }
    .rvhg-home-reasons li,
    .rvhg-home-reasons li:nth-child(2n),
    .rvhg-home-reasons li:nth-child(3n) { border-right: 0; }
  }

  /* ---------- 3 · Sản phẩm cao cấp ---------- */
  .rvhg-home-feat {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem 1.5rem;
  }
  .rvhg-feat {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
  }
  .rvhg-feat__media {
    aspect-ratio: 1 / 1;
    background: var(--color-paper-tint);
    border-radius: var(--radius-lg, 8px);
    overflow: hidden;
  }
  .rvhg-feat__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-refined, ease);
  }
  .rvhg-feat:hover .rvhg-feat__media :global(img) { transform: scale(1.04); }
  .rvhg-feat__name {
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-ink);
  }
  @media (max-width: 1024px) { .rvhg-home-feat { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 768px)  { .rvhg-home-feat { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; } }

  /* ---------- 4 · Danh mục sản phẩm — bento ---------- */
  .rvhg-cats {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;
  }
  .rvhg-cat {
    position: relative;
    display: block;
    grid-column: span 2;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg, 8px);
    overflow: hidden;
    text-decoration: none;
    background: var(--color-paper-tint);
  }
  .rvhg-cat--lg { grid-column: span 3; aspect-ratio: 16 / 10; }
  .rvhg-cat :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-refined, ease);
  }
  .rvhg-cat:hover :global(img) { transform: scale(1.04); }
  .rvhg-cat__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(42, 12, 14, 0.8) 0%, rgba(42, 12, 14, 0.25) 34%, transparent 62%);
  }
  .rvhg-cat__title {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 1.25rem;
    margin: 0;
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(1.1rem, 1vw + 0.7rem, 1.6rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
    text-shadow: 0 1px 14px rgba(42, 12, 14, 0.55);
  }
  @media (max-width: 768px) {
    .rvhg-cats { grid-template-columns: repeat(2, 1fr); gap: 0.85rem; }
    .rvhg-cat, .rvhg-cat--lg { grid-column: span 1; aspect-ratio: 4 / 3; }
    .rvhg-cat--lg:first-child { grid-column: span 2; aspect-ratio: 16 / 10; }
    .rvhg-cat__title { left: 1rem; right: 1rem; bottom: 1rem; font-size: 1.05rem; }
  }
  @media (max-width: 460px) {
    .rvhg-cats { grid-template-columns: 1fr; }
    .rvhg-cat, .rvhg-cat--lg, .rvhg-cat--lg:first-child { grid-column: span 1; aspect-ratio: 3 / 2; }
  }

  /* ---------- 3.5 · Powder slider ---------- */
  .rvhg-home-slider__head {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 3rem;
  }
  .rvhg-home-slider__head h2 { font-size: var(--text-display); margin-top: 0.6rem; }
  .rvhg-home-slider__head > p { margin-top: 1rem; color: var(--color-mute); }

  .rvhg-slider { position: relative; }
  .rvhg-slider__track {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0.5rem 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .rvhg-slider__track::-webkit-scrollbar { display: none; }
  .rvhg-slide {
    flex: 0 0 calc((100% - 3rem) / 3);
    scroll-snap-align: start;
    --pa: var(--brass);
    --pa-ink: var(--color-brass-700, #7a6234);
  }
  .rvhg-slide > a {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: var(--color-ink);
    background: var(--color-card, #fff);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg, 8px);
    overflow: hidden;
    transition: box-shadow 0.3s var(--ease-refined, ease), transform 0.3s var(--ease-refined, ease);
  }
  .rvhg-slide > a:hover { box-shadow: var(--shadow-lift); transform: translateY(-3px); }
  .rvhg-slide__media {
    aspect-ratio: 4 / 3;
