---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LegacyImg from '../components/LegacyImg.astro';
import { SITE, REASONS, FEATURED, DISTRIBUTION_LOGOS, MEDIA_LOGOS } from '../data/site';

const lines = (await getCollection('productCategories')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={SITE.name} description={SITE.shortDescription}>
  <!-- 1 · HERO -->
  <section class="rvhg-home-hero">
    <div class="rvhg-container">
      <p class="rvhg-eyebrow">Rồng Vàng Hoàng Gia</p>
      <h1>Bánh đậu xanh đạt OCOP 5 sao Quốc gia.</h1>
      <p class="rvhg-home-hero__sub">Chất lượng đỉnh cao được khẳng định.</p>
      <div class="gold-rule rvhg-rule--center"></div>
      <div class="rvhg-home-hero__ctas">
        <a class="rvhg-btn--link" href="/gioi-thieu/">Tìm hiểu thêm  ›</a>
      </div>
    </div>
    <div class="rvhg-home-hero__media">
      <LegacyImg src="/images/legacy/hero-home.jpg" alt="Bánh đậu xanh Rồng Vàng Hoàng Gia" width={2400} height={1350} loading="eager" fetchpriority="high" />
    </div>
  </section>

  <!-- 2 · BÍ QUYẾT THÀNH CÔNG -->
  <section class="rvhg-section rvhg-band-soft">
    <div class="rvhg-container">
      <header class="rvhg-home-reasons__head">
        <p class="rvhg-eyebrow">Bí quyết thành công</p>
        <h2>Rồng Vàng Hoàng Gia.</h2>
        <div class="gold-rule rvhg-rule--center"></div>
        <p>Giữa hàng chục thương hiệu bánh đậu xanh trên thị trường, điều gì đã làm nên sự độc đáo và thành công của thương hiệu Rồng Vàng Hoàng Gia.</p>
      </header>
      <ul class="rvhg-home-reasons">
        {REASONS.map((r) => (
          <li>
            <h3>{r.title}</h3>
            <p>{r.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3 · SẢN PHẨM CAO CẤP -->
  <section class="rvhg-section">
    <div class="rvhg-container">
      <header class="rvhg-home-feat__head">
        <p class="rvhg-eyebrow">Sản phẩm cao cấp</p>
        <h2>Tinh tuý từ Rồng Vàng Hoàng Gia.</h2>
        <div class="gold-rule rvhg-rule--center"></div>
        <p>Hãy khám phá những sản phẩm cao cấp nhất từ Rồng Vàng Hoàng Gia.</p>
        <a class="rvhg-btn--link" href="/san-pham/">Xem toàn bộ sản phẩm  ›</a>
      </header>
      <div class="rvhg-home-feat">
        {FEATURED.map((p, i) => (
          <a class="rvhg-feat" href={p.href}>
            <span class="rvhg-feat__media">
              <LegacyImg src={p.image} alt={p.name} width={600} height={600} loading={i < 4 ? 'eager' : 'lazy'} />
            </span>
            <span class="rvhg-feat__name">{p.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4 · DANH MỤC SẢN PHẨM -->
  <section class="rvhg-section rvhg-band-soft">
    <div class="rvhg-container">
      <header class="rvhg-cats__head">
        <p class="rvhg-eyebrow">Danh mục sản phẩm</p>
        <h2>Năm dòng sản phẩm.</h2>
        <div class="gold-rule rvhg-rule--center"></div>
      </header>
      <div class="rvhg-cats">
        {lines.map((line, i) => (
          <a class={`rvhg-cat ${i < 2 ? 'rvhg-cat--lg' : ''}`} href={`/danh-muc-san-pham/${line.id}/`}>
            <LegacyImg
              src={line.data.cardImage ?? line.data.heroImage ?? ''}
              alt={line.data.title}
              width={1024}
              height={683}
              loading={i < 2 ? 'eager' : 'lazy'}
              style={`object-position: ${line.data.cardImagePos ?? 'center'}`}
            />
            <span class="rvhg-cat__scrim" aria-hidden="true"></span>
            <h3 class="rvhg-cat__title">{line.data.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 5 · HỆ THỐNG PHÂN PHỐI -->
  <section class="rvhg-section">
    <div class="rvhg-container">
      <header class="rvhg-home-logos__head">
        <p class="rvhg-eyebrow">Hệ thống phân phối</p>
        <h2>Có mặt khắp toàn quốc.</h2>
        <div class="gold-rule rvhg-rule--center"></div>
        <p>Sản phẩm Rồng Vàng Hoàng Gia có mặt trên các chuỗi đại siêu thị, cửa hàng tạp hoá, sân bay, khu du lịch, trạm dừng nghỉ… và các sàn thương mại điện tử Shopee, TikTok Shop.</p>
      </header>
      <ul class="rvhg-logos rvhg-logos--dist">
        {DISTRIBUTION_LOGOS.map((d) => (
          <li><img src={d.image} alt={d.name} loading="lazy" decoding="async" /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6 · TRÊN TRUYỀN THÔNG -->
  <section class="rvhg-section rvhg-band-soft">
    <div class="rvhg-container">
      <header class="rvhg-home-logos__head">
        <p class="rvhg-eyebrow">Trên truyền thông</p>
        <h2>Báo chí nói về chúng tôi.</h2>
        <div class="gold-rule rvhg-rule--center"></div>
        <p>Xem thêm thông tin về Rồng Vàng Hoàng Gia trên các cơ quan thông tấn báo chí chính thống.</p>
      </header>
      <ul class="rvhg-logos rvhg-logos--media">
        {MEDIA_LOGOS.map((m) => (
          <li>
            {m.url ? (
              <a href={m.url} target="_blank" rel="noopener noreferrer" aria-label={m.name}>
                <img src={m.image} alt={m.name} loading="lazy" decoding="async" />
              </a>
            ) : (
              <img src={m.image} alt={m.name} loading="lazy" decoding="async" />
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- 1 · Hero ---------- */
  .rvhg-home-hero {
    text-align: center;
    padding-top: 3rem;
    padding-bottom: 0;
  }
  @media (min-width: 768px) {
    .rvhg-home-hero { padding-top: 6.5rem; }
  }
  .rvhg-home-hero h1 {
    margin-top: 0.6rem;
    font-size: var(--text-headline);
    max-width: 18ch;
    margin-inline: auto;
  }
  .rvhg-home-hero__sub {
    margin-top: 0.8rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.25rem, 1.5vw + 1rem, 2rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-brass-700, #7a6234);
  }
  .rvhg-home-hero__ctas {
    margin-top: 1.25rem;
    display: flex;
    gap: 2rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .rvhg-home-hero__media {
    margin-top: 3rem;
    width: 100%;
  }
  .rvhg-home-hero__media :global(img) {
    width: 100%;
    height: clamp(18rem, 52vw, 34rem);
    object-fit: cover;
    display: block;
  }

  /* ---------- shared section heads ---------- */
  .rvhg-home-reasons__head,
  .rvhg-home-feat__head,
  .rvhg-cats__head,
  .rvhg-home-logos__head {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 3rem;
  }
  .rvhg-home-reasons__head h2,
  .rvhg-home-feat__head h2,
  .rvhg-cats__head h2,
  .rvhg-home-logos__head h2 {
    font-size: var(--text-display);
    margin-top: 0.6rem;
  }
  .rvhg-home-reasons__head > p,
  .rvhg-home-feat__head > p,
  .rvhg-home-logos__head > p {
    margin-top: 1rem;
    color: var(--color-mute);
  }
  .rvhg-home-feat__head a { display: inline-block; margin-top: 1rem; }

  /* ---------- 2 · Bí quyết thành công ---------- */
  .rvhg-home-reasons {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-line-soft);
  }
  .rvhg-home-reasons li {
    padding: 2.25rem 1.5rem;
    border-bottom: 1px solid var(--color-line-soft);
    border-right: 1px solid var(--color-line-soft);
  }
  .rvhg-home-reasons li:nth-child(3n) { border-right: 0; }
  .rvhg-home-reasons h3 {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    margin-bottom: 0.6rem;
  }
  .rvhg-home-reasons p {
    color: var(--color-mute);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  @media (max-width: 900px) {
    .rvhg-home-reasons { grid-template-columns: repeat(2, 1fr); }
    .rvhg-home-reasons li:nth-child(3n) { border-right: 1px solid var(--color-line-soft); }
    .rvhg-home-reasons li:nth-child(2n) { border-right: 0; }
  }
  @media (max-width: 560px) {
    .rvhg-home-reasons { grid-template-columns: 1fr; }
    .rvhg-home-reasons li,
    .rvhg-home-reasons li:nth-child(2n),
    .rvhg-home-reasons li:nth-child(3n) { border-right: 0; }
  }

  /* ---------- 3 · Sản phẩm cao cấp ---------- */
  .rvhg-home-feat {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem 1.5rem;
  }
  .rvhg-feat {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
  }
  .rvhg-feat__media {
    aspect-ratio: 1 / 1;
    background: var(--color-paper-tint);
    border-radius: var(--radius-lg, 8px);
    overflow: hidden;
  }
  .rvhg-feat__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-refined, ease);
  }
  .rvhg-feat:hover .rvhg-feat__media :global(img) { transform: scale(1.04); }
  .rvhg-feat__name {
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-ink);
  }
  @media (max-width: 1024px) { .rvhg-home-feat { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 768px)  { .rvhg-home-feat { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; } }

  /* ---------- 4 · Danh mục sản phẩm — bento ---------- */
  .rvhg-cats {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;
  }
  .rvhg-cat {
    position: relative;
    display: block;
    grid-column: span 2;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg, 8px);
    overflow: hidden;
    text-decoration: none;
    background: var(--color-paper-tint);
  }
  .rvhg-cat--lg { grid-column: span 3; aspect-ratio: 16 / 10; }
  .rvhg-cat :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-refined, ease);
  }
  .rvhg-cat:hover :global(img) { transform: scale(1.04); }
  .rvhg-cat__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(42, 12, 14, 0.8) 0%, rgba(42, 12, 14, 0.25) 34%, transparent 62%);
  }
  .rvhg-cat__title {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 1.25rem;
    margin: 0;
    color: #fff;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(1.1rem, 1vw + 0.7rem, 1.6rem);
    line-height: 1.2;
    letter-spacing: -0.005em;
    text-shadow: 0 1px 14px rgba(42, 12, 14, 0.55);
  }
  @media (max-width: 768px) {
    .rvhg-cats { grid-template-columns: repeat(2, 1fr); gap: 0.85rem; }
    .rvhg-cat, .rvhg-cat--lg { grid-column: span 1; aspect-ratio: 4 / 3; }
    .rvhg-cat--lg:first-child { grid-column: span 2; aspect-ratio: 16 / 10; }
    .rvhg-cat__title { left: 1rem; right: 1rem; bottom: 1rem; font-size: 1.05rem; }
  }
  @media (max-width: 460px) {
    .rvhg-cats { grid-template-columns: 1fr; }
    .rvhg-cat, .rvhg-cat--lg, .rvhg-cat--lg:first-child { grid-column: span 1; aspect-ratio: 3 / 2; }
  }

  /* ---------- 5 & 6 · Logo walls ---------- */
  .rvhg-logos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    align-items: center;
    justify-items: center;
    gap: 2rem 1.5rem;
  }
  .rvhg-logos--dist { grid-template-columns: repeat(4, 1fr); }
  .rvhg-logos--media { grid-template-columns: repeat(5, 1fr); }
  .rvhg-logos img {
    max-width: 100%;
    max-height: 64px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition: filter 0.25s var(--ease-refined, ease), opacity 0.25s var(--ease-refined, ease);
  }
  .rvhg-logos li:hover img,
  .rvhg-logos a:hover img { filter: grayscale(0); opacity: 1; }
  .rvhg-logos--media img { max-height: 56px; border-radius: 4px; }
  @media (max-width: 768px) {
    .rvhg-logos--dist { grid-template-columns: repeat(3, 1fr); }
    .rvhg-logos--media { grid-template-columns: repeat(4, 1fr); }
    .rvhg-logos img { max-height: 52px; }
  }
  @media (max-width: 460px) {
    .rvhg-logos--dist { grid-template-columns: repeat(2, 1fr); }
    .rvhg-logos--media { grid-template-columns: repeat(3, 1fr); }
  }
</style>
