---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const policies = (await getCollection('policies')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'vi'));
---

<BaseLayout
  title="Công bố — Rồng Vàng Hoàng Gia"
  description="Hồ sơ tự công bố sản phẩm, chứng nhận và phiếu kiểm nghiệm định kỳ của Công ty Cổ phần Hoàng Giang — thương hiệu Rồng Vàng Hoàng Gia."
  canonical="/cong-bo/"
  noindex={true}
>
  <section class="rvhg-pub-hero">
    <div class="rvhg-container">
      <p class="rvhg-eyebrow">Công bố</p>
      <h1>Minh bạch.</h1>
      <p class="rvhg-pub-hero__lede">Hồ sơ tự công bố các sản phẩm đang lưu hành, chứng nhận pháp lý và phiếu kiểm nghiệm định kỳ.</p>
    </div>
  </section>

  <!-- Three pillars (mirror cong-bo page sections) -->
  <section class="rvhg-section rvhg-band-soft">
    <div class="rvhg-container">
      <div class="rvhg-pub-pillars">
        <article>
          <h2>Hồ sơ tự công bố</h2>
          <p>Hồ sơ tự công bố các sản phẩm đang lưu hành của Rồng Vàng Hoàng Gia theo quy định của pháp luật — Nghị định 15/2018/NĐ-CP.</p>
          <a class="rvhg-btn--link" href="/ban-tu-cong-bo-rong-vang-hoang-gia/">Xem ngay  ›</a>
        </article>
        <article>
          <h2>Phiếu kiểm nghiệm định kỳ</h2>
          <p>Kết quả kiểm nghiệm định kỳ các sản phẩm của Rồng Vàng Hoàng Gia tại các đơn vị kiểm nghiệm được chỉ định.</p>
          <a class="rvhg-btn--link" href="mailto:info@rongvanghoanggia.com">Yêu cầu bản sao  ›</a>
        </article>
        <article>
          <h2>Thư viện hình ảnh, video</h2>
          <p>Kho lưu trữ thư viện hình ảnh, video về Rồng Vàng Hoàng Gia phục vụ báo chí, đối tác và đại lý.</p>
          <a class="rvhg-btn--link" href={'https://www.facebook.com/rongvanghoanggiapage'} target="_blank" rel="noopener noreferrer">Truy cập Fanpage  ›</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="rvhg-section">
    <div class="rvhg-container">
      <p class="rvhg-eyebrow">Chứng nhận & pháp lý</p>
      <div class="rvhg-pub-cert-grid">
        <article>
          <h2>OCOP 5 sao Quốc gia 2024</h2>
          <p>Bánh đậu xanh Rồng Vàng Hoàng Gia là sản phẩm bánh đậu xanh đầu tiên và duy nhất cả nước đạt phân hạng 5 sao Quốc gia trong Chương trình "Mỗi xã một sản phẩm".</p>
        </article>
        <article>
          <h2>ISO 22000:2018</h2>
          <p>Hệ thống quản lý an toàn thực phẩm theo tiêu chuẩn quốc tế — số HA 394/4.26.CIV, hiệu lực từ 08/08/2026 đến 07/08/2029, do Trung tâm Chứng nhận Phù hợp (QUACERT) cấp. Phạm vi: sản xuất bánh đậu xanh, bột đậu uống liền.</p>
          <a class="rvhg-cert-doc" href="/cong-bo/giay-chung-nhan-iso-22000-2026.pdf" target="_blank" rel="noopener noreferrer">
            <img src="/images/chung-nhan/iso-22000-2026.jpg" alt="Giấy chứng nhận ISO 22000:2018 của Công ty Cổ phần Hoàng Giang — QUACERT" width="1000" height="1414" loading="lazy" />
            <span>Tải giấy chứng nhận ISO (PDF)  ›</span>
          </a>
        </article>
        <article>
          <h2>Giấy chứng nhận đăng ký doanh nghiệp</h2>
          <p>Công ty Cổ phần Hoàng Giang — mã số doanh nghiệp 0800280839, vốn điều lệ 60 tỷ đồng. Đăng ký lần đầu 06/06/2003; đăng ký thay đổi lần thứ 8 ngày 21/07/2026 (Sở Tài chính TP Hải Phòng).</p>
          <a class="rvhg-cert-doc" href="/cong-bo/giay-chung-nhan-dang-ky-kinh-doanh-2026.pdf" target="_blank" rel="noopener noreferrer">
            <img src="/images/chung-nhan/dang-ky-kinh-doanh-2026.jpg" alt="Giấy chứng nhận đăng ký doanh nghiệp — Công ty Cổ phần Hoàng Giang" width="1000" height="1414" loading="lazy" />
            <span>Tải giấy đăng ký kinh doanh (PDF)  ›</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Policy list -->
  <section class="rvhg-section rvhg-band-soft">
    <div class="rvhg-container">
      <p class="rvhg-eyebrow">Tự công bố &amp; chính sách</p>
      <h2 class="rvhg-pub-list-head">Tài liệu công khai.</h2>
      <ul class="rvhg-pub-list">
        {policies.map((p) => (
          <li>
            <a href={`/${p.id}/`}>
              <span class="rvhg-pub-list__title">{p.data.title}</span>
              {p.data.description && <span class="rvhg-pub-list__desc">{p.data.description}</span>}
              <span class="rvhg-pub-list__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="rvhg-pub-list__note">
        Cần bản sao hồ sơ tự công bố, phiếu kiểm nghiệm hoặc giấy chứng nhận, vui lòng liên hệ
        <a href="mailto:info@rongvanghoanggia.com">info@rongvanghoanggia.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .rvhg-pub-hero {
    text-align: center;
    padding-block: 3.5rem 2.5rem;
  }
  @media (min-width: 768px) { .rvhg-pub-hero { padding-block: 7rem 4rem; } }
  .rvhg-pub-hero h1 {
    margin-top: 0.6rem;
    font-size: var(--text-headline);
  }
  .rvhg-pub-hero__lede {
    margin: 1.25rem auto 0;
    color: var(--color-mute);
    font-size: clamp(1rem, 0.5vw + 0.95rem, 1.2rem);
    max-width: 38rem;
  }

  .rvhg-pub-pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
  .rvhg-pub-pillars article {
    border-top: 1px solid var(--color-line);
    padding-top: 1.5rem;
  }
  .rvhg-pub-pillars h2 {
    font-size: 1.4rem;
    letter-spacing: -0.012em;
  }
  .rvhg-pub-pillars p {
    margin-top: 0.85rem;
    color: var(--color-mute);
    font-size: 0.975rem;
  }
  .rvhg-pub-pillars a { display: inline-block; margin-top: 1rem; }
  @media (max-width: 768px) {
    .rvhg-pub-pillars { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  .rvhg-pub-cert-grid {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 2.5rem;
  }
  .rvhg-pub-cert-grid article {
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
  }
  .rvhg-pub-cert-grid h2 {
    font-size: 1.5rem;
    letter-spacing: -0.014em;
  }
  .rvhg-pub-cert-grid p {
    margin-top: 0.85rem;
    color: var(--color-mute);
  }
  /* Document thumbnail + download link (ISO / business-registration certificates) */
  .rvhg-cert-doc {
    display: block;
    margin-top: 1.1rem;
    text-decoration: none;
  }
  .rvhg-cert-doc img {
    width: 100%;
    max-width: 240px;
    height: auto;
    display: block;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md, 4px);
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }
  .rvhg-cert-doc:hover img { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  .rvhg-cert-doc span {
    display: inline-block;
    margin-top: 0.7rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-rvhg-gold-dark, #7a6234);
  }
  @media (max-width: 768px) {
    .rvhg-pub-cert-grid { gap: 1.75rem; }
  }

  .rvhg-pub-list-head {
    font-size: var(--text-display);
    margin-block: 0.85rem 2rem;
  }
  .rvhg-pub-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-line);
  }
  .rvhg-pub-list li { border-bottom: 1px solid var(--color-line); }
  .rvhg-pub-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1rem;
    padding: 1.25rem 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: padding 0.18s ease;
  }
  .rvhg-pub-list a:hover { padding-inline-start: 1rem; }
  .rvhg-pub-list__title {
    font-weight: 500;
    color: var(--color-ink);
    font-size: 1.05rem;
  }
  .rvhg-pub-list__desc {
    grid-column: 1;
    margin-top: 0.35rem;
    font-size: 0.9rem;
    color: var(--color-mute);
  }
  .rvhg-pub-list__arrow {
    grid-row: 1 / -1;
    align-self: center;
    color: var(--color-mute);
    font-size: 1.25rem;
  }
  .rvhg-pub-list__note {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--color-mute);
  }
  .rvhg-pub-list__note a {
    color: var(--color-link);
    text-decoration: none;
    margin-left: 0.25rem;
  }
  .rvhg-pub-list__note a:hover { text-decoration: underline; }
</style>
