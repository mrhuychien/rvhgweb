---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const policies = (await getCollection('policies')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'vi'));
---

<BaseLayout
  title="Công bố & chính sách"
  description="Bản tự công bố sản phẩm, chứng nhận và các chính sách của Công ty Cổ phần Hoàng Giang — thương hiệu Rồng Vàng Hoàng Gia."
  canonical="/cong-bo/"
  noindex={true}
>
  <section class="rvhg-container rvhg-pub">
    <Breadcrumbs items={[{ name: 'Công bố', url: '/cong-bo/' }]} />
    <h1>Công bố &amp; chính sách</h1>
    <p class="rvhg-pub__lede">Minh bạch thông tin pháp lý, chứng nhận và chính sách dành cho khách hàng, đối tác.</p>

    <h2>Chứng nhận</h2>
    <ul class="rvhg-pub__certs">
      <li><strong>OCOP 5 sao Quốc gia 2024</strong> — bánh đậu xanh đầu tiên và duy nhất đạt hạng sao cao nhất.</li>
      <li><strong>ISO 22000:2018</strong> — HA 394/2.23.CIV, Quacert cấp ngày 08/08/2023.</li>
    </ul>

    <h2>Tự công bố &amp; chính sách</h2>
    <ul class="rvhg-pub__links">
      {policies.map((p) => (
        <li>
          <a href={`/${p.id}/`}>{p.data.title}</a>
          {p.data.description && <span>{p.data.description}</span>}
        </li>
      ))}
    </ul>

    <p class="rvhg-pub__note">Cần bản sao hồ sơ tự công bố, phiếu kiểm nghiệm hoặc giấy chứng nhận, vui lòng liên hệ <a href="mailto:info@rongvanghoanggia.com">info@rongvanghoanggia.com</a>.</p>
  </section>
</BaseLayout>

<style>
  .rvhg-pub { padding-block: 2.5rem 4rem; }
  .rvhg-pub h1 { margin-top: 0.75rem; font-size: var(--text-title); }
  .rvhg-pub h2 { margin-top: 2.5rem; font-size: var(--text-subtitle); }
  .rvhg-pub__lede { margin-top: 0.6rem; max-width: 60ch; color: var(--color-mute); font-size: 1.05rem; }
  .rvhg-pub__certs { margin-top: 1rem; padding-left: 1.2rem; list-style: disc; }
  .rvhg-pub__certs li { margin-top: 0.5rem; }
  .rvhg-pub__links { margin-top: 1rem; list-style: none; display: flex; flex-direction: column; gap: 0.75rem; }
  .rvhg-pub__links li {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 0.9rem 1.1rem;
    background: var(--color-paper);
  }
  .rvhg-pub__links a { font-weight: 600; color: var(--color-rvhg-gold-dark); text-decoration: none; }
  .rvhg-pub__links a:hover { color: var(--color-rvhg-red); }
  .rvhg-pub__links span { display: block; margin-top: 0.25rem; font-size: 0.85rem; color: var(--color-mute); }
  .rvhg-pub__note { margin-top: 2rem; font-size: 0.9rem; color: var(--color-mute); }
  .rvhg-pub__note a { color: var(--color-rvhg-gold-dark); }
</style>
