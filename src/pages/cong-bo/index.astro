---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const policies = (await getCollection('policies')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'vi'));
---

<BaseLayout
  title="Công bố — Rồng Vàng Hoàng Gia"
  description="Hồ sơ tự công bố sản phẩm, chứng nhận và phiếu kiểm nghiệm định kỳ của Công ty Cổ phần Hoàng Giang — thương hiệu Rồng Vàng Hoàng Gia."
  canonical="/cong-bo/"
  noindex={true}
>
  <section class="rvhg-pub-hero rvhg-band-night">
    <div class="rvhg-container">
      <span class="rvhg-pub-hero__code">RVHG / TRANSPARENCY ARCHIVE</span>
      <p class="rvhg-eyebrow">Công bố</p>
      <h1>Minh bạch.<br/><em>Từ bên trong.</em></h1>
      <p class="rvhg-pub-hero__lede">Hồ sơ tự công bố các sản phẩm đang lưu hành, chứng nhận pháp lý và phiếu kiểm nghiệm định kỳ.</p>
    </div>
  </section>

  <!-- Three pillars (mirror cong-bo page sections) -->
  <section class="rvhg-section rvhg-band-soft">
    <div class="rvhg-container">
      <div class="rvhg-pub-pillars">
        <article>
          <h2>Hồ sơ tự công bố</h2>
          <p>Hồ sơ tự công bố các sản phẩm đang lưu hành của Rồng Vàng Hoàng Gia theo quy định của pháp luật — Nghị định 15/2018/NĐ-CP.</p>
          <a class="rvhg-btn--link" href="/ban-tu-cong-bo-rong-vang-hoang-gia/">Xem ngay  ›</a>
        </article>
        <article>
          <h2>Phiếu kiểm nghiệm định kỳ</h2>
          <p>Kết quả kiểm nghiệm định kỳ các sản phẩm của Rồng Vàng Hoàng Gia tại các đơn vị kiểm nghiệm được chỉ định.</p>
          <a class="rvhg-btn--link" href="mailto:info@rongvanghoanggia.com">Yêu cầu bản sao  ›</a>
        </article>
        <article>
          <h2>Thư viện hình ảnh, video</h2>
          <p>Kho lưu trữ thư viện hình ảnh, video về Rồng Vàng Hoàng Gia phục vụ báo chí, đối tác và đại lý.</p>
          <a class="rvhg-btn--link" href={'https://www.facebook.com/rongvanghoanggiapage'} target="_blank" rel="noopener noreferrer">Truy cập Fanpage  ›</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="rvhg-section">
    <div class="rvhg-container">
      <p class="rvhg-eyebrow">Chứng nhận chính</p>
      <div class="rvhg-pub-cert-grid">
        <article>
          <h2>OCOP 5 sao Quốc gia 2024</h2>
          <p>Bánh đậu xanh Rồng Vàng Hoàng Gia là sản phẩm bánh đậu xanh đầu tiên và duy nhất cả nước đạt phân hạng 5 sao Quốc gia trong Chương trình "Mỗi xã một sản phẩm".</p>
        </article>
        <article>
          <h2>ISO 22000:2018</h2>
          <p>Chứng chỉ quản lý an toàn thực phẩm theo tiêu chuẩn quốc tế — số HA 394/2.23.CIV, Quacert cấp ngày 08/08/2023, đã được duy trì liên tục.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Policy list -->
  <section class="rvhg-section rvhg-band-soft">
    <div class="rvhg-container">
      <p class="rvhg-eyebrow">Tự công bố &amp; chính sách</p>
      <h2 class="rvhg-pub-list-head">Tài liệu công khai.</h2>
      <ul class="rvhg-pub-list">
        {policies.map((p) => (
          <li>
            <a href={`/${p.id}/`}>
              <span class="rvhg-pub-list__title">{p.data.title}</span>
              {p.data.description && <span class="rvhg-pub-list__desc">{p.data.description}</span>}
              <span class="rvhg-pub-list__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="rvhg-pub-list__note">
        Cần bản sao hồ sơ tự công bố, phiếu kiểm nghiệm hoặc giấy chứng nhận, vui lòng liên hệ
        <a href="mailto:info@rongvanghoanggia.com">info@rongvanghoanggia.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .rvhg-pub-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(5rem, 11vw, 11rem);
    background:
      radial-gradient(58rem 34rem at 76% 28%, rgb(132 30 35 / 0.48), transparent 72%),
      linear-gradient(135deg, #28070a, #140205);
  }
  .rvhg-pub-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.22;
    background:
      linear-gradient(rgb(240 210 146 / 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgb(240 210 146 / 0.08) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(90deg, black, transparent 78%);
  }
  .rvhg-pub-hero__code {
    display: block;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
    color: rgb(240 210 146 / 0.34);
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.15em;
  }
  .rvhg-pub-hero .rvhg-eyebrow { color: #dfbc74; }
  .rvhg-pub-hero h1 {
    margin-top: 1rem;
    color: #fff8ea;
    font-size: clamp(3.5rem, 9vw, 9rem);
    font-weight: 500;
    line-height: 0.84;
    letter-spacing: -0.06em;
  }
  .rvhg-pub-hero h1 em {
    color: #e7c986;
    font-size: 0.62em;
    font-weight: 400;
  }
  .rvhg-pub-hero__lede {
    margin-top: 2rem;
    color: rgb(255 248 234 / 0.54);
    font-size: clamp(0.95rem, 0.4vw + 0.9rem, 1.1rem);
    max-width: 38rem;
    line-height: 1.72;
  }

  .rvhg-pub-pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }
  .rvhg-pub-pillars article {
    border-top: 1px solid var(--color-line);
    padding-top: 1.5rem;
  }
  .rvhg-pub-pillars h2 {
    font-size: 1.4rem;
    letter-spacing: -0.012em;
  }
  .rvhg-pub-pillars p {
    margin-top: 0.85rem;
    color: var(--color-mute);
    font-size: 0.975rem;
  }
  .rvhg-pub-pillars a { display: inline-block; margin-top: 1rem; }
  @media (max-width: 768px) {
    .rvhg-pub-pillars { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  .rvhg-pub-cert-grid {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }
  .rvhg-pub-cert-grid article {
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
  }
  .rvhg-pub-cert-grid h2 {
    font-size: 1.5rem;
    letter-spacing: -0.014em;
  }
  .rvhg-pub-cert-grid p {
    margin-top: 0.85rem;
    color: var(--color-mute);
  }
  @media (max-width: 768px) {
    .rvhg-pub-cert-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  .rvhg-pub-list-head {
    font-size: var(--text-display);
    margin-block: 0.85rem 2rem;
  }
  .rvhg-pub-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-line);
  }
  .rvhg-pub-list li { border-bottom: 1px solid var(--color-line); }
  .rvhg-pub-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1rem;
    padding: 1.25rem 0.5rem;
    text-decoration: none;
    color: inherit;
    transition: padding 0.18s ease;
  }
  .rvhg-pub-list a:hover { padding-inline-start: 1rem; }
  .rvhg-pub-list__title {
    font-weight: 500;
    color: var(--color-ink);
    font-size: 1.05rem;
  }
  .rvhg-pub-list__desc {
    grid-column: 1;
    margin-top: 0.35rem;
    font-size: 0.9rem;
    color: var(--color-mute);
  }
  .rvhg-pub-list__arrow {
    grid-row: 1 / -1;
    align-self: center;
    color: var(--color-mute);
    font-size: 1.25rem;
  }
  .rvhg-pub-list__note {
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--color-mute);
  }
  .rvhg-pub-list__note a {
    color: var(--color-link);
    text-decoration: none;
    margin-left: 0.25rem;
  }
  .rvhg-pub-list__note a:hover { text-decoration: underline; }
</style>
