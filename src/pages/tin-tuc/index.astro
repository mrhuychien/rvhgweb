---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegacyImg from '../../components/LegacyImg.astro';

const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(d);

const [feature, ...rest] = posts;
---

<BaseLayout
  title="Tin tức — Rồng Vàng Hoàng Gia"
  description="Câu chuyện sản phẩm, hành trình OCOP 5 sao và đời sống của một thương hiệu đặc sản Xứ Đông."
  canonical="/tin-tuc/"
>
  <section class="rvhg-news-hero">
    <div class="rvhg-container">
      <p class="rvhg-eyebrow">Tin tức &amp; câu chuyện</p>
      <h1>Tin tức.</h1>
      <p class="rvhg-news-hero__lede">Bài viết, hành trình OCOP 5 sao, lịch sử nghề bánh đậu xanh Hải Dương.</p>
    </div>
  </section>

  {feature && (
    <section class="rvhg-section rvhg-band-soft">
      <div class="rvhg-container">
        <a href={`/${feature.id}/`} class="rvhg-news-feature">
          {feature.data.cover && (
            <div class="rvhg-news-feature__media">
              <LegacyImg src={feature.data.cover} alt={feature.data.title} width={1600} height={900} loading="eager" fetchpriority="high" />
            </div>
          )}
          <div class="rvhg-news-feature__copy">
            <p class="rvhg-eyebrow">Mới nhất · {fmt(feature.data.publishDate)}</p>
            <h2>{feature.data.title}</h2>
            <p>{feature.data.description}</p>
            <span class="rvhg-news-feature__cta">Đọc bài  ›</span>
          </div>
        </a>
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class="rvhg-section">
      <div class="rvhg-container">
        <ul class="rvhg-news-grid">
          {rest.map((post) => (
            <li>
              <a href={`/${post.id}/`}>
                <div class="rvhg-news-grid__media">
                  {post.data.cover && <LegacyImg src={post.data.cover} alt={post.data.title} width={800} height={600} />}
                </div>
                <p class="rvhg-news-grid__date">{fmt(post.data.publishDate)}</p>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .rvhg-news-hero {
    text-align: center;
    padding-block: 5rem 4rem;
  }
  @media (min-width: 768px) { .rvhg-news-hero { padding-block: 7rem 4rem; } }
  .rvhg-news-hero h1 {
    margin-top: 0.6rem;
    font-size: var(--text-headline);
  }
  .rvhg-news-hero__lede {
    margin: 1.25rem auto 0;
    color: var(--color-mute);
    font-size: clamp(1rem, 0.5vw + 0.95rem, 1.2rem);
    max-width: 36rem;
  }

  .rvhg-news-feature {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }
  .rvhg-news-feature__media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-card);
    transition: transform 0.4s ease;
  }
  .rvhg-news-feature:hover .rvhg-news-feature__media :global(img) { transform: scale(1.02); }
  .rvhg-news-feature__copy h2 {
    margin-top: 0.6rem;
    font-size: clamp(1.5rem, 1.5vw + 1rem, 2.5rem);
  }
  .rvhg-news-feature__copy p {
    margin-top: 1rem;
    color: var(--color-mute);
    max-width: 38ch;
  }
  .rvhg-news-feature__cta {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--color-link);
    font-weight: 500;
  }
  @media (max-width: 768px) {
    .rvhg-news-feature { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  .rvhg-news-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem 2rem;
  }
  .rvhg-news-grid a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .rvhg-news-grid__media {
    aspect-ratio: 16 / 10;
    background: var(--color-paper-tint);
    border-radius: var(--radius-card);
    overflow: hidden;
    margin-bottom: 1rem;
  }
  .rvhg-news-grid__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .rvhg-news-grid a:hover .rvhg-news-grid__media :global(img) { transform: scale(1.03); }
  .rvhg-news-grid__date {
    font-size: 0.8rem;
    color: var(--color-mute-soft);
    margin-bottom: 0.4rem;
  }
  .rvhg-news-grid h3 {
    font-size: 1.15rem;
    line-height: 1.35;
  }
  .rvhg-news-grid p {
    margin-top: 0.6rem;
    color: var(--color-mute);
    font-size: 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (max-width: 900px) { .rvhg-news-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .rvhg-news-grid { grid-template-columns: 1fr; } }
</style>
