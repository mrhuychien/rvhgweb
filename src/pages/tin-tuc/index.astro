---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegacyImg from '../../components/LegacyImg.astro';
import Motion from '../../components/Motion.astro';
import { postPath, isPublished } from '../../lib/posts';

const posts = (await getCollection('posts', isPublished)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(d);

const [feature, ...rest] = posts;
---

<BaseLayout
  title="Tin tức — Rồng Vàng Hoàng Gia"
  description="Câu chuyện sản phẩm, hành trình OCOP 5 sao và đời sống của một thương hiệu đặc sản Xứ Đông."
  canonical="/tin-tuc/"
>
  <section class="rvhg-news-hero rvhg-band-night">
    <div class="rvhg-news-hero__grid" aria-hidden="true"></div>
    <div class="rvhg-container" data-reveal>
      <span class="rvhg-news-hero__code">RVHG / JOURNAL / STORIES OF HERITAGE</span>
      <p class="rvhg-eyebrow">Tin tức &amp; câu chuyện</p>
      <h1>Royal<br/><em>Journal.</em></h1>
      <p class="rvhg-news-hero__lede">Bài viết, hành trình OCOP 5 sao, lịch sử nghề bánh đậu xanh Hải Dương.</p>
    </div>
  </section>

  {feature && (
    <section class="rvhg-section rvhg-band-soft">
      <div class="rvhg-container">
        <a href={postPath(feature)} class="rvhg-news-feature" data-reveal>
          {feature.data.cover && (
            <div class="rvhg-news-feature__media">
              <LegacyImg src={feature.data.cover} alt={feature.data.title} width={1600} height={900} loading="eager" fetchpriority="high" />
            </div>
          )}
          <div class="rvhg-news-feature__copy">
            <p class="rvhg-eyebrow">Mới nhất · {fmt(feature.data.publishDate)}</p>
            <h2>{feature.data.title}</h2>
            <p>{feature.data.description}</p>
            <span class="rvhg-news-feature__cta">Đọc bài  ›</span>
          </div>
        </a>
      </div>
    </section>
  )}

  {rest.length > 0 && (
    <section class="rvhg-section">
      <div class="rvhg-container">
        <ul class="rvhg-news-grid">
          {rest.map((post) => (
            <li data-reveal>
              <a href={postPath(post)}>
                <div class="rvhg-news-grid__media">
                  {post.data.cover && <LegacyImg src={post.data.cover} alt={post.data.title} width={800} height={600} />}
                </div>
                <p class="rvhg-news-grid__date">{fmt(post.data.publishDate)}</p>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  <Motion />
</BaseLayout>

<style>
  .rvhg-news-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(5rem, 11vw, 11rem);
    background:
      radial-gradient(58rem 34rem at 76% 28%, rgb(132 30 35 / 0.48), transparent 72%),
      linear-gradient(135deg, #28070a, #140205);
  }
  .rvhg-news-hero__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.22;
    background:
      linear-gradient(rgb(240 210 146 / 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgb(240 210 146 / 0.08) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(90deg, black, transparent 78%);
  }
  .rvhg-news-hero__code {
    display: block;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
    color: rgb(240 210 146 / 0.34);
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.15em;
  }
  .rvhg-news-hero .rvhg-eyebrow { color: #dfbc74; }
  .rvhg-news-hero h1 {
    margin-top: 1rem;
    color: #fff8ea;
    font-size: clamp(4rem, 10vw, 10rem);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.065em;
  }
  .rvhg-news-hero h1 em {
    color: #e7c986;
    font-size: 0.62em;
    font-weight: 400;
  }
  .rvhg-news-hero__lede {
    max-width: 38rem;
    margin-top: 2rem;
    color: rgb(255 248 234 / 0.54);
    font-size: clamp(0.95rem, 0.4vw + 0.9rem, 1.1rem);
    line-height: 1.72;
  }

  .rvhg-news-feature {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    text-decoration: none;
    color: inherit;
  }
  .rvhg-news-feature__media :global(img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid rgb(116 80 42 / 0.18);
    border-radius: 0;
    box-shadow: 0 35px 90px -48px rgb(42 9 11 / 0.52);
    transition: transform 0.65s var(--ease-out-expo, ease);
  }
  .rvhg-news-feature:hover .rvhg-news-feature__media :global(img) { transform: scale(1.02); }
  .rvhg-news-feature__copy h2 {
    margin-top: 0.6rem;
    font-size: clamp(2rem, 3.5vw, 4rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  .rvhg-news-feature__copy p {
    margin-top: 1rem;
    color: var(--color-mute);
    max-width: 38ch;
  }
  .rvhg-news-feature__cta {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--color-link);
    color: #8b2026;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  @media (max-width: 768px) {
    .rvhg-news-feature { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  .rvhg-news-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.5rem 1.2rem;
  }
  .rvhg-news-grid li {
    border: 1px solid var(--color-line);
    background: rgb(255 252 246 / 0.76);
    transition: border-color 0.3s ease, transform 0.4s var(--ease-out-expo, ease);
  }
  .rvhg-news-grid li:hover { border-color: rgb(139 32 38 / 0.34); transform: translateY(-5px); }
  .rvhg-news-grid a {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .rvhg-news-grid__media {
    aspect-ratio: 16 / 10;
    background: var(--color-paper-tint);
    border-radius: 0;
    overflow: hidden;
    margin-bottom: 0;
  }
  .rvhg-news-grid__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.65s var(--ease-out-expo, ease);
  }
  .rvhg-news-grid a:hover .rvhg-news-grid__media :global(img) { transform: scale(1.03); }
  .rvhg-news-grid__date {
    padding-inline: 1rem;
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--color-mute-soft);
    margin-bottom: 0.4rem;
  }
  .rvhg-news-grid h3 {
    padding-inline: 1rem;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.35;
  }
  .rvhg-news-grid p {
    margin-top: 0.6rem;
    color: var(--color-mute);
    font-size: 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    padding: 0 1rem 1.1rem;
  }
  @media (max-width: 900px) { .rvhg-news-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .rvhg-news-grid { grid-template-columns: 1fr; } }
</style>
