---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LegacyImg from '../../components/LegacyImg.astro';

const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const fmt = (d: Date) =>
  new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(d);
---

<BaseLayout
  title="Tin tức Rồng Vàng Hoàng Gia"
  description="Tin tức, câu chuyện sản phẩm và cập nhật mới nhất từ Rồng Vàng Hoàng Gia — bánh đậu xanh OCOP 5 sao Quốc gia."
  canonical="/tin-tuc/"
>
  <section class="rvhg-container rvhg-news">
    <Breadcrumbs items={[{ name: 'Tin tức', url: '/tin-tuc/' }]} />
    <h1>Tin tức &amp; câu chuyện</h1>
    <p class="rvhg-news__lede">Những câu chuyện về bánh đậu xanh, hành trình OCOP 5 sao và đời sống của một thương hiệu đặc sản Xứ Đông.</p>

    <ul class="rvhg-news__list">
      {posts.map((post) => (
        <li class="rvhg-news__item">
          <a href={`/${post.id}/`} class="rvhg-news__thumb">
            {post.data.cover && <LegacyImg src={post.data.cover} alt={post.data.title} width={600} height={338} />}
          </a>
          <div class="rvhg-news__body">
            <p class="rvhg-news__meta"><time datetime={post.data.publishDate.toISOString()}>{fmt(post.data.publishDate)}</time></p>
            <h2><a href={`/${post.id}/`}>{post.data.title}</a></h2>
            <p class="rvhg-news__excerpt">{post.data.description}</p>
            <a href={`/${post.id}/`} class="rvhg-news__more">Đọc tiếp →</a>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .rvhg-news { padding-block: 2.5rem 4rem; }
  .rvhg-news h1 { margin-top: 0.75rem; font-size: var(--text-title); }
  .rvhg-news__lede { margin-top: 0.6rem; max-width: 60ch; color: var(--color-mute); font-size: 1.05rem; }
  .rvhg-news__list { list-style: none; margin-top: 2rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .rvhg-news__item {
    display: grid;
    grid-template-columns: 18rem 1fr;
    gap: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-paper);
    transition: box-shadow 0.18s ease;
  }
  .rvhg-news__item:hover { box-shadow: var(--shadow-soft); }
  .rvhg-news__thumb { display: block; aspect-ratio: 16 / 9; background: var(--color-rvhg-cream); }
  .rvhg-news__thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .rvhg-news__body { padding: 1.25rem 1.5rem 1.25rem 0; }
  .rvhg-news__meta { font-size: 0.8rem; color: var(--color-mute); }
  .rvhg-news__body h2 { margin-top: 0.35rem; font-size: 1.25rem; line-height: 1.3; }
  .rvhg-news__body h2 a { text-decoration: none; color: var(--color-ink); }
  .rvhg-news__body h2 a:hover { color: var(--color-rvhg-gold-dark); }
  .rvhg-news__excerpt { margin-top: 0.5rem; color: var(--color-ink-soft); font-size: 0.95rem; }
  .rvhg-news__more { display: inline-block; margin-top: 0.75rem; font-size: 0.875rem; font-weight: 600; color: var(--color-rvhg-gold-dark); text-decoration: none; }
  .rvhg-news__more:hover { color: var(--color-rvhg-red); }
  @media (max-width: 720px) {
    .rvhg-news__item { grid-template-columns: 1fr; }
    .rvhg-news__body { padding: 1.25rem 1.5rem 1.5rem; }
  }
</style>
