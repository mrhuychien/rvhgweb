---
import { getEntry, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const entry = await getEntry('pages', 'diem-ban');
if (!entry) throw new Error('Missing content: pages/diem-ban');
const { Content } = await render(entry);
const d = entry.data;
---

<PageLayout
  title={d.title}
  description={d.description}
  canonical={d.route}
  eyebrow="Điểm bán"
  heading="Mua chính hãng ở khắp nơi."
  lede="Hiện diện tại các hệ thống siêu thị lớn, sàn TMĐT, và showroom tại Hải Dương."
>
  <Content />
</PageLayout>
