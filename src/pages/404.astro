---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Không tìm thấy trang (404)" description="Trang bạn tìm không tồn tại hoặc đã được di chuyển." noindex={true}>
  <section class="rvhg-container rvhg-404">
    <p class="rvhg-eyebrow">404</p>
    <h1>Không tìm thấy trang.</h1>
    <p>Trang có thể đã được di chuyển. Quay lại trang chủ hoặc khám phá sản phẩm.</p>
    <div class="rvhg-404__cta">
      <a class="rvhg-btn" href="/">Về trang chủ</a>
      <a class="rvhg-btn rvhg-btn--ghost" href="/san-pham/">Xem sản phẩm</a>
    </div>
  </section>
</BaseLayout>

<style>
  .rvhg-404 {
    padding-block: 4.5rem 6rem;
    text-align: center;
  }
  @media (min-width: 768px) {
    .rvhg-404 { padding-block: 7rem 8rem; }
  }
  .rvhg-404 h1 {
    margin-top: 0.6rem;
    font-size: var(--text-headline);
  }
  .rvhg-404 p {
    margin: 1.25rem auto 0;
    color: var(--color-mute);
    max-width: 38rem;
    font-size: clamp(1rem, 0.5vw + 0.95rem, 1.2rem);
  }
  .rvhg-404__cta {
    margin-top: 2rem;
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
