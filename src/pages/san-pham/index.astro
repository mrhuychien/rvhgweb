---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegacyImg from '../../components/LegacyImg.astro';

const lines = (await getCollection('productCategories')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Sản phẩm — Rồng Vàng Hoàng Gia"
  description="Năm dòng sản phẩm Rồng Vàng Hoàng Gia: thượng hạng OCOP 5 sao, quà Tết, truyền thống, hương vị trái cây và bột đậu — sản xuất theo chuẩn ISO 22000:2018."
  canonical="/san-pham/"
>
  <!-- Hero -->
  <section class="rvhg-pl-hero">
    <div class="rvhg-container">
      <p class="rvhg-eyebrow">Năm dòng sản phẩm</p>
      <h1>Sản phẩm.</h1>
      <p class="rvhg-pl-hero__lede">
        Bánh đậu xanh OCOP 5 sao Quốc gia. Bột đậu xanh dinh dưỡng. Chè đậu đen cốt dừa.<br/>
        Mỗi dòng có chuẩn riêng — chung một quy trình ISO 22000:2018.
      </p>
    </div>
  </section>

  <!-- Lines list — full-bleed alternating -->
  {lines.map((line, i) => (
    <section class={`rvhg-pl-line ${i % 2 === 1 ? 'rvhg-band-tint rvhg-pl-line--alt' : ''}`}>
      <a href={`/danh-muc-san-pham/${line.id}/`} class="rvhg-pl-line__inner rvhg-container">
        <div class="rvhg-pl-line__copy">
          <p class="rvhg-eyebrow">{line.data.eyebrow ?? `Dòng ${i + 1}`}</p>
          <h2>{line.data.title}</h2>
          <p class="rvhg-pl-line__tagline">{line.data.tagline}</p>
          <p class="rvhg-pl-line__lede">{line.data.description}</p>
          <span class="rvhg-pl-line__cta">
            {line.data.products.length} sản phẩm  ›
          </span>
        </div>
        {line.data.heroImage && (
          <div class="rvhg-pl-line__media">
            <LegacyImg src={line.data.cardImage ?? line.data.heroImage} alt={line.data.title} width={1200} height={900} loading={i < 2 ? 'eager' : 'lazy'} />
          </div>
        )}
      </a>
    </section>
  ))}
</BaseLayout>

<style>
  .rvhg-pl-hero {
    text-align: center;
    padding-block: 3.5rem 2.5rem;
  }
  @media (min-width: 768px) { .rvhg-pl-hero { padding-block: 7rem 5rem; } }
  .rvhg-pl-hero h1 {
    margin-top: 0.6rem;
    font-size: var(--text-headline);
  }
  .rvhg-pl-hero__lede {
    margin: 1.5rem auto 0;
    color: var(--color-mute);
    font-size: clamp(1rem, 0.5vw + 0.95rem, 1.2rem);
    max-width: 38rem;
  }

  .rvhg-pl-line { padding-block: 3.5rem; }
  @media (min-width: 768px) { .rvhg-pl-line { padding-block: 7rem; } }
  .rvhg-pl-line__inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: center;
    text-decoration: none;
    color: inherit;
  }
  .rvhg-pl-line--alt .rvhg-pl-line__inner {
    grid-template-columns: 1.1fr 1fr;
    direction: rtl;
  }
  .rvhg-pl-line--alt .rvhg-pl-line__inner > * { direction: ltr; }
  .rvhg-pl-line__copy h2 {
    font-size: var(--text-display);
    margin-top: 0.85rem;
    transition: color 0.18s ease;
  }
  .rvhg-pl-line:hover .rvhg-pl-line__copy h2 { color: var(--color-link); }
  .rvhg-pl-line__tagline {
    margin-top: 0.85rem;
    font-size: clamp(1.15rem, 1vw + 0.85rem, 1.5rem);
    color: var(--color-ink);
    font-weight: 500;
    max-width: 26ch;
  }
  .rvhg-pl-line__lede {
    margin-top: 1rem;
    color: var(--color-mute);
    max-width: 38ch;
  }
  .rvhg-pl-line__cta {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--color-link);
    font-weight: 500;
    font-size: 0.95rem;
  }
  .rvhg-pl-line__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-card);
    transition: transform 0.4s ease;
  }
  .rvhg-pl-line:hover .rvhg-pl-line__media :global(img) {
    transform: scale(1.02);
  }
  @media (max-width: 768px) {
    .rvhg-pl-line__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .rvhg-pl-line:nth-of-type(even) .rvhg-pl-line__inner { grid-template-columns: 1fr; direction: ltr; }
    .rvhg-pl-line__media { order: -1; }
  }
</style>
