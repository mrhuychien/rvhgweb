---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegacyImg from '../../components/LegacyImg.astro';
import Motion from '../../components/Motion.astro';
import { POWDERS, POWDER_SINGLES, assetUrl } from '../../data/powders';

const lines = (await getCollection('productCategories')).sort((a, b) => a.data.order - b.data.order);

// Standalone landing pages for the mung-bean powder drinks (flat URLs).
const powderCards = [
  ...POWDER_SINGLES.map((s) => ({
    href: `/${s}/`,
    name: POWDERS[s].name,
    image: POWDERS[s].image,
    tag: POWDERS[s].flavor,
    accent: POWDERS[s].accent,
    accentInk: POWDERS[s].accentInk,
  })),
  {
    href: '/bdx-rauma-khongduong/',
    name: 'Không thêm đường — Plant based',
    image: POWDERS['botdx-rauma-khongduong'].image,
    tag: 'Rau má & Sữa dừa',
    accent: '#3f7d4e',
    accentInk: '#2c5c39',
  },
];
---

<BaseLayout
  title="Sản phẩm bánh đậu xanh & bột đậu xanh"
  description="Năm dòng sản phẩm Rồng Vàng Hoàng Gia: bánh đậu xanh thượng hạng OCOP 5 sao, quà Tết, truyền thống, hương vị trái cây và bột đậu xanh — sản xuất theo chuẩn ISO 22000:2018."
  canonical="/san-pham/"
>
  <!-- Hero -->
  <section class="rvhg-pl-hero rvhg-band-night">
    <div class="rvhg-pl-hero__grid" aria-hidden="true"></div>
    <div class="rvhg-container" data-reveal>
      <span class="rvhg-pl-hero__code">RVHG / PRODUCT UNIVERSE / 05 COLLECTIONS</span>
      <p class="rvhg-eyebrow">Năm dòng sản phẩm</p>
      <h1>Thế giới<br/><em>Rồng Vàng.</em></h1>
      <p class="rvhg-pl-hero__lede">
        Bánh đậu xanh OCOP 5 sao Quốc gia. Bột đậu xanh dinh dưỡng. Chè đậu đen cốt dừa.<br/>
        Mỗi dòng có chuẩn riêng — chung một quy trình ISO 22000:2018.
      </p>
      <span class="rvhg-pl-hero__line" aria-hidden="true"></span>
    </div>
  </section>

  <!-- Lines list — full-bleed alternating -->
  {lines.map((line, i) => (
    <section class={`rvhg-pl-line ${i % 2 === 1 ? 'rvhg-band-tint rvhg-pl-line--alt' : ''}`}>
      <a href={`/danh-muc-san-pham/${line.id}/`} class="rvhg-pl-line__inner rvhg-container" data-reveal={i % 2 ? 'right' : 'left'}>
        <div class="rvhg-pl-line__copy">
          <span class="rvhg-pl-line__no">{String(i + 1).padStart(2, '0')}</span>
          <p class="rvhg-eyebrow">{line.data.eyebrow ?? `Dòng ${i + 1}`}</p>
          <h2>{line.data.title}</h2>
          <p class="rvhg-pl-line__tagline">{line.data.tagline}</p>
          <p class="rvhg-pl-line__lede">{line.data.description}</p>
          <span class="rvhg-pl-line__cta">
            {line.data.products.length} sản phẩm  ›
          </span>
        </div>
        {line.data.heroImage && (
          <div class="rvhg-pl-line__media" data-tilt>
            <LegacyImg src={line.data.cardImage ?? line.data.heroImage} alt={line.data.title} width={1200} height={900} loading={i < 2 ? 'eager' : 'lazy'} />
          </div>
        )}
      </a>
    </section>
  ))}

  <!-- Bột đậu xanh pha sẵn — standalone flavour pages -->
  <section class="rvhg-section rvhg-band-soft">
    <div class="rvhg-container">
      <header class="rvhg-pw-new__head">
        <p class="rvhg-eyebrow">Mới · Bột đậu xanh pha sẵn</p>
        <h2>Bột đậu xanh — chọn theo vị.</h2>
        <div class="gold-rule rvhg-rule--center"></div>
        <p>Đậu xanh lòng vàng Hải Dương phối cùng cà rốt, rau má, sữa dừa, matcha — và dòng không thêm đường thuần thực vật.</p>
      </header>
      <div class="rvhg-pw-grid">
        {powderCards.map((c) => (
          <a class="rvhg-pw-card" href={c.href} style={`--pa:${c.accent};--pa-ink:${c.accentInk}`} data-tilt data-reveal>
            <span class="rvhg-pw-card__media">
              <LegacyImg src={assetUrl(c.image)} alt={c.name} width={600} height={600} loading="lazy" />
            </span>
            <span class="rvhg-pw-card__tag">{c.tag}</span>
            <span class="rvhg-pw-card__name">{c.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Motion />
</BaseLayout>

<style>
  .rvhg-pl-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(5rem, 11vw, 11rem);
    background:
      radial-gradient(58rem 34rem at 76% 28%, rgb(132 30 35 / 0.48), transparent 72%),
      linear-gradient(135deg, #28070a, #140205);
  }
  .rvhg-pl-hero__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.22;
    background:
      linear-gradient(rgb(240 210 146 / 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgb(240 210 146 / 0.08) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(circle at 65% 35%, black, transparent 78%);
  }
  .rvhg-pl-hero__code {
    display: block;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
    color: rgb(240 210 146 / 0.34);
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.15em;
  }
  .rvhg-pl-hero .rvhg-eyebrow { color: #dfbc74; }
  .rvhg-pl-hero h1 {
    margin-top: 1rem;
    color: #fff8ea;
    font-size: clamp(4rem, 10vw, 10rem);
    font-weight: 500;
    line-height: 0.82;
    letter-spacing: -0.065em;
  }
  .rvhg-pl-hero h1 em {
    color: #e7c986;
    font-size: 0.62em;
    font-weight: 400;
  }
  .rvhg-pl-hero__lede {
    max-width: 45rem;
    margin-top: 2rem;
    color: rgb(255 248 234 / 0.54);
    font-size: clamp(0.94rem, 0.45vw + 0.9rem, 1.1rem);
    line-height: 1.76;
  }
  .rvhg-pl-hero__line {
    display: block;
    width: min(22rem, 55vw);
    height: 1px;
    margin-top: 2.2rem;
    background: linear-gradient(90deg, #f0d292, transparent);
  }

  .rvhg-pl-line { position: relative; overflow: hidden; padding-block: clamp(4rem, 8vw, 8rem); }
  .rvhg-pl-line::after {
    content: '';
    position: absolute;
    right: 2vw;
    top: 0;
    color: rgb(139 32 38 / 0.04);
    font-family: var(--font-display);
    font-size: 22vw;
    line-height: 1;
    pointer-events: none;
  }
  .rvhg-pl-line__inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
    text-decoration: none;
    color: inherit;
  }
  .rvhg-pl-line--alt .rvhg-pl-line__inner {
    grid-template-columns: 1.1fr 1fr;
    direction: rtl;
  }
  .rvhg-pl-line--alt .rvhg-pl-line__inner > * { direction: ltr; }
  .rvhg-pl-line__no {
    display: block;
    margin-bottom: clamp(2rem, 5vw, 4rem);
    color: #9a7b4a;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
  }
  .rvhg-pl-line__copy h2 {
    max-width: 11ch;
    margin-top: 0.85rem;
    font-size: clamp(2.5rem, 5vw, 5.4rem);
    font-weight: 500;
    line-height: 0.97;
    letter-spacing: -0.052em;
    transition: color 0.3s ease;
  }
  .rvhg-pl-line:hover .rvhg-pl-line__copy h2 { color: #8b2026; }
  .rvhg-pl-line__tagline {
    margin-top: 0.85rem;
    font-size: clamp(1.15rem, 1vw + 0.85rem, 1.5rem);
    color: var(--color-ink);
    font-weight: 500;
    max-width: 26ch;
  }
  .rvhg-pl-line__lede {
    margin-top: 1rem;
    color: var(--color-mute);
    max-width: 38ch;
  }
  .rvhg-pl-line__cta {
    display: inline-block;
    margin-top: 1.5rem;
    color: #8b2026;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .rvhg-pl-line__media {
    position: relative;
    transform-style: preserve-3d;
  }
  .rvhg-pl-line__media::before {
    content: '';
    position: absolute;
    inset: -0.75rem 1.25rem 0.75rem -0.75rem;
    border: 1px solid rgb(139 32 38 / 0.2);
    transform: translateZ(-20px);
  }
  .rvhg-pl-line__media :global(img) {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid rgb(116 80 42 / 0.18);
    border-radius: 0;
    box-shadow: 0 35px 90px -48px rgb(42 9 11 / 0.55);
    transition: transform 0.6s var(--ease-out-expo, ease);
  }
  .rvhg-pl-line:hover .rvhg-pl-line__media :global(img) {
    transform: scale(1.025);
  }
  @media (max-width: 768px) {
    .rvhg-pl-line__inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .rvhg-pl-line:nth-of-type(even) .rvhg-pl-line__inner { grid-template-columns: 1fr; direction: ltr; }
    .rvhg-pl-line__media { order: -1; }
  }

  /* Bột đậu xanh — flavour cards */
  .rvhg-pw-new__head { text-align: center; max-width: 42rem; margin: 0 auto 3rem; }
  .rvhg-pw-new__head h2 { font-size: var(--text-display); margin-top: 0.5rem; }
  .rvhg-pw-new__head > p { margin-top: 1rem; color: var(--color-mute); }
  .rvhg-pw-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.25rem; }
  .rvhg-pw-card { display: flex; flex-direction: column; gap: 0.55rem; text-decoration: none; color: var(--color-ink); }
  .rvhg-pw-card__media {
    aspect-ratio: 1 / 1;
    background: color-mix(in srgb, var(--pa) 10%, #fff);
    border: 1px solid color-mix(in srgb, var(--pa) 20%, var(--color-line));
    border-radius: 0;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: 0.6rem;
  }
  .rvhg-pw-card__media :global(img) { width: 100%; height: 100%; object-fit: contain; transition: transform 0.4s var(--ease-refined, ease); }
  .rvhg-pw-card:hover .rvhg-pw-card__media :global(img) { transform: scale(1.05); }
  .rvhg-pw-card__tag { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--pa-ink); font-weight: 600; }
  .rvhg-pw-card__name { font-size: 0.9rem; font-weight: 500; line-height: 1.3; letter-spacing: -0.01em; }
  @media (max-width: 900px) { .rvhg-pw-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 520px) { .rvhg-pw-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
