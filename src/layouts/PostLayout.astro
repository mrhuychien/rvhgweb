---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import LegacyImg from '../components/LegacyImg.astro';
import { articleSchema } from '../data/jsonld';
import { postPath } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { title, description, publishDate, updated, author, cover, tags } = post.data;
const url = postPath(post);

const dateStr = new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(publishDate);

const ogImage = `/og/post/${post.id}.png`;
const jsonLd = articleSchema({
  headline: title,
  description,
  image: ogImage,
  datePublished: publishDate.toISOString(),
  dateModified: (updated ?? publishDate).toISOString(),
  author,
  url,
});
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  type="article"
  publishedTime={publishDate.toISOString()}
  modifiedTime={(updated ?? publishDate).toISOString()}
  jsonLd={jsonLd}
>
  <article class="rvhg-post">
    <header class="rvhg-post__head">
      <div class="rvhg-container rvhg-container--narrow">
        <p class="rvhg-eyebrow">Tin tức · {dateStr}</p>
        <h1>{title}</h1>
        <p class="rvhg-post__byline">
          <span>{author}</span>
        </p>
        {tags.length > 0 && (
          <ul class="rvhg-post__tags">{tags.map((t) => <li>{t}</li>)}</ul>
        )}
      </div>
    </header>

    {cover && (
      <div class="rvhg-post__cover">
        <LegacyImg src={cover} alt={title} width={2400} height={1350} loading="eager" fetchpriority="high" />
      </div>
    )}

    <div class="rvhg-container rvhg-post__body">
      <div class="rvhg-prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .rvhg-post__head {
    text-align: center;
    padding-top: 3rem;
  }
  @media (min-width: 768px) { .rvhg-post__head { padding-top: 6.5rem; } }
  .rvhg-post__head h1 {
    margin-top: 0.6rem;
    font-size: clamp(2rem, 3vw + 1rem, 3.5rem);
  }
  .rvhg-post__byline {
    margin-top: 1rem;
    color: var(--color-mute);
    font-size: 0.95rem;
  }
  .rvhg-post__tags {
    list-style: none;
    margin: 1.25rem auto 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
    padding: 0;
  }
  .rvhg-post__tags li {
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-sm, 2px);
    background: var(--color-paper-tint);
    color: var(--color-mute);
  }
  .rvhg-post__cover {
    margin-top: 3rem;
    width: 100%;
  }
  .rvhg-post__cover :global(img) {
    width: 100%;
    height: clamp(18rem, 50vw, 32rem);
    object-fit: cover;
    display: block;
  }
  .rvhg-post__body {
    padding-block: 4rem 6rem;
    display: grid;
    place-items: center;
  }
</style>
