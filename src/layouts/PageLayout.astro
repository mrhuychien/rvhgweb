---
import BaseLayout from './BaseLayout.astro';
import LegacyImg from '../components/LegacyImg.astro';
import Motion from '../components/Motion.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  heroImage?: string;
  /** Hiển thị ảnh hero theo đúng tỉ lệ gốc (không crop) — dùng cho ảnh nhiều nội dung/chữ. */
  heroImageNatural?: boolean;
  heading?: string;
  /** Heading with inline markup (e.g. an auto-updating year span). Takes precedence over `heading`. */
  headingHtml?: string;
  eyebrow?: string;
  lede?: string;
  breadcrumbs?: { name: string; url: string }[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description,
  canonical,
  image,
  heroImage,
  heroImageNatural,
  heading,
  headingHtml,
  eyebrow,
  lede,
  jsonLd,
} = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} image={image ?? heroImage} jsonLd={jsonLd}>
  <article class="rvhg-page">
    <header class="rvhg-page__hero rvhg-band-night">
      <div class="rvhg-page__grid" aria-hidden="true"></div>
      <div class:list={['rvhg-container', 'rvhg-page__hero-inner', !heroImage && 'rvhg-page__hero-inner--solo']}>
        <div class="rvhg-page__hero-copy" data-reveal="left">
          <span class="rvhg-page__code">RVHG / BRAND PAGE</span>
          {eyebrow && <p class="rvhg-eyebrow">{eyebrow}</p>}
          {headingHtml ? <h1 set:html={headingHtml}></h1> : <h1>{heading ?? title}</h1>}
          {lede && <p class="rvhg-page__lede">{lede}</p>}
          <span class="rvhg-page__line" aria-hidden="true"></span>
        </div>
        {heroImage && (
          <div class:list={['rvhg-page__heroimg', heroImageNatural && 'rvhg-page__heroimg--natural']} data-reveal="right">
            <span class="rvhg-page__heroimg-frame" aria-hidden="true"></span>
            <LegacyImg src={heroImage} alt={heading ?? title} width={2400} height={1350} loading="eager" fetchpriority="high" />
            <div class="rvhg-page__heroimg-meta" aria-hidden="true">
              <span>Rồng Vàng Hoàng Gia</span>
              <span>Hải Dương · Vietnam</span>
            </div>
          </div>
        )}
      </div>
    </header>
    <div class="rvhg-container rvhg-page__body" data-reveal>
      <div class="rvhg-page__body-label" aria-hidden="true">
        <span>Nội dung</span>
        <span>↓</span>
      </div>
      <div class="rvhg-prose rvhg-page__prose">
        <slot />
      </div>
    </div>
  </article>
  <Motion />
</BaseLayout>

<style>
  .rvhg-page__hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(4rem, 8vw, 8rem);
    background:
      radial-gradient(55rem 36rem at 82% 25%, rgb(131 30 35 / 0.48), transparent 72%),
      linear-gradient(135deg, #28070a, #140205);
  }
  .rvhg-page__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.23;
    background:
      linear-gradient(rgb(240 210 146 / 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgb(240 210 146 / 0.08) 1px, transparent 1px);
    background-size: 70px 70px;
    mask-image: linear-gradient(90deg, black, transparent 72%);
  }
  .rvhg-page__hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(28rem, 1.22fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .rvhg-page__hero-inner--solo { grid-template-columns: minmax(0, 0.75fr) minmax(0, 0.25fr); }
  .rvhg-page__hero-copy { position: relative; z-index: 2; }
  .rvhg-page__code {
    display: block;
    margin-bottom: clamp(2rem, 5vw, 5rem);
    color: rgb(240 210 146 / 0.36);
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.16em;
  }
  .rvhg-page__hero .rvhg-eyebrow { color: #dfbc74; }
  .rvhg-page__hero h1 {
    max-width: 12ch;
    margin-top: 1rem;
    color: #fff8ea;
    font-size: clamp(3rem, 6vw, 6.5rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.055em;
  }
  .rvhg-page__lede {
    max-width: 36rem;
    margin-top: 1.4rem;
    color: rgb(255 248 234 / 0.56);
    font-size: clamp(0.95rem, 0.4vw + 0.9rem, 1.1rem);
    line-height: 1.72;
  }
  .rvhg-page__line {
    position: relative;
    display: block;
    width: min(15rem, 80%);
    height: 1px;
    margin-top: 2rem;
    overflow: hidden;
    background: rgb(240 210 146 / 0.18);
  }
  .rvhg-page__line::after {
    content: '';
    position: absolute;
    inset: 0;
    width: 38%;
    background: #f0d292;
    animation: page-line 3.2s ease-in-out infinite;
  }
  @keyframes page-line { 50% { transform: translateX(165%); } }
  .rvhg-page__heroimg {
    position: relative;
    min-width: 0;
    transform-style: preserve-3d;
  }
  .rvhg-page__heroimg :global(img) {
    width: 100%;
    height: clamp(25rem, 46vw, 40rem);
    object-fit: cover;
    display: block;
    border: 1px solid rgb(240 210 146 / 0.35);
    box-shadow: 0 45px 110px -52px rgb(0 0 0 / 0.9);
    transform: perspective(1000px) rotateY(-5deg);
  }
  .rvhg-page__heroimg--natural :global(img) {
    height: auto;
    object-fit: contain;
  }
  .rvhg-page__heroimg-frame {
    position: absolute;
    inset: -1rem 1.5rem 1rem -1rem;
    border: 1px solid rgb(240 210 146 / 0.16);
    transform: perspective(1000px) rotateY(-5deg) translateZ(-20px);
  }
  .rvhg-page__heroimg::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(115deg, transparent 25%, rgb(255 255 255 / 0.16) 45%, transparent 61%);
    background-size: 220% 100%;
    animation: page-image-shine 7s ease-in-out infinite;
  }
  @keyframes page-image-shine { 50% { background-position: -140% 0; } }
  .rvhg-page__heroimg-meta {
    position: absolute;
    left: 1.2rem;
    right: 1.2rem;
    bottom: 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: rgb(255 248 234 / 0.72);
    font-size: 0.53rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .rvhg-page__body {
    display: grid;
    grid-template-columns: minmax(7rem, 0.3fr) minmax(0, 1fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
    padding-block: clamp(4rem, 9vw, 9rem);
  }
  .rvhg-page__body-label {
    position: sticky;
    top: 7rem;
    display: flex;
    justify-content: space-between;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-line);
    color: #9a7b4a;
    font-size: 0.57rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .rvhg-page__prose { max-width: 72ch; }
  @media (max-width: 820px) {
    .rvhg-page__hero-inner,
    .rvhg-page__hero-inner--solo { grid-template-columns: 1fr; }
    .rvhg-page__code { margin-bottom: 2rem; }
    .rvhg-page__heroimg { margin-top: 1rem; }
    .rvhg-page__heroimg :global(img) { height: clamp(20rem, 70vw, 32rem); transform: none; }
    .rvhg-page__heroimg-frame { display: none; }
    .rvhg-page__body { grid-template-columns: 1fr; }
    .rvhg-page__body-label { position: static; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rvhg-page__line::after,
    .rvhg-page__heroimg::after { animation: none; }
  }
</style>
