---
import BaseLayout from './BaseLayout.astro';
import LegacyImg from '../components/LegacyImg.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  heroImage?: string;
  heading?: string;
  /** Heading with inline markup (e.g. an auto-updating year span). Takes precedence over `heading`. */
  headingHtml?: string;
  eyebrow?: string;
  lede?: string;
  breadcrumbs?: { name: string; url: string }[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description,
  canonical,
  image,
  heroImage,
  heading,
  headingHtml,
  eyebrow,
  lede,
  jsonLd,
} = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} image={image ?? heroImage} jsonLd={jsonLd}>
  <article class="rvhg-page">
    <header class="rvhg-page__hero">
      <div class="rvhg-container">
        {eyebrow && <p class="rvhg-eyebrow">{eyebrow}</p>}
        {headingHtml ? <h1 set:html={headingHtml}></h1> : <h1>{heading ?? title}</h1>}
        {lede && <p class="rvhg-page__lede">{lede}</p>}
      </div>
      {heroImage && (
        <div class="rvhg-page__heroimg">
          <LegacyImg src={heroImage} alt={heading ?? title} width={2400} height={1350} loading="eager" fetchpriority="high" />
        </div>
      )}
    </header>
    <div class="rvhg-container rvhg-page__body">
      <div class="rvhg-prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .rvhg-page__hero {
    text-align: center;
    padding-top: 3rem;
  }
  @media (min-width: 768px) {
    .rvhg-page__hero { padding-top: 6.5rem; }
  }
  .rvhg-page__hero h1 {
    margin-top: 0.6rem;
    font-size: var(--text-headline);
  }
  .rvhg-page__lede {
    margin: 1.25rem auto 0;
    max-width: 36rem;
    color: var(--color-mute);
    font-size: clamp(1rem, 0.5vw + 0.95rem, 1.2rem);
  }
  .rvhg-page__heroimg {
    margin-top: 3rem;
    width: 100%;
  }
  .rvhg-page__heroimg :global(img) {
    width: 100%;
    height: clamp(18rem, 50vw, 32rem);
    object-fit: cover;
    display: block;
  }
  .rvhg-page__body {
    padding-block: 4rem 6rem;
    display: grid;
    place-items: center;
  }
</style>
