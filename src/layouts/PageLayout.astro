---
import BaseLayout from './BaseLayout.astro';
import LegacyImg from '../components/LegacyImg.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
import { videoSchema } from '../data/jsonld';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  heroImage?: string;
  /** Hiển thị ảnh hero theo đúng tỉ lệ gốc (không crop) — dùng cho ảnh nhiều nội dung/chữ. */
  heroImageNatural?: boolean;
  heading?: string;
  /** Heading with inline markup (e.g. an auto-updating year span). Takes precedence over `heading`. */
  headingHtml?: string;
  eyebrow?: string;
  lede?: string;
  /** Video giới thiệu (YouTube) chèn giữa hero và nội dung; kèm VideoObject JSON-LD. */
  video?: { id: string; title: string; description?: string; caption?: string; uploadDate?: string };
  breadcrumbs?: { name: string; url: string }[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description,
  canonical,
  image,
  heroImage,
  heroImageNatural,
  heading,
  headingHtml,
  eyebrow,
  lede,
  video,
  breadcrumbs,
  jsonLd,
} = Astro.props;

// Gộp VideoObject vào JSON-LD sẵn có của trang (nếu trang có nhúng video).
const pageJsonLd: Record<string, unknown>[] = jsonLd ? (Array.isArray(jsonLd) ? [...jsonLd] : [jsonLd]) : [];
if (video) {
  pageJsonLd.push(
    videoSchema({
      id: video.id,
      name: video.title,
      description: video.description ?? description,
      uploadDate: video.uploadDate,
      url: canonical,
    }),
  );
}
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image ?? heroImage}
  jsonLd={pageJsonLd.length > 0 ? pageJsonLd : undefined}
>
  <article class="rvhg-page">
    <header class="rvhg-page__hero">
      <div class="rvhg-container">
        {breadcrumbs && breadcrumbs.length > 0 && (
          <div class="rvhg-page__crumbs"><Breadcrumbs items={breadcrumbs} /></div>
        )}
        {eyebrow && <p class="rvhg-eyebrow">{eyebrow}</p>}
        {headingHtml ? <h1 set:html={headingHtml}></h1> : <h1>{heading ?? title}</h1>}
        {lede && <p class="rvhg-page__lede">{lede}</p>}
      </div>
      {heroImage && (
        <div class={`rvhg-page__heroimg${heroImageNatural ? ' rvhg-page__heroimg--natural' : ''}`}>
          <LegacyImg src={heroImage} alt={heading ?? title} width={2400} height={1350} loading="eager" fetchpriority="high" />
        </div>
      )}
    </header>

    {video && (
      <section class="rvhg-page__video">
        <div class="rvhg-container">
          <VideoEmbed
            id={video.id}
            title={video.title}
            caption={video.caption ?? video.title}
            loading="lazy"
          />
        </div>
      </section>
    )}

    <div class="rvhg-container rvhg-page__body">
      <div class="rvhg-prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .rvhg-page__hero {
    text-align: center;
    padding-top: 3rem;
  }
  @media (min-width: 768px) {
    .rvhg-page__hero { padding-top: 6.5rem; }
  }
  .rvhg-page__hero h1 {
    margin-top: 0.6rem;
    font-size: var(--text-headline);
  }
  /* hero canh giữa, nên breadcrumb cũng canh giữa cho khớp */
  .rvhg-page__crumbs {
    margin-bottom: 1.5rem;
  }
  .rvhg-page__crumbs :global(ol) {
    justify-content: center;
  }
  .rvhg-page__lede {
    margin: 1.25rem auto 0;
    max-width: 36rem;
    color: var(--color-mute);
    font-size: clamp(1rem, 0.5vw + 0.95rem, 1.2rem);
  }
  .rvhg-page__heroimg {
    margin-top: 3rem;
    width: 100%;
  }
  .rvhg-page__heroimg :global(img) {
    width: 100%;
    height: clamp(18rem, 50vw, 32rem);
    object-fit: cover;
    display: block;
  }
  /* Ảnh hero nhiều nội dung (vd. infographic timeline): giữ nguyên tỉ lệ, không cắt chữ. */
  .rvhg-page__heroimg--natural :global(img) {
    height: auto;
    object-fit: contain;
    max-width: 1100px;
    margin-inline: auto;
  }
  /* Video giới thiệu — đặt giữa hero và phần nội dung */
  .rvhg-page__video {
    margin-top: 3.5rem;
  }
  .rvhg-page__video :global(.rvhg-video) {
    max-width: 58rem;
    margin-inline: auto;
  }
  .rvhg-page__body {
    padding-block: 4rem 6rem;
    display: grid;
    place-items: center;
  }
</style>
