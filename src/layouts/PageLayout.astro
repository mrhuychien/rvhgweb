---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LegacyImg from '../components/LegacyImg.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  heroImage?: string;
  /** Visible H1; defaults to title. */
  heading?: string;
  lede?: string;
  breadcrumbs?: { name: string; url: string }[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title,
  description,
  canonical,
  image,
  heroImage,
  heading,
  lede,
  breadcrumbs = [],
  jsonLd,
} = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} image={image ?? heroImage} jsonLd={jsonLd}>
  <article class="rvhg-page">
    <header class="rvhg-page__hero">
      <div class="rvhg-container">
        {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
        <h1>{heading ?? title}</h1>
        {lede && <p class="rvhg-page__lede">{lede}</p>}
      </div>
      {heroImage && (
        <div class="rvhg-container rvhg-page__heroimg">
          <LegacyImg src={heroImage} alt={heading ?? title} width={1600} height={900} loading="eager" fetchpriority="high" />
        </div>
      )}
    </header>
    <div class="rvhg-container rvhg-page__body">
      <div class="rvhg-prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .rvhg-page__hero {
    padding-top: 2.5rem;
    background: linear-gradient(180deg, var(--color-rvhg-cream), var(--color-paper));
  }
  .rvhg-page__hero h1 {
    margin-top: 0.75rem;
    font-size: var(--text-title);
  }
  .rvhg-page__lede {
    margin-top: 0.75rem;
    max-width: 60ch;
    color: var(--color-mute);
    font-size: 1.1rem;
  }
  .rvhg-page__heroimg {
    margin-top: 2rem;
  }
  .rvhg-page__heroimg :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
  }
  .rvhg-page__body {
    padding-block: 2.5rem 4rem;
  }
</style>
