---
import BaseLayout from './BaseLayout.astro';
import Motion from '../components/Motion.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  effectiveDate?: Date;
  breadcrumbs?: { name: string; url: string }[];
}
const { title, description, canonical, effectiveDate } = Astro.props;
const dateStr = effectiveDate
  ? new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(effectiveDate)
  : null;
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={true}>
  <article class="rvhg-policy">
    <header class="rvhg-policy__head rvhg-band-night">
      <div class="rvhg-policy__grid" aria-hidden="true"></div>
      <div class="rvhg-container rvhg-container--narrow" data-reveal>
        <span class="rvhg-policy__code">RVHG / PUBLIC DOCUMENT</span>
        <p class="rvhg-eyebrow">Văn bản công bố</p>
        <h1>{title}</h1>
        {dateStr && <p class="rvhg-policy__date">Hiệu lực từ: {dateStr}</p>}
      </div>
    </header>
    <div class="rvhg-container rvhg-policy__body" data-reveal>
      <aside aria-hidden="true">Tài liệu<br/>chính thức</aside>
      <div class="rvhg-prose">
        <slot />
      </div>
    </div>
  </article>
  <Motion />
</BaseLayout>

<style>
  .rvhg-policy__head {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    text-align: center;
    padding-block: clamp(4rem, 9vw, 9rem);
    background:
      radial-gradient(48rem 28rem at 50% 0%, rgb(132 30 35 / 0.46), transparent 72%),
      linear-gradient(135deg, #28070a, #140205);
  }
  .rvhg-policy__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.2;
    background:
      linear-gradient(rgb(240 210 146 / 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgb(240 210 146 / 0.08) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(circle, black, transparent 76%);
  }
  .rvhg-policy__code {
    display: block;
    margin-bottom: clamp(2rem, 5vw, 4rem);
    color: rgb(240 210 146 / 0.34);
    font-size: 0.54rem;
    font-weight: 600;
    letter-spacing: 0.15em;
  }
  .rvhg-policy__head .rvhg-eyebrow { color: #dfbc74; }
  .rvhg-policy__head h1 {
    max-width: 16ch;
    margin: 1rem auto 0;
    color: #fff8ea;
    font-size: clamp(2.5rem, 5.5vw, 5.8rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }
  .rvhg-policy__date {
    margin-top: 1rem;
    color: rgb(255 248 234 / 0.46);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }
  .rvhg-policy__body {
    display: grid;
    grid-template-columns: minmax(7rem, 0.3fr) minmax(0, 1fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
    padding-block: clamp(4rem, 9vw, 9rem);
  }
  .rvhg-policy__body > aside {
    position: sticky;
    top: 7rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-line);
    color: #9a7b4a;
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.55;
    text-transform: uppercase;
  }
  .rvhg-policy__body .rvhg-prose { max-width: 72ch; }
  @media (max-width: 720px) {
    .rvhg-policy__body { grid-template-columns: 1fr; }
    .rvhg-policy__body > aside { display: none; }
  }
</style>
