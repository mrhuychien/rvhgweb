---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  effectiveDate?: Date;
  breadcrumbs?: { name: string; url: string }[];
}
const { title, description, canonical, effectiveDate, breadcrumbs = [] } = Astro.props;
const dateStr = effectiveDate
  ? new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(effectiveDate)
  : null;
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={true}>
  <article class="rvhg-policy">
    <header class="rvhg-container rvhg-policy__head">
      {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
      <h1>{title}</h1>
      {dateStr && <p class="rvhg-policy__date">Hiệu lực từ: {dateStr}</p>}
    </header>
    <div class="rvhg-container rvhg-policy__body">
      <div class="rvhg-prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .rvhg-policy__head {
    padding-block: 2.5rem 1rem;
  }
  .rvhg-policy__head h1 {
    margin-top: 0.75rem;
    font-size: var(--text-title);
  }
  .rvhg-policy__date {
    margin-top: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-mute);
  }
  .rvhg-policy__body {
    padding-block: 1rem 4rem;
  }
</style>
