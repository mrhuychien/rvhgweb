---
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LegacyImg from '../components/LegacyImg.astro';
import ProductCard from '../components/ProductCard.astro';
import { productSchema } from '../data/jsonld';

interface Props {
  product: CollectionEntry<'products'>;
}
const { product } = Astro.props;
const d = product.data;
const url = `/san-pham/${product.id}/`;

const category = await getEntry('productCategories', d.category);
const catUrl = `/danh-muc-san-pham/${d.category}/`;

// up to 3 sibling products in the same category
const siblings = (await getCollection('products'))
  .filter((p) => p.data.category === d.category && p.id !== product.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const jsonLd = productSchema({
  name: d.title,
  description: d.description,
  images: d.images,
  category: category?.data.title,
  sku: d.sku,
  isOcop5Star: d.isOcop5Star,
  url,
});
const ogImage = `/og/product/${product.id}.png`;
---

<BaseLayout title={d.title} description={d.description} image={ogImage} jsonLd={jsonLd}>
  <article class="rvhg-product">
    <div class="rvhg-container">
      <Breadcrumbs
        items={[
          { name: 'Sản phẩm', url: '/san-pham/' },
          ...(category ? [{ name: category.data.title, url: catUrl }] : []),
          { name: d.title, url },
        ]}
      />
    </div>

    <div class="rvhg-container rvhg-product__top">
      <div class="rvhg-product__gallery">
        <LegacyImg src={d.images[0]} alt={d.title} width={1000} height={750} loading="eager" fetchpriority="high" class="rvhg-product__main-img" />
        {d.images.length > 1 && (
          <div class="rvhg-product__thumbs">
            {d.images.slice(1).map((img) => (
              <LegacyImg src={img} alt={d.title} width={300} height={225} />
            ))}
          </div>
        )}
      </div>

      <div class="rvhg-product__info">
        {d.isOcop5Star && <span class="rvhg-product__badge">OCOP 5 sao Quốc gia 2024</span>}
        <h1>{d.title}</h1>
        <p class="rvhg-product__lede">{d.description}</p>

        <dl class="rvhg-product__spec">
          {category && (<><dt>Danh mục</dt><dd><a href={catUrl}>{category.data.title}</a></dd></>)}
          {d.weight && (<><dt>Khối lượng</dt><dd>{d.weight}</dd></>)}
          {d.packaging && (<><dt>Quy cách</dt><dd>{d.packaging}</dd></>)}
          {d.sku && (<><dt>Mã SP</dt><dd>{d.sku}</dd></>)}
          <dt>Nhà sản xuất</dt><dd>Công ty Cổ phần Hoàng Giang (ISO 22000:2018)</dd>
        </dl>

        <div class="rvhg-product__cta">
          <a class="rvhg-btn rvhg-btn--primary" href={d.shopeeLink ?? 'https://shopee.vn/'} target="_blank" rel="noopener noreferrer">Mua trên Shopee</a>
          <a class="rvhg-btn rvhg-btn--ghost" href={d.tiktokLink ?? 'https://www.tiktok.com/'} target="_blank" rel="noopener noreferrer">Mua trên TikTok Shop</a>
          <a class="rvhg-btn rvhg-btn--ghost" href="tel:0934362658">Gọi đặt hàng: 0934 362 658</a>
        </div>
      </div>
    </div>

    <div class="rvhg-container rvhg-product__desc">
      <div class="rvhg-prose">
        <slot />
      </div>
    </div>

    {siblings.length > 0 && (
      <section class="rvhg-container rvhg-product__related">
        <h2>Sản phẩm cùng dòng</h2>
        <div class="rvhg-product__related-grid">
          {siblings.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .rvhg-product__top {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 2.5rem;
    padding-block: 1.5rem 2.5rem;
  }
  .rvhg-product__main-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-soft);
    background: var(--color-rvhg-cream);
  }
  .rvhg-product__thumbs {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .rvhg-product__thumbs :global(img) {
    width: 5rem;
    height: 5rem;
    object-fit: cover;
    border-radius: 0.5rem;
    border: 1px solid var(--color-line);
  }
  .rvhg-product__badge {
    display: inline-block;
    background: var(--color-rvhg-red);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.6rem;
    border-radius: 0.4rem;
    margin-bottom: 0.75rem;
  }
  .rvhg-product__info h1 {
    font-size: var(--text-title);
  }
  .rvhg-product__lede {
    margin-top: 0.75rem;
    color: var(--color-ink-soft);
    font-size: 1.05rem;
  }
  .rvhg-product__spec {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5rem 1.25rem;
    font-size: 0.9rem;
  }
  .rvhg-product__spec dt {
    color: var(--color-mute);
  }
  .rvhg-product__spec dd a {
    color: var(--color-rvhg-gold-dark);
  }
  .rvhg-product__cta {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .rvhg-btn {
    display: inline-block;
    padding: 0.7rem 1.2rem;
    border-radius: 0.6rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.12s ease, background 0.15s ease;
  }
  .rvhg-btn:active {
    transform: translateY(1px);
  }
  .rvhg-btn--primary {
    background: var(--color-rvhg-gold);
    color: #fff;
  }
  .rvhg-btn--primary:hover {
    background: var(--color-rvhg-gold-dark);
  }
  .rvhg-btn--ghost {
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-line);
  }
  .rvhg-btn--ghost:hover {
    border-color: var(--color-rvhg-gold);
    color: var(--color-rvhg-gold-dark);
  }
  .rvhg-product__desc {
    padding-block: 1rem 2rem;
  }
  .rvhg-product__related {
    padding-block: 2rem 4rem;
  }
  .rvhg-product__related h2 {
    font-size: var(--text-subtitle);
    margin-bottom: 1.25rem;
  }
  .rvhg-product__related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 900px) {
    .rvhg-product__top {
      grid-template-columns: 1fr;
    }
    .rvhg-product__related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .rvhg-product__related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
