---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import LegacyImg from '../components/LegacyImg.astro';
import ProductTile from '../components/ProductTile.astro';
import Motion from '../components/Motion.astro';
import { breadcrumbSchema, faqSchema } from '../data/jsonld';
import { COMPANY } from '../data/site';

interface Props {
  entry: CollectionEntry<'productCategories'>;
}

const { entry } = Astro.props;
const d = entry.data;
const url = `/danh-muc-san-pham/${entry.id}/`;

// Structured data: Breadcrumb + (optional) FAQPage — rich result & AI citation for the pillar pages.
const jsonLd: Record<string, unknown>[] = [
  breadcrumbSchema([
    { name: 'Trang chủ', url: '/' },
    { name: 'Sản phẩm', url: '/san-pham/' },
    { name: d.title, url },
  ]),
];
if (d.faq.length > 0) jsonLd.push(faqSchema(d.faq));
---

<BaseLayout title={d.seoTitle ?? d.title} description={d.description} canonical={url} image={d.heroImage} jsonLd={jsonLd}>
  <!-- Hero — imperial digital product stage -->
  <section class="rvhg-line-hero" style={d.accent ? `--rvhg-accent: ${d.accent}` : ''}>
    <div class="rvhg-line-hero__grid" aria-hidden="true"></div>
    <div class="rvhg-container rvhg-line-hero__inner">
      <div class="rvhg-line-hero__head" data-reveal="left">
        <span class="rvhg-line-hero__code">COLLECTION / {entry.id.toUpperCase()}</span>
        {d.eyebrow && <p class="rvhg-eyebrow">{d.eyebrow}</p>}
        <h1>{d.title}</h1>
        <p class="rvhg-line-hero__tagline">{d.tagline}</p>
        {d.quickAnswer && <p class="rvhg-line-hero__answer">{d.quickAnswer}</p>}
        <a class="rvhg-btn" href="#products">Xem sản phẩm →</a>
      </div>
      {d.heroImage && (
        <div class="rvhg-line-hero__media" data-tilt data-reveal="right">
          <span class="rvhg-line-hero__orbit" aria-hidden="true"></span>
          <LegacyImg src={d.heroImage} alt={d.title} width={2400} height={1350} loading="eager" fetchpriority="high" />
          <div class="rvhg-line-hero__meta" aria-hidden="true">
            <span>Rồng Vàng Hoàng Gia</span>
            <span>Product universe ↗</span>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Brand intro band -->
  <section class="rvhg-section rvhg-band-soft">
    <div class="rvhg-container rvhg-line-intro">
      <div class="rvhg-line-intro__copy">
        <p class="rvhg-eyebrow">Giới thiệu dòng sản phẩm</p>
        <slot />
      </div>
      {d.storyImage && (
        <div class="rvhg-line-intro__media">
          <LegacyImg src={d.storyImage} alt={d.title} width={1200} height={1500} loading="lazy" />
        </div>
      )}
    </div>
  </section>

  <!-- Quality standards -->
  {d.certifications.length > 0 && (
    <section class="rvhg-section">
      <div class="rvhg-container">
        <header class="rvhg-line-sec__head">
          <p class="rvhg-eyebrow">Tiêu chuẩn chất lượng</p>
          <h2>Đảm bảo từ nguyên liệu đến đóng gói.</h2>
          <div class="gold-rule"></div>
        </header>
        <div class="rvhg-cert-grid">
          {d.certifications.map((c) => (
            <article class="rvhg-cert">
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Self-declarations -->
  {d.selfDeclarations.length > 0 && (
    <section class="rvhg-section rvhg-band-night">
      <div class="rvhg-container">
        <header class="rvhg-line-sec__head rvhg-line-sec__head--center">
          <p class="rvhg-eyebrow" style="color: var(--color-night-mute);">Hồ sơ tự công bố</p>
          <h2>Minh bạch với cơ quan quản lý nhà nước.</h2>
          <div class="gold-rule rvhg-rule--center"></div>
          <p class="rvhg-line-sec__lede">
            {COMPANY.legalName} công khai bản tự công bố sản phẩm cho từng SKU trong dòng này. Văn bản đã gửi và lưu tại Chi cục An toàn vệ sinh thực phẩm Hải Dương.
          </p>
        </header>
        <ul class="rvhg-decl-list">
          {d.selfDeclarations.map((decl) => (
            <li>
              <a href={decl.href}>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <polyline points="14 2 14 8 20 8" />
                </svg>
                <span>{decl.label}</span>
                <span class="rvhg-decl-list__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="rvhg-decl-foot">
          <a class="rvhg-btn rvhg-btn--ghost" href="/ban-tu-cong-bo-rong-vang-hoang-gia/">Xem hồ sơ tự công bố đầy đủ</a>
        </p>
      </div>
    </section>
  )}

  <!-- Product tiles -->
  {d.products.length > 0 && (
    <section class="rvhg-section" id="products">
      <div class="rvhg-container">
        <header class="rvhg-line-sec__head">
          <p class="rvhg-eyebrow">Các sản phẩm trong dòng</p>
          <h2>{d.products.length} sản phẩm.</h2>
          <div class="gold-rule"></div>
        </header>
        <div class="rvhg-tile-grid">
          {d.products.map((p, i) => (
            <ProductTile
              name={p.name}
              image={p.image ? encodeURI(p.image) : undefined}
              weight={p.weight}
              isOcop5Star={p.isOcop5Star}
              accent={d.accent}
              loading={i < 4 ? 'eager' : 'lazy'}
              href={p.href}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ — visible content backing the FAQPage schema (GEO + rich result) -->
  {d.faq.length > 0 && (
    <section class="rvhg-section">
      <div class="rvhg-container rvhg-line-faq">
        <header class="rvhg-line-sec__head rvhg-line-sec__head--center">
          <p class="rvhg-eyebrow">Câu hỏi thường gặp</p>
          <h2>Giải đáp nhanh.</h2>
          <div class="gold-rule rvhg-rule--center"></div>
        </header>
        <dl class="rvhg-faq">
          {d.faq.map((item) => (
            <div class="rvhg-faq__item">
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="rvhg-section rvhg-band-tint rvhg-section--tight">
    <div class="rvhg-container rvhg-line-cta">
      <h2>Mua sản phẩm Rồng Vàng Hoàng Gia.</h2>
      <p>Phân phối tại BigC, WinMart, AEON, Lotte, Co.opmart, MegaMarket, Lan Chi — hoặc trên Shopee và TikTok Shop.</p>
      <div class="rvhg-line-cta__buttons">
        <a class="rvhg-btn" href="/diem-ban-rong-vang-hoang-gia/">Tìm điểm bán</a>
        <a class="rvhg-btn rvhg-btn--ghost" href="/lien-he/">Liên hệ đại lý</a>
      </div>
    </div>
  </section>
  <Motion />
</BaseLayout>

<style>
  .rvhg-line-hero {
    --rvhg-accent: #c49a57;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(4rem, 8vw, 8rem);
    color: #fff8ea;
    background:
      radial-gradient(55rem 36rem at 82% 42%, color-mix(in srgb, var(--rvhg-accent) 27%, transparent), transparent 72%),
      linear-gradient(135deg, #28070a, #140205);
  }
  .rvhg-line-hero__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.22;
    background:
      linear-gradient(rgb(240 210 146 / 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgb(240 210 146 / 0.08) 1px, transparent 1px);
    background-size: 70px 70px;
    mask-image: linear-gradient(90deg, black, transparent 78%);
  }
  .rvhg-line-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(28rem, 1.22fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .rvhg-line-hero__code {
    display: block;
    max-width: 28ch;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
    overflow: hidden;
    color: rgb(240 210 146 / 0.36);
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rvhg-line-hero__head .rvhg-eyebrow { color: color-mix(in srgb, var(--rvhg-accent) 68%, #f0d292); }
  .rvhg-line-hero h1 {
    max-width: 10ch;
    margin-top: 1rem;
    color: #fff8ea;
    font-size: clamp(3rem, 6vw, 6.5rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.055em;
  }
  .rvhg-line-hero__tagline {
    max-width: 32ch;
    margin-top: 1.2rem;
    color: color-mix(in srgb, var(--rvhg-accent) 65%, #fff8ea);
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 1vw + 0.85rem, 1.5rem);
    font-style: italic;
    font-weight: 400;
  }
  .rvhg-line-hero__answer {
    max-width: 42rem;
    margin-top: 1rem;
    color: rgb(255 248 234 / 0.52);
    font-size: 0.9rem;
    line-height: 1.72;
  }
  .rvhg-line-hero__head .rvhg-btn { margin-top: 1.8rem; }
  .rvhg-line-hero__media {
    position: relative;
    min-width: 0;
    transform-style: preserve-3d;
  }
  .rvhg-line-hero__media :global(img) {
    width: 100%;
    height: clamp(27rem, 48vw, 42rem);
    object-fit: cover;
    display: block;
    border: 1px solid rgb(240 210 146 / 0.34);
    box-shadow: 0 45px 110px -52px rgb(0 0 0 / 0.9);
    transform: perspective(1000px) rotateY(-6deg) translateZ(26px);
  }
  .rvhg-line-hero__orbit {
    position: absolute;
    z-index: -1;
    width: 110%;
    aspect-ratio: 1;
    left: -5%;
    top: 50%;
    border: 1px solid color-mix(in srgb, var(--rvhg-accent) 40%, transparent);
    border-radius: 50%;
    transform: translateY(-50%) rotateX(68deg);
  }
  .rvhg-line-hero__orbit::after {
    content: '';
    position: absolute;
    top: -4px;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--rvhg-accent) 65%, #f0d292);
    box-shadow: 0 0 20px color-mix(in srgb, var(--rvhg-accent) 65%, #f0d292);
  }
  .rvhg-line-hero__meta {
    position: absolute;
    left: 1.2rem;
    right: 1.2rem;
    bottom: 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: rgb(255 248 234 / 0.66);
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  @media (max-width: 820px) {
    .rvhg-line-hero__inner { grid-template-columns: 1fr; }
    .rvhg-line-hero__code { margin-bottom: 2rem; }
    .rvhg-line-hero__media :global(img) { height: clamp(22rem, 72vw, 34rem); transform: none; }
  }

  /* Intro */
  .rvhg-line-intro {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .rvhg-line-intro__copy :global(p),
  .rvhg-line-intro__copy :global(strong) {
    font-size: clamp(1.05rem, 0.5vw + 0.95rem, 1.2rem);
    line-height: 1.65;
    color: var(--color-ink-soft);
  }
  .rvhg-line-intro__copy :global(p + p) {
    margin-top: 1.3em;
  }
  .rvhg-line-intro__copy :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
  .rvhg-line-intro__copy .rvhg-eyebrow { margin-bottom: 1.2rem; }
  .rvhg-line-intro__media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-card);
  }
  @media (max-width: 768px) {
    .rvhg-line-intro { grid-template-columns: 1fr; gap: 2.5rem; }
    .rvhg-line-intro__media :global(img) { aspect-ratio: 4 / 3; }
  }

  /* Section heads */
  .rvhg-line-sec__head {
    margin-bottom: 3rem;
    max-width: 50rem;
  }
  .rvhg-line-sec__head--center {
    margin-inline: auto;
    text-align: center;
  }
  .rvhg-line-sec__head .rvhg-eyebrow {
    margin-bottom: 0.85rem;
  }
  .rvhg-line-sec__head h2 {
    font-size: var(--text-display);
  }
  .rvhg-line-sec__lede {
    margin-top: 1rem;
    font-size: 1.05rem;
    color: var(--color-night-mute);
  }

  /* Cert grid */
  .rvhg-cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .rvhg-cert {
    border-top: 1px solid var(--color-line);
    padding-top: 1.5rem;
  }
  .rvhg-cert h3 {
    font-size: 1.25rem;
    margin-bottom: 0.6rem;
    letter-spacing: -0.012em;
  }
  .rvhg-cert p {
    color: var(--color-mute);
    line-height: 1.6;
    font-size: 0.975rem;
  }
  @media (max-width: 768px) {
    .rvhg-cert-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  /* Declarations */
  .rvhg-decl-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 56rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  .rvhg-decl-list li { border-bottom: 1px solid rgb(255 255 255 / 0.12); }
  .rvhg-decl-list a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0.5rem;
    color: #fff;
    text-decoration: none;
    transition: padding 0.2s ease;
  }
  .rvhg-decl-list a:hover {
    padding-inline-start: 1.25rem;
  }
  .rvhg-decl-list a > span:first-of-type { flex: 1; font-size: 1.05rem; }
  .rvhg-decl-list__arrow {
    color: var(--color-night-mute);
    font-size: 1.25rem;
  }
  .rvhg-decl-foot {
    margin-top: 2.5rem;
    text-align: center;
  }

  /* Tile grid */
  .rvhg-tile-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem 1.5rem;
  }
  @media (max-width: 1024px) { .rvhg-tile-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 768px)  { .rvhg-tile-grid { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 1rem; } }

  /* FAQ */
  .rvhg-line-faq { max-width: 52rem; }
  .rvhg-faq {
    margin: 0;
    border-top: 1px solid var(--color-line);
  }
  .rvhg-faq__item {
    border-bottom: 1px solid var(--color-line);
    padding: 1.5rem 0;
  }
  .rvhg-faq dt {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    color: var(--color-ink);
  }
  .rvhg-faq dd {
    margin: 0.6rem 0 0;
    color: var(--color-ink-soft);
    line-height: 1.7;
  }

  /* CTA */
  .rvhg-line-cta {
    text-align: center;
    max-width: 48rem;
    margin-inline: auto;
  }
  .rvhg-line-cta h2 {
    font-size: var(--text-display);
  }
  .rvhg-line-cta p {
    margin-top: 1rem;
    color: var(--color-mute);
  }
  .rvhg-line-cta__buttons {
    margin-top: 2rem;
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
