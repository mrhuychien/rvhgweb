---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../data/site';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { organizationSchema, websiteSchema } from '../data/jsonld';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  /** Extra JSON-LD blocks to inject (Product, Article, FAQ…). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  image,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;

// Google Analytics 4. Mã đo lường là dữ liệu công khai (hiện ngay trong mã trang),
// nên đặt sẵn ở đây; có thể ghi đè bằng biến môi trường PUBLIC_GA_ID trên Vercel.
const GA_ID = import.meta.env.PUBLIC_GA_ID ?? 'G-61NZLGQZBY';
const FB_PIXEL = import.meta.env.PUBLIC_FB_PIXEL ?? '';
---

<!doctype html>
<html lang={SITE.lang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#551016" />

    <!-- Enables the progressive-enhancement motion layer (scroll-reveal/tilt).
         Runs synchronously before paint so reveal states never flash; on pages
         without [data-reveal] elements it is an inert class on <html>. -->
    <script is:inline>document.documentElement.classList.add('rvhg-js');</script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href={SITE.url} />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/be-vietnam-pro-400-vietnamese.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/be-vietnam-pro-500-vietnamese.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/playfair-display-vietnamese.woff2" crossorigin />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />

    <JsonLd schema={[organizationSchema(), websiteSchema()]} />
    {jsonLd && <JsonLd schema={jsonLd} />}

    {GA_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA_ID);
        </script>
      </>
    )}
    {FB_PIXEL && (
      <script is:inline define:vars={{ FB_PIXEL }}>
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', FB_PIXEL);
        fbq('track', 'PageView');
      </script>
    )}

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="rvhg-skip-link">Bỏ qua đến nội dung chính</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Auto-updates "số năm" numerals ([data-years-since]) to the visitor's
         current year, so the count stays correct even between deploys. The
         animated hero counter (.rvhg-countup) is handled by Motion instead. -->
    <script is:inline>
      (function () {
        function updateYears() {
          var now = new Date().getFullYear();
          document.querySelectorAll('[data-years-since]').forEach(function (el) {
            if (el.classList.contains('rvhg-countup')) return;
            var since = parseInt(el.getAttribute('data-years-since'), 10);
            if (since) el.textContent = String(Math.max(0, now - since));
          });
        }
        updateYears();
        if (!window.__rvhgYears) {
          window.__rvhgYears = 1;
          document.addEventListener('astro:page-load', updateYears);
        }
      })();
    </script>

    <!-- Machine translation (Google) — adds EN / JA / KO / ZH / FR like the old site -->
    <div id="google_translate_element" aria-hidden="true" transition:persist></div>
    <script is:inline>
      window.rvhgSetLang = function (lang) {
        var h = location.hostname;
        var exp = '; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
        document.cookie = 'googtrans=' + exp;
        document.cookie = 'googtrans=' + exp + '; domain=.' + h;
        if (lang && lang !== 'vi') {
          document.cookie = 'googtrans=/vi/' + lang + '; path=/';
          document.cookie = 'googtrans=/vi/' + lang + '; path=/; domain=.' + h;
        }
        location.reload();
      };
      window.googleTranslateElementInit = function () {
        if (window.google && window.google.translate) {
          new google.translate.TranslateElement(
            { pageLanguage: 'vi', includedLanguages: 'en,ja,ko,zh-CN,fr', autoDisplay: false },
            'google_translate_element',
          );
        }
      };
      document.addEventListener('astro:after-swap', function () {
        var el = document.getElementById('google_translate_element');
        if (el && window.google && window.google.translate) {
          el.innerHTML = '';
          window.googleTranslateElementInit();
        }
      });
    </script>
    <script is:inline defer src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
  </body>
</html>
