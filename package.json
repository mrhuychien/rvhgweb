{
  "name": "rvhg-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "images": "node tools/gen-responsive.mjs",
    "build": "node tools/gen-responsive.mjs && astro build",
    "preview": "astro preview",
    "linkcheck": "node tools/linkcheck.mjs",
    "verify": "pnpm build && node tools/linkcheck.mjs",
    "astro": "astro",
    "imgcheck": "node tools/imgcheck.mjs && node tools/imgcheck.mjs --width 390 --dpr 2 --ratio 2",
    "wkcheck": "node tools/wkcheck.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.0",
    "@astrojs/sitemap": "^3.3.0",
    "astro": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}
